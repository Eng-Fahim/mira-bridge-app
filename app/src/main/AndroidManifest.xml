<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== الأذونات الأساسية للتخزين ==================== -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ==================== أذونات البلوتوث والتتبع ==================== -->
    <uses-permission android:name="android.permission.BLUETOOTH" 
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" 
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" 
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" 
        tools:targetApi="s" />

    <!-- ==================== أذونات الموقع والشبكة ==================== -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- ==================== أذونات العتاد والمصادقة الحيوية ==================== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- ==================== أذونات الخدمة الخلفية وإعادة التشغيل ==================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ==================== ميزات العتاد ==================== -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- ==================== التطبيق ==================== -->
    <application
        android:allowBackup="true"
        android:name="com.example.uhf.application.MiraApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uhfuartdemo"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31">

        <!-- ==================== SplashActivity ==================== -->
        <activity
            android:name="com.example.uhf.activity.SplashActivity"
            android:theme="@style/SplashTheme"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- ==================== ReportsActivity ==================== -->
        <activity 
            android:name=".ReportsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />

        <!-- ==================== MainActivity ==================== -->
        <activity
            android:name="com.example.uhf.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- ==================== LoginActivity ==================== -->
        <activity
            android:name="com.example.uhf.activity.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Uhfuartdemo"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />
            
            <!-- MIRA License Activation -->
            <activity
    android:name="com.example.uhf.activity.ActivationActivity"
    android:screenOrientation="portrait"
    android:exported="false"
    android:label="تفعيل الترخيص"
    android:theme="@style/Theme.Uhfuartdemo"
    android:windowSoftInputMode="adjustResize|stateHidden"
    android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />

        <!-- ==================== UHFMainActivity ==================== -->
        <activity
            android:name="com.example.uhf.activity.UHFMainActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Uhfuartdemo"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- ==================== المستقبلات ==================== -->
        <receiver
            android:name="com.example.uhf.BootBroadcastReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.REBOOT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- ==================== FileManager ==================== -->
        <activity
            android:name="com.example.uhf.filebrowser.FileManagerActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />

        <!-- ==================== TestActivity ==================== -->
        <activity
            android:name="com.example.uhf.activity.TestActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />

        <!-- ==================== ItemStudioActivity ==================== -->
        <activity
            android:name="com.example.uhf.activity.ItemStudioActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="MIRA Identity Studio"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />
            
        <activity
    android:name=".activity.InventoryReportPreviewActivity"
    android:exported="false"
    android:theme="@style/Theme.Uhfuartdemo" />

        <!-- ==================== FileProvider ==================== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ==================== خدمة المراقبة الخلفية ==================== -->
<service
    android:name=".service.MiraGateMonitorService"
    android:exported="false"
    android:foregroundServiceType="dataSync|connectedDevice"
    android:stopWithTask="false" />
    
    <!-- ==================== مستقبل أحداث البوابات ==================== -->
<receiver
    android:name=".receiver.GateEventReceiver"
    android:exported="false"
    android:enabled="true">

    <!-- أحداث البوابة (من MiraSecureGateFragment) -->
    <intent-filter>
        <action android:name="com.example.uhf.GATE_EVENT" />
        <action android:name="com.example.uhf.GATE_ALERT" />
        <action android:name="com.example.uhf.GATE_SYNC" />
    </intent-filter>

    <!-- أحداث البيع/الإرجاع (من GateSaleBridge) -->
    <intent-filter>
        <action android:name="com.mira.gate.SALE_COMPLETED" />
        <action android:name="com.mira.gate.REFUND_COMPLETED" />
    </intent-filter>

</receiver>
    </application>

</manifest>
