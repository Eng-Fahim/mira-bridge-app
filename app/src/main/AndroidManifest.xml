<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1" 
    android:versionName="1.0">

    <!-- أذونات التخزين -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    
    <!-- أذونات الشبكة -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- ✅ أذونات الكاميرا (جديد) -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- ✅ إذن الكتابة للصور (لأجهزة أندرويد 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ✅ ميزات الجهاز المطلوبة -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uhfuartdemo"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name="com.example.uhf.activity.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Uhfuartdemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.uhf.activity.UHFMainActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Uhfuartdemo" />

        <receiver
            android:name="com.example.uhf.BootBroadcastReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.example.uhf.filebrowser.FileManagerActivity"
            android:screenOrientation="portrait"
            android:exported="true" />

        <activity
            android:name="com.example.uhf.activity.TestActivity"
            android:screenOrientation="portrait"
            android:exported="true" />

        <activity
            android:name="com.example.uhf.activity.ItemStudioActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="MIRA Identity Studio"
            android:windowSoftInputMode="adjustResize" />

        <!-- ✅ FileProvider للكاميرا (موجود مسبقاً - تأكد منه) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
