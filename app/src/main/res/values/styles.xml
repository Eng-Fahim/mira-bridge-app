<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ==================== أشكال الحواف الفاخرة ==================== -->
    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TopRounded" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ==================== ستايلات القوائم المنسدلة ==================== -->
    <style name="CustomOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:popupBackground">@drawable/bg_custom_popup_menu</item>
        <item name="android:itemIconDisabledAlpha">0.5</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- ==================== ربط الثيمات الرئيسية متجاوبة مع الماتيريال 3 ==================== -->
    <style name="AppBaseTheme" parent="Theme.Uhfuartdemo" />
        
    <style name="AppTheme" parent="Theme.Uhfuartdemo">
        <item name="android:alertDialogTheme">@style/MiraCustomDialogTheme</item>
        <item name="alertDialogTheme">@style/MiraCustomDialogTheme</item>
        <item name="actionOverflowMenuStyle">@style/CustomOverflowMenu</item>
    </style>

    <style name="CustomTheme" parent="Theme.Uhfuartdemo" />
    <style name="ActionBarBaseTheme" parent="Theme.Uhfuartdemo" />
    <style name="ActionBarBaseTheme1" parent="Theme.Uhfuartdemo" />

    <!-- ==================== مؤشر الفوتر النشط (اصلاح مشكلة الشريط السفلي) ==================== -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- لون ذهبي شفاف متجاوب بنسبة 15% يمنع الصدام مع الخلفيات الفاتحة والداكنة -->
        <item name="android:color">#26D4AF37</item>
        <item name="android:width">54dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- ==================== ستايلات التبويبات والقوائم السريعة ==================== -->
    <style name="MyActionBarTabTextStyle" parent="TextAppearance.Material3.TitleMedium">          
        <item name="android:textColor">@drawable/check_text_color</item>
        <item name="android:textSize">16sp</item>  
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>  
    
    <style name="QuickMenuItemStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">86dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_quick_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="QuickMenuTextStyle">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- ==================== ثيم النوافذ الحوارية المصحح والمتجاوب ==================== -->
    <style name="MiraCustomDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/MiraDialogCorners</item>
        <item name="android:windowBackground">@drawable/bg_mira_dialog</item>
        <!-- الاعتماد على متغيرا الثيم الديناميكية بدلاً من ألوان شاذة ثابتة -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:titleTextColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
    </style>

    <style name="MiraDialogCorners" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="DialogAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- Custom View Attributes for RFID / Radar components -->
    <declare-styleable name="RadarView">
        <attr name="center_image" format="reference" />
        <attr name="image_width" format="dimension" />
        <attr name="image_height" format="dimension" />
    </declare-styleable>

</resources>
