<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/schemas/android">
    <!-- ==================== أشكال الحواف الفاخرة ==================== -->
    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TopRounded" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ==================== ستايلات القوائم المنسدلة ==================== -->
    <style name="CustomOverflowMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:popupBackground">@drawable/bg_custom_popup_menu</item>
        <item name="android:itemIconDisabledAlpha">0.5</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="bottomSheetStyle">@style/TransparentBottomSheetStyle</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="TransparentBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">auto</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_draggable">true</item>
    </style>

    <!-- ==================== Bottom Navigation ==================== -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1AC59B27</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="AppBottomNavigationViewStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/CustomActiveIndicator</item>
        <item name="itemRippleColor">@color/nav_ripple_color</item>
        <item name="elevation">16dp</item>
        <item name="itemIconSize">26dp</item>
        <item name="itemTextAppearanceActive">@style/NavItemTextActive</item>
        <item name="itemTextAppearanceInactive">@style/NavItemTextInactive</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="LuxuryQuickActionItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="LuxuryQuickActionIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_luxury_quick_action_icon</item>
    </style>

    <style name="LuxuryQuickActionText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <style name="LuxuryBottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="bottomSheetStyle">@style/LuxuryBottomSheetStyle</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="LuxuryBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="behavior_peekHeight">auto</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_draggable">true</item>
    </style>

    <style name="NavItemTextActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <style name="NavItemTextInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <style name="MyActionBarTabTextStyle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@drawable/check_text_color</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <style name="QuickMenuItemStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">86dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_quick_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="QuickMenuTextStyle">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GoldCardTitleStyle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>
    
    <!-- ═══════════════════════════════════════════════════════
     🎨 New Luxury Styles (v3.0 - High Contrast Light)
     ═══════════════════════════════════════════════════════ -->

    <!-- Card View فاخر -->
    <style name="LuxuryCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/pure_white</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/border_warm</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Chip فاخر -->
    <style name="LuxuryChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Divider فاخر -->
    <style name="LuxuryDivider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/border_warm</item>
        <item name="dividerThickness">1dp</item>
    </style>

    <!-- Icon Button -->
    <style name="LuxuryIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/gold_luxury</item>
        <item name="iconSize">24dp</item>
    </style>

    <declare-styleable name="RadarView">
        <attr name="center_image" format="reference" />
        <attr name="image_width" format="dimension" />
        <attr name="image_height" format="dimension" />
    </declare-styleable>
<!-- ═══════════════════════════════════════════════════════
 🧭 Setup Wizard Styles (Opening Balances & other setup steps)
 ═══════════════════════════════════════════════════════ -->

<!-- رأس قسم في شاشات الإعداد (يُستخدم على LinearLayout أفقي) -->
<style name="SetupSectionHeader">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:layout_marginTop">16dp</item>
    <item name="android:layout_marginBottom">4dp</item>
</style>

<!-- عنوان القسم داخل الرأس -->
<style name="SetupSectionTitle">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:textSize">15sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:fontFamily">@font/cairo</item>
</style>

<!-- صف في ملخص الأرصدة (Sticky Summary) -->
<style name="SetupSummaryRow">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingTop">2dp</item>
    <item name="android:paddingBottom">2dp</item>
</style>
</resources>
