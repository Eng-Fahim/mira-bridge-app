<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Circular Image Shape Style -->
    <style name="CircularImageView">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Style الحواف الدائرية الفاخرة للبطاقات والقوائم -->
    <style name="ShapeAppearance.TopRounded" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ستايل القائمة المنسدلة العلوية -->
    <style name="CustomOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:popupBackground">@drawable/bg_custom_popup_menu</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- توحيد الثيمات لضمان عمل كافة النشاطات بالهوية الجديدة -->
    <style name="AppBaseTheme" parent="Theme.Uhfuartdemo" />
        
    <!-- الثيم الرئيسي للتطبيق شامل الربط مع تصميم الديالوج الجديد -->
    <style name="AppTheme" parent="Theme.Uhfuartdemo">
        <item name="android:alertDialogTheme">@style/MiraCustomDialogTheme</item>
        <item name="alertDialogTheme">@style/MiraCustomDialogTheme</item>
    </style>

    <style name="CustomTheme" parent="Theme.Uhfuartdemo" />
    <style name="ActionBarBaseTheme" parent="Theme.Uhfuartdemo" />
    <style name="ActionBarBaseTheme1" parent="Theme.Uhfuartdemo" />

    <!-- Tab options text style -->  
    <style name="MyActionBarTabTextStyle" parent="TextAppearance.Material3.TitleMedium">          
        <item name="android:textColor">@drawable/check_text_color</item>
        <item name="android:textSize">16sp</item>  
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>  
    
    <style name="QuickMenuItemStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">86dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_quick_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="QuickMenuTextStyle">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- نمط التبويبات -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- 1. تعريف ثيم الموديل/الديالوج الموحد للتطبيق -->
    <style name="MiraCustomDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_mira_dialog</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:titleTextColor">#D4AF37</item> <!-- عنوان ذهبي فاخر -->
        <item name="android:fontFamily">@font/cairo</item> <!-- توحيد الخط القياسي -->
        <item name="colorAccent">#D4AF37</item>
        <item name="buttonBarPositiveButtonStyle">@style/MiraDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MiraDialogButton.Negative</item>
    </style>

    <!-- 2. تنسيق الأزرار داخل النوافذ (تأكيد / إلغاء) -->
    <style name="MiraDialogButton.Positive" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#D4AF37</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MiraDialogButton.Negative" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#8E8E93</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="DialogAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- Custom View Attributes for RFID / Radar components -->
    <declare-styleable name="RadarView">
        <attr name="center_image" format="reference" />
        <attr name="image_width" format="dimension" />
        <attr name="image_height" format="dimension" />
    </declare-styleable>

</resources>
