<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== الثيم الرئيسي ==================== -->
    <style name="Base.Theme.Uhfuartdemo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- داخل Base.Theme.Uhfuartdemo -->
        <item name="textInputStyle">@style/AppTextInputStyle</item>
        
        <!-- 🔤 الخطوط -->
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        
        <!-- 🔤 أوزان Typography -->
        <item name="textAppearanceDisplayLarge">@style/AppTextAppearance</item>
        <item name="textAppearanceDisplayMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceDisplaySmall">@style/AppTextAppearance</item>
        <item name="textAppearanceHeadlineLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineSmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleMedium">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceTitleSmall">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceBodyLarge">@style/AppTextAppearance</item>
        <item name="textAppearanceBodyMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceBodySmall">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelLarge">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceLabelMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelSmall">@style/AppTextAppearance</item>
        
        <!-- 🔤 إجبار المكونات -->
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        <item name="buttonStyle">@style/AppButtonStyle</item>
        <item name="radioButtonStyle">@style/AppRadioButtonStyle</item>
        <item name="checkboxStyle">@style/AppCheckBoxStyle</item>
        <item name="tabStyle">@style/AppTabStyle</item>
        
        <!-- 🎨 لوحة الألوان الفاخرة للوضع الفاتح -->
        <item name="colorPrimary">#D4AF37</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FDF8E7</item>
        <item name="colorOnPrimaryContainer">#2A2413</item>
        <item name="colorSecondary">#C5A059</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#F9F4E9</item>
        <item name="colorOnSecondaryContainer">#1E1C14</item>
        
        <!-- 🖼️ خلفية فاتحة -->
        <item name="android:colorBackground">#F9FAFB</item>
        <item name="colorOnBackground">#111827</item>
        
        <!-- 🗂️ الأسطح والبطاقات -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111827</item>
        <item name="colorSurfaceVariant">#F3F4F6</item>
        <item name="colorOnSurfaceVariant">#4B5563</item>
        
        <!-- 🔲 الحدود والإطارات -->
        <item name="colorOutline">#E5E7EB</item>
        <item name="colorOutlineVariant">#D1D5DB</item>
        
        <!-- ✅ توحيد النوافذ الحوارية -->
        <item name="android:alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/MiraBottomSheetDialogTheme</item>
    </style>

    <!-- ✅ CustomActiveIndicator - مهم جداً -->
    <style name="CustomActiveIndicator">
        <item name="android:color">#1A9E8033</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- ==================== SplashTheme ==================== -->
    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_gradient</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0F0C29</item>
        <item name="android:navigationBarColor">#0F0C29</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- ==================== MiraDialogTheme ==================== -->
    <style name="MiraDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_mira_dialog</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textColorPrimary">#1A1A1A</item>
        <item name="android:textColorSecondary">#666666</item>
        <item name="android:titleTextColor">#D4AF37</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="colorAccent">#D4AF37</item>
        <item name="colorPrimary">#D4AF37</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/MiraDialogShape</item>
        
        <item name="buttonBarPositiveButtonStyle">@style/MiraDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MiraDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/MiraDialogButton.Neutral</item>
    </style>

    <!-- ✅ شكل النافذة الحوارية -->
    <style name="MiraDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- ✅ تنسيق الأزرار -->
    <style name="MiraDialogButton.Positive" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#D4AF37</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MiraDialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#666666</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MiraDialogButton.Neutral" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#B8860B</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ✅ ثيم الـ BottomSheet الموحد -->
    <style name="MiraBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MiraBottomSheetStyle</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <style name="MiraBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="shapeAppearanceOverlay">@style/MiraBottomSheetShape</item>
    </style>

    <style name="MiraBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ==================== الأنماط المساعدة ==================== -->
    <style name="AppTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="AppTextAppearance.Medium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="AppTextAppearance.Bold">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="AppTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <style name="AppButtonStyle" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <style name="AppCheckBoxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <style name="AppTabStyle" parent="Widget.Material3.TabLayout">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <style name="Theme.Uhfuartdemo" parent="Base.Theme.Uhfuartdemo" />

    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="CustomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1AC5A059</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="AppTextInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

</resources>
