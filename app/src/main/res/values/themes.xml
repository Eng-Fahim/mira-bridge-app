<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/schemas/android">

    <!-- ═══════════════════════════════════════════════════════
         🎨 Base.Theme — Luxury Jewelry Light Theme
         ═══════════════════════════════════════════════════════ -->
    <style name="Base.Theme.Uhfuartdemo" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 🔗 ربط مكونات Material 3 -->
        <item name="bottomNavigationStyle">@style/AppBottomNavigationViewStyle</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar</item>
        <item name="actionOverflowMenuStyle">@style/CustomOverflowMenu</item>
        <item name="textInputStyle">@style/AppTextInputStyle</item>
        <item name="materialCardViewStyle">@style/AppCardViewStyle</item>

        <!-- 🔤 الخطوط -->
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>

        <!-- 🔤 أوزان Typography -->
        <item name="textAppearanceDisplayLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceDisplayMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceDisplaySmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineSmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleMedium">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceTitleSmall">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceBodyLarge">@style/AppTextAppearance</item>
        <item name="textAppearanceBodyMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceBodySmall">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelLarge">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceLabelMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelSmall">@style/AppTextAppearance</item>

        <!-- 🔤 إجبار المكونات -->
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        <item name="buttonStyle">@style/AppButtonStyle</item>
        <item name="radioButtonStyle">@style/AppRadioButtonStyle</item>
        <item name="checkboxStyle">@style/AppCheckBoxStyle</item>
        <item name="tabStyle">@style/AppTabStyle</item>
        <item name="chipStyle">@style/AppChipStyle</item>

        <!-- ═══════════════════════════════════════════════════
             🎨 LUXURY GOLD PALETTE (High Contrast Light Mode)
             ═══════════════════════════════════════════════════ -->

        <!-- ✨ Primary — الذهبي المطور -->
        <item name="colorPrimary">#C59B27</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFFBF0</item>
        <item name="colorOnPrimaryContainer">#3D2E00</item>
        <item name="colorPrimaryInverse">#F5D77E</item>

        <!-- 🍫 Secondary — كحلي فاخر وموثوق -->
        <item name="colorSecondary">#0F172A</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#F1F5F9</item>
        <item name="colorOnSecondaryContainer">#0F172A</item>

        <!-- 🥃 Tertiary — رمادي داكن ناعم -->
        <item name="colorTertiary">#475569</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#F1F5F9</item>
        <item name="colorOnTertiaryContainer">#0F172A</item>

        <!-- 🚨 Error — أحمر راقٍ واضح -->
        <item name="colorError">#DC2626</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FEF2F2</item>
        <item name="colorOnErrorContainer">#991B1B</item>

        <!-- 🖼️ Background — رمادي بارد ونظيف جِداً -->
        <item name="android:colorBackground">#F8FAFC</item>
        <item name="colorOnBackground">#0F172A</item>

        <!-- 🗂️ Surface — أبيض نقي مع نصوص عميقة -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">#475569</item>
        <item name="colorSurfaceInverse">#0F172A</item>
        <item name="colorOnSurfaceInverse">#F8FAFC</item>

        <!-- 🎯 Surface Containers (Material 3) -->
        <item name="colorSurfaceBright">#FFFFFF</item>
        <item name="colorSurfaceDim">#E2E8F0</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#F8FAFC</item>
        <item name="colorSurfaceContainerHighest">#F1F5F9</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>

        <!-- 🔲 الحدود -->
        <item name="colorOutline">#CBD5E1</item>
        <item name="colorOutlineVariant">#E2E8F0</item>

        <!-- 💫 Tint & Scrim -->
        <item name="android:colorControlActivated">#1AC59B27</item>
        <item name="android:colorControlHighlight">#14C59B27</item>

        <!-- ═══════════════════════════════════════════════════
             🔗 عناصر الواجهة الموحّدة
             ═══════════════════════════════════════════════════ -->

        <!-- نوافذ الحوار -->
        <item name="android:alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/MiraDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/MiraBottomSheetDialogTheme</item>

        <!-- Popup Menu -->
        <item name="popupMenuStyle">@style/AppPopupMenuStyle</item>
        <item name="android:itemBackground">@android:color/transparent</item>
        <item name="android:textColor">@color/primary_text</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- ==================== الثيمات المُصدَّرة ==================== -->
    <style name="Theme.Uhfuartdemo" parent="Base.Theme.Uhfuartdemo" />
    <style name="AppBaseTheme" parent="Theme.Uhfuartdemo" />
    <style name="AppTheme" parent="Theme.Uhfuartdemo" />

    <!-- ═══════════════════════════════════════════════════════
         ⚡ SplashTheme — موحّد مع Base.Theme
         ═══════════════════════════════════════════════════════ -->
    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_gradient</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#C59B27</item>
        <item name="android:navigationBarColor">#F8FAFC</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#FFFBF0</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>

        <!-- ✅ موحّد مع Base.Theme -->
        <item name="colorPrimary">#C59B27</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>

        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         💬 MiraDialogTheme — فاخر
         ═══════════════════════════════════════════════════════ -->
    <style name="MiraDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_mira_dialog</item>
        <item name="android:backgroundDimAmount">0.5</item>

        <!-- النصوص -->
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColorSecondary">#475569</item>
        <item name="android:titleTextColor">#C59B27</item>

        <!-- الخطوط -->
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>

        <!-- الألوان -->
        <item name="colorPrimary">#C59B27</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorAccent">#C59B27</item>

        <!-- الحواف -->
        <item name="shapeAppearanceOverlay">@style/MiraDialogShape</item>

        <!-- الأزرار -->
        <item name="buttonBarPositiveButtonStyle">@style/MiraDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MiraDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/MiraDialogButton.Neutral</item>
    </style>

    <style name="MiraDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MiraDialogButton.Positive" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#C59B27</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#1AC59B27</item>
    </style>

    <style name="MiraDialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#475569</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">#1A475569</item>
    </style>

    <style name="MiraDialogButton.Neutral" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#64748B</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">#1A64748B</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📄 MiraBottomSheetDialogTheme — فاخر
         ═══════════════════════════════════════════════════════ -->
    <style name="MiraBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MiraBottomSheetStyle</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="colorPrimary">#C59B27</item>
        <item name="colorOnSurface">#0F172A</item>
        <item name="colorSurface">#FFFFFF</item>
    </style>

    <style name="MiraBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet</item>
        <item name="shapeAppearanceOverlay">@style/MiraBottomSheetShape</item>
    </style>

    <style name="MiraBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📝 Text Appearance Styles
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="AppTextAppearance.Medium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="AppTextAppearance.Bold">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="AppTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">#0F172A</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🔘 Button Styles
         ═══════════════════════════════════════════════════════ -->
    <style name="AppButtonStyle" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">#C59B27</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppButtonStyle.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">#C59B27</item>
        <item name="android:textColor">#C59B27</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppButtonStyle.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">#FFFBF0</item>
        <item name="android:textColor">#3D2E00</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppButtonStyle.Text" parent="Widget.Material3.Button.TextButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#C59B27</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         ✅ Checkbox & Radio
         ═══════════════════════════════════════════════════════ -->
    <style name="AppRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:buttonTint">@color/selector_radio_tint</item>
    </style>

    <style name="AppCheckBoxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:buttonTint">@color/selector_checkbox_tint</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🏷️ Chip
         ═══════════════════════════════════════════════════════ -->
    <style name="AppChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📑 Tab Style
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTabStyle" parent="Widget.Material3.TabLayout">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="tabIndicatorColor">#C59B27</item>
        <item name="tabTextColor">@color/selector_tab_text</item>
        <item name="tabRippleColor">#1AC59B27</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🏷️ Toolbar Title
         ═══════════════════════════════════════════════════════ -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎯 Bottom Navigation
         ═══════════════════════════════════════════════════════ -->
    <style name="CustomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1AC59B27</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📝 Text Input
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTextInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="hintTextColor">@color/colorOnSurfaceVariant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎴 Card View
         ═══════════════════════════════════════════════════════ -->
    <style name="AppCardViewStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AppCardViewStyle.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎯 Popup Menu
         ═══════════════════════════════════════════════════════ -->
    <style name="AppPopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_custom_popup_menu</item>
        <item name="android:itemTextAppearance">@style/AppPopupMenuTextStyle</item>
    </style>

    <style name="AppPopupMenuTextStyle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

</resources>
