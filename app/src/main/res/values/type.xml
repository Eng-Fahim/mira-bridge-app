        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ✅ الأساسي على الذهبي -->
    <style name="TextAppearance.App.Number.OnGold">
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
