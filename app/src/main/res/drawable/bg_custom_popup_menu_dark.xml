<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- ✅ Gradient بني داكن → فحمي -->
    <gradient
        android:angle="135"
        android:startColor="#2A2520"
        android:centerColor="#221F1C"
        android:endColor="#1A1816"
        android:type="linear" />

    <!-- ✅ حواف دائرية -->
    <corners android:radius="16dp" />

    <!-- ✅ حد ذهبي خفيف -->
    <stroke
        android:width="1dp"
        android:color="#4A3B2A" />

    <!-- ✅ ظل داخلي (اختياري) -->
    <padding
        android:left="4dp"
        android:top="6dp"
        android:right="4dp"
        android:bottom="6dp" />

</shape>
