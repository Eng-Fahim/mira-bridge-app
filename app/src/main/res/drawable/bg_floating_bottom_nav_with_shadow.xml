<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الظل الناعم -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#20000000" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- الشريط نفسه (كبسولة) -->
    <item
        android:top="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorSurface" />
            <corners android:radius="100dp" />
            <!-- حد ذهبي خفيف جداً -->
            <stroke
                android:width="1dp"
                android:color="#33E8C766" />
        </shape>
    </item>
</layer-list>
