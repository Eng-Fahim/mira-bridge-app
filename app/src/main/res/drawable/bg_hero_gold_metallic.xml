<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الطبقة الأساسية: تدرج ذهبي -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FADB7F"
                android:centerColor="#D4AF37"
                android:endColor="#AA820A"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- الطبقة الثانية: لمعان علوي (60dp من الأعلى) -->
    <item
        android:bottom="200dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#50FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>

    <!-- الطبقة الثالثة: ظل سفلي (60dp من الأسفل) -->
    <item
        android:bottom="0dp"
        android:top="260dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#33000000"
                android:endColor="#00000000"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>

</layer-list>
