<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الطبقة الأساسية: تدرّج ذهبي معدني -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#E5C158"
                android:endColor="#B8942E"
                android:startColor="#F5D77E"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- الطبقة الثانية: لمعان علوي (يعطي إحساس المعدن) -->
    <item
        android:bottom="50%"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>

    <!-- الطبقة الثالثة: لمعان سفلي خفيف -->
    <item
        android:bottom="0dp"
        android:top="80%">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#20000000"
                android:startColor="#00000000"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp"
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp" />
        </shape>
    </item>

</layer-list>
