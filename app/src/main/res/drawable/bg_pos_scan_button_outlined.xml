<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_gold_transparent_10" />
            <corners android:radius="@dimen/pos_scan_btn_radius" />
            <stroke
                android:width="1.5dp"
                android:color="@color/pos_gold_deep" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_status_active_bg" />
            <corners android:radius="@dimen/pos_scan_btn_radius" />
            <stroke
                android:width="1.5dp"
                android:color="@color/pos_status_active" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/pos_scan_btn_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/pos_stroke_light" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/pos_scan_btn_radius" />
            <stroke
                android:width="1.5dp"
                android:color="@color/pos_gold_primary" />
        </shape>
    </item>
</selector>
