<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_summary_bg_active" />
            <corners android:radius="@dimen/pos_summary_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_summary_bg_idle" />
            <corners android:radius="@dimen/pos_summary_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/pos_stroke_light" />
        </shape>
    </item>
</selector>
