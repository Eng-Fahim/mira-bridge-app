<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- خلفية بيضاء ناعمة -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F8F9FA" />
        </shape>
    </item>
    
    <!-- تدرج خفيف من الأعلى -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#FFF8E1"
                android:endColor="#F8F9FA"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
