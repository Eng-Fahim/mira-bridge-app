<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ═══════════════════════════════════════════════════════
         1) الإطار الكامل الخفيف (تحديد المنطقة)
         ═══════════════════════════════════════════════════════ -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#40C59B27" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- ═══════════════════════════════════════════════════════
         2) الزوايا الذهبية البارزة (التركيز البصري)
         ═══════════════════════════════════════════════════════ -->

    <!-- زاوية علوية يسرى -->
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="top|start">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#C59B27" />
        </shape>
    </item>

    <!-- زاوية علوية يمنى -->
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="top|end">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#C59B27" />
        </shape>
    </item>

    <!-- زاوية سفلية يسرى -->
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="bottom|start">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#C59B27" />
        </shape>
    </item>

    <!-- زاوية سفلية يمنى -->
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="bottom|end">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#C59B27" />
        </shape>
    </item>

</layer-list>
