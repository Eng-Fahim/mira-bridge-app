<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- زوايا دائرية -->
    <corners android:radius="16dp" />
    
    <!-- تدرج لوني أخضر جذاب (من الأعلى للأسفل) -->
    <gradient
        android:angle="270"
        android:startColor="#16A34A" 
        android:endColor="#15803D" 
        android:type="linear" />
        
    <!-- إطار خفيف جداً لإعطاء عمق -->
    <stroke
        android:width="1dp"
        android:color="#166534" />
</shape>
