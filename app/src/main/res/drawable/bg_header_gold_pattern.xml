<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FDFBF7"
                android:centerColor="#F5EFE6"
                android:endColor="#E8DCC8"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:centerX="0.8"
                android:centerY="0.2"
                android:startColor="#22D4AF37" 
                android:endColor="#00D4AF37" />
        </shape>
    </item>
</layer-list>
