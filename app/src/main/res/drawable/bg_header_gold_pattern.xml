<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 1. الخلفية الأساسية (تدرج لوني فاتح جداً) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FDFBF7"
                android:endColor="#F5EFE6"
                android:type="linear" />
        </shape>
    </item>

    <!-- 2. النمط الهندسي (شبكة من الماسات الباهتة) -->
    <item>
        <bitmap android:src="@drawable/ic_mira_pattern" android:tileMode="repeat" />
    </item>
    
    <!-- 3. طبقة شفافة لزيادة التخفيف إذا لزم الأمر -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80FFFFFF" /> <!-- 50% شفافية -->
        </shape>
    </item>
</layer-list>
