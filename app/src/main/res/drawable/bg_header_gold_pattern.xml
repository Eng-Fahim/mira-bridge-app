<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- الطبقة 1: التدرج الذهبي الخفيف -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FDFBF7"
                android:centerColor="#F5EFE6"
                android:endColor="#E8DCC8"
                android:type="linear" />
        </shape>
    </item>

    <!-- الطبقة 2: النقشة (تكرار الماسة) -->
    <item>
        <bitmap 
            android:src="@drawable/pattern_tile" 
            android:tileMode="repeat" />
    </item>
    
</layer-list>
