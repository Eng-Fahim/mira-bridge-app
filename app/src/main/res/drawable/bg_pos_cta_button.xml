<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_cta_disabled" />
            <corners android:radius="@dimen/pos_cta_radius" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_gold_deep" />
            <corners android:radius="@dimen/pos_cta_radius" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/pos_gold_primary"
                android:endColor="@color/pos_gold_deep" />
            <corners android:radius="@dimen/pos_cta_radius" />
        </shape>
    </item>
</selector>
