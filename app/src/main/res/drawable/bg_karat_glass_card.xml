<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- خلفية داكنة نصف شفافة تمنح عمقاً وتبرز النصوص البيضاء والذهبية بوضوح تان -->
    <solid android:color="#40000000" />
    
    <!-- حواف دائرية ناعمة ومنحنية بأناقة (16dp) -->
    <corners android:radius="16dp" />
    
    <!-- إطار ذهبي خفيف وشفاف يحدد الكارت باحترافية ليتماشى مع هوية ميرا -->
    <stroke
        android:width="1.2dp"
        android:color="#59FFD700" />
        
</shape>
