<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- خلفية داكنة فخمة مع شفافية بسيطة -->
    <solid android:color="#1F2430" />
    
    <!-- إطار ذهبي فاخر بسماكة 1dp -->
