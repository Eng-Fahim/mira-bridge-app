<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 📌 أزرار التولبار الظاهرة مباشرة (Header Bar) -->
    
    <!-- 1. زر أسعار الذهب والبورصة (بدلاً من زر الرئيسية المتكرر) -->
    <item
        android:id="@+id/action_gold_rates"
        android:icon="@drawable/ic_gold_rate"
        android:title="@string/menu_gold_rates"
        app:showAsAction="always" />

    <!-- 2. زر الملف الشخصي -->
    <item
        android:id="@+id/action_profile"
        android:icon="@drawable/ic_profile"
        android:title="@string/menu_profile"
        app:showAsAction="always" />

    <!-- 3. مركز الإشعارات والرسائل (مع البادج) -->
    <item
        android:id="@+id/action_notifications"
        android:title="@string/action_notifications"
        android:icon="@drawable/ic_notifications"
        app:actionLayout="@layout/action_item_notification_badge"
        app:showAsAction="always" />


    <!-- 📌 القائمة المنسدلة (Overflow Menu) - مخصصة فقط للتهيئة والإعدادات -->

    <!-- إعدادات الواجهة والتخصيص -->
    <group android:id="@+id/group_settings">
        <item
            android:id="@+id/action_quick_access_settings"
            android:icon="@drawable/ic_settings"
            android:title="@string/menu_quick_access"
            app:showAsAction="never" />

        <item
            android:id="@+id/nav_sound_settings"
            android:icon="@drawable/ic_volume_up"
            android:title="@string/menu_sounds_setting"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_toggle_language"
            android:icon="@drawable/ic_language"
            android:title="@string/menu_toggle_language"
            app:showAsAction="never" />
    </group>

    <!-- إدارة النظام والفروع -->
    <group android:id="@+id/group_management">
        <item
            android:id="@+id/action_branches"
            android:icon="@drawable/ic_branch"
            android:title="@string/menu_branches"
            app:showAsAction="never" />

        <item
            android:id="@+id/export"
            android:icon="@drawable/ic_export"
            android:title="@string/menu_export_data"
            app:showAsAction="never" />
    </group>

    <!-- حول الجهاز والنظام -->
    <group android:id="@+id/group_info">
        <item
            android:id="@+id/UHF_ver"
            android:icon="@drawable/ic_info"
            android:title="@string/menu_device_version"
            app:showAsAction="never" />
    </group>

    <!-- تسجيل الخروج -->
    <group android:id="@+id/group_logout">
        <item
            android:id="@+id/action_logout"
            android:icon="@drawable/ic_logout"
            android:title="@string/menu_logout"
            app:showAsAction="never" />
    </group>

</menu>
