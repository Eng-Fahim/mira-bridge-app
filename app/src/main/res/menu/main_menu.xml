<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  1. المؤشرات الحية الظاهرة في الشريط العلوي (3 فقط)     -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <item
        android:id="@+id/action_gold_rates"
        android:icon="@drawable/ic_gold_rate"
        android:title="@string/menu_gold_rates"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_device_status"
        android:icon="@drawable/ic_device_connected"
        android:title="@string/menu_device_status"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_notifications"
        android:icon="@drawable/ic_notifications"
        android:title="@string/action_notifications"
        app:actionLayout="@layout/action_item_notification_badge"
        app:showAsAction="always" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  2. القائمة المنسدلة الفاخرة (Overflow Menu)            -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- الحساب والعمليات السريعة -->
    <group android:id="@+id/group_account_ops">
        <item
            android:id="@+id/action_profile"
            android:icon="@drawable/ic_profile"
            android:title="@string/menu_profile"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_mira_inventory"
            android:icon="@drawable/ic_inventory"
            android:title="جرد MIRA"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_locator"
            android:icon="@drawable/ic_diamond"
            android:title="باحث القطع (الرادار)"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_export_data"
            android:icon="@drawable/ic_export"
            android:title="@string/menu_export_data"
            app:showAsAction="never" />
    </group>

    <!-- إعدادات الواجهة والتخصيص -->
    <group android:id="@+id/group_settings">
        <item
            android:id="@+id/action_quick_access_settings"
            android:icon="@drawable/ic_settings"
            android:title="@string/menu_quick_access"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_sound_settings"
            android:icon="@drawable/ic_volume_up"
            android:title="@string/menu_sounds_setting"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_toggle_language"
            android:icon="@drawable/ic_language"
            android:title="@string/menu_toggle_language"
            app:showAsAction="never" />
    </group>

    <!-- الترخيص ومعلومات النظام -->
    <group android:id="@+id/group_info">
        <item
            android:id="@+id/action_license_status"
            android:icon="@drawable/ic_info"
            android:title="حالة الترخيص"
            app:showAsAction="never" />

        <item
            android:id="@+id/action_device_version"
            android:icon="@drawable/ic_info"
            android:title="@string/menu_device_version"
            app:showAsAction="never" />
    </group>

    <!-- تسجيل الخروج -->
    <group android:id="@+id/group_logout">
        <item
            android:id="@+id/action_logout"
            android:icon="@drawable/ic_logout"
            android:title="@string/menu_logout"
            app:showAsAction="never" />
    </group>

    <!-- عناصر مخفية للحفاظ على التوافق البرمجي دون ظهور -->
    <item
        android:id="@+id/action_accounting_setup"
        android:title="إعداد المحاسبة"
        android:visible="false"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_accounting"
        android:title="المحاسبة"
        android:visible="false"
        app:showAsAction="never" />

</menu>
