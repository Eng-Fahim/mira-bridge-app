<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- تضمين الإعدادات المشتركة -->
    <include domain="sharedpref" path="."/>
    
    <!-- تضمين قاعدة البيانات -->
    <include domain="database" path="."/>
    
    <!-- تضمين الملفات المهمة -->
    <include domain="file" path="."/>
    
    <!-- تضمين ملفات التقارير -->
    <include domain="external" path="Documents/"/>
    <include domain="external" path="Pictures/"/>
    
    <!-- استثناء ملفات الكاش -->
    <exclude domain="file" path="cache"/>
    <exclude domain="file" path="code_cache"/>
    <exclude domain="external" path="cache"/>
    
    <!-- استثناء الملفات المؤقتة -->
    <exclude domain="external" path="exports/"/>
    <exclude domain="cache" path="."/>
</full-backup-content>
