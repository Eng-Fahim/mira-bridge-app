<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <!-- الانتقال من Shimmer إلى المحتوى -->
    <Transition
        motion:constraintSetStart="@+id/start"
        motion:constraintSetEnd="@+id/end"
        motion:duration="500">

        <OnSwipe
            motion:touchAnchorId="@+id/swipeRefresh"
            motion:touchAnchorSide="top"
            motion:dragDirection="dragDown" />

        <KeyFrameSet>
            <KeyAttribute
                motion:motionTarget="@+id/greetingCard"
                motion:framePosition="0"
                android:alpha="0"
                android:translationY="50dp" />

            <KeyAttribute
                motion:motionTarget="@+id/greetingCard"
                motion:framePosition="100"
                android:alpha="1"
                android:translationY="0dp" />

            <KeyAttribute
                motion:motionTarget="@+id/inventoryMetrics"
                motion:framePosition="0"
                android:alpha="0"
                android:translationY="80dp" />

            <KeyAttribute
                motion:motionTarget="@+id/inventoryMetrics"
                motion:framePosition="100"
                android:alpha="1"
                android:translationY="0dp" />

            <KeyAttribute
                motion:motionTarget="@+id/cardGoldPrices"
                motion:framePosition="0"
                android:alpha="0"
                android:translationY="100dp" />

            <KeyAttribute
                motion:motionTarget="@+id/cardGoldPrices"
                motion:framePosition="100"
                android:alpha="1"
                android:translationY="0dp" />

            <KeyAttribute
                motion:motionTarget="@+id/salesSummaryCard"
                motion:framePosition="0"
                android:alpha="0"
                android:translationY="120dp" />

            <KeyAttribute
                motion:motionTarget="@+id/salesSummaryCard"
                motion:framePosition="100"
                android:alpha="1"
                android:translationY="0dp" />
        </KeyFrameSet>
    </Transition>

    <ConstraintSet android:id="@+id/start">
        <Constraint
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="1" />
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />
    </ConstraintSet>
</MotionScene>
