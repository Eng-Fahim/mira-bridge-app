<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════
         🌙 Base.Theme — Luxury Jewelry Dark Theme
         ═══════════════════════════════════════════════════════ -->
    <style name="Base.Theme.Uhfuartdemo" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- داخل Base.Theme.Uhfuartdemo -->
<item name="colorSurfaceContainer">#1A1816</item>
<item name="colorSurfaceContainerHigh">#221F1C</item>
        <!-- 🔗 ربط مكونات Material 3 -->
        <item name="bottomNavigationStyle">@style/AppBottomNavigationViewStyle</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar</item>
        <item name="actionOverflowMenuStyle">@style/CustomOverflowMenu</item>
        <item name="textInputStyle">@style/AppTextInputStyle</item>
        <item name="materialCardViewStyle">@style/AppCardViewStyle</item>

        <!-- 🔤 الخطوط -->
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>

        <!-- 🔤 أوزان Typography -->
        <item name="textAppearanceDisplayLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceDisplayMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceDisplaySmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineSmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleMedium">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceTitleSmall">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceBodyLarge">@style/AppTextAppearance</item>
        <item name="textAppearanceBodyMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceBodySmall">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelLarge">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceLabelMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelSmall">@style/AppTextAppearance</item>

        <!-- 🔤 إجبار المكونات -->
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        <item name="buttonStyle">@style/AppButtonStyle</item>
        <item name="radioButtonStyle">@style/AppRadioButtonStyle</item>
        <item name="checkboxStyle">@style/AppCheckBoxStyle</item>
        <item name="tabStyle">@style/AppTabStyle</item>
        <item name="chipStyle">@style/AppChipStyle</item>

        <!-- ═══════════════════════════════════════════════════
             🌙 LUXURY DARK PALETTE
             ═══════════════════════════════════════════════════ -->

        <!-- ✨ Primary — ذهبي فاتح -->
        <item name="colorPrimary">#E8C766</item>
        <item name="colorOnPrimary">#3E2723</item>              <!-- ← بني شوكولاتة ✅ -->
        <item name="colorPrimaryContainer">#3D2F00</item>
        <item name="colorOnPrimaryContainer">#FFE082</item>
        <item name="colorPrimaryInverse">#B8860B</item>

        <!-- 🍫 Secondary — بني فاتح -->
        <item name="colorSecondary">#D7CCC8</item>
        <item name="colorOnSecondary">#3E2723</item>            <!-- ← بني ✅ -->
        <item name="colorSecondaryContainer">#4E342E</item>
        <item name="colorOnSecondaryContainer">#EFEBE9</item>

        <!-- 🥃 Tertiary — بني متوسط -->
        <item name="colorTertiary">#BCAAA4</item>
        <item name="colorOnTertiary">#2E1A00</item>
        <item name="colorTertiaryContainer">#4E342E</item>
        <item name="colorOnTertiaryContainer">#EFEBE9</item>

        <!-- 🚨 Error -->
        <item name="colorError">#F2B8B5</item>
        <item name="colorOnError">#601410</item>
        <item name="colorErrorContainer">#8C1D18</item>
        <item name="colorOnErrorContainer">#F9DEDC</item>

        <!-- 🖼️ Background — أسود فاخر -->
        <item name="android:colorBackground">#0B0B0C</item>
        <item name="colorOnBackground">#F3F4F6</item>

        <!-- 🗂️ Surface — رمادي داكن دافئ -->
        <item name="colorSurface">#161618</item>
        <item name="colorOnSurface">#F9FAFB</item>
        <item name="colorSurfaceVariant">#221F1C</item>          <!-- ← بني مائل ✅ -->
        <item name="colorOnSurfaceVariant">#D7CCC8</item>        <!-- ← بني فاتح ✅ -->
        <item name="colorSurfaceInverse">#F9FAFB</item>
        <item name="colorOnSurfaceInverse">#1A1A1A</item>

        <!-- 🎯 Surface Containers (Material 3) -->
        <item name="colorSurfaceBright">#2C2A28</item>
        <item name="colorSurfaceDim">#0B0B0C</item>
        <item name="colorSurfaceContainer">#1A1816</item>        <!-- ← بني داكن -->
        <item name="colorSurfaceContainerHigh">#221F1C</item>
        <item name="colorSurfaceContainerHighest">#2C2A28</item>
        <item name="colorSurfaceContainerLow">#141210</item>
        <item name="colorSurfaceContainerLowest">#0B0B0C</item>

        <!-- 🔲 الحدود -->
        <item name="colorOutline">#3F3325</item>                 <!-- ← بني داكن ✅ -->
        <item name="colorOutlineVariant">#2E241B</item>
        <!-- 💫 Tint & Scrim -->
        <item name="android:colorControlHighlight">#20E8C766</item>
        <item name="android:colorControlActivated">#25E8C766</item>
        <!-- ═══════════════════════════════════════════════════
             🔗 عناصر الواجهة الموحّدة
             ═══════════════════════════════════════════════════ -->

        <item name="android:alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/MiraDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/MiraBottomSheetDialogTheme</item>

        <item name="popupMenuStyle">@style/AppPopupMenuStyle</item>
        <item name="android:itemBackground">@android:color/transparent</item>
        <item name="android:textColor">@color/primary_text</item>

        <!-- Status Bar — ذهبي في الوضع الليلي -->
        <item name="android:statusBarColor">#B8860B</item>       <!-- ← ذهبي ✅ -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0B0B0C</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- ==================== الثيمات المُصدَّرة ==================== -->
    <style name="Theme.Uhfuartdemo" parent="Base.Theme.Uhfuartdemo" />
    <style name="AppBaseTheme" parent="Theme.Uhfuartdemo" />
    <style name="AppTheme" parent="Theme.Uhfuartdemo" />

    <!-- ═══════════════════════════════════════════════════════
         ⚡ SplashTheme — موحّد
         ═══════════════════════════════════════════════════════ -->
    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_gradient_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#B8860B</item>       <!-- ← ذهبي ✅ -->
        <item name="android:navigationBarColor">#0B0B0C</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#0B0B0C</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>

        <item name="colorPrimary">#E8C766</item>
        <item name="colorOnPrimary">#3E2723</item>
        <item name="colorSurface">#161618</item>
        <item name="colorOnSurface">#F9FAFB</item>

        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         💬 MiraDialogTheme — فاخر داكن
         ═══════════════════════════════════════════════════════ -->
    <style name="MiraDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_mira_dialog_dark</item>
        <item name="android:backgroundDimAmount">0.75</item>

        <item name="android:textColorPrimary">#F9FAFB</item>
        <item name="android:textColorSecondary">#D7CCC8</item>
        <item name="android:titleTextColor">#E8C766</item>

        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>

        <item name="colorPrimary">#E8C766</item>
        <item name="colorOnPrimary">#3E2723</item>
        <item name="colorSurface">#1A1816</item>
        <item name="colorOnSurface">#F9FAFB</item>
        <item name="colorAccent">#E8C766</item>

        <item name="shapeAppearanceOverlay">@style/MiraDialogShape</item>

        <item name="buttonBarPositiveButtonStyle">@style/MiraDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MiraDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/MiraDialogButton.Neutral</item>
    </style>

    <style name="MiraDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MiraDialogButton.Positive" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#E8C766</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#20E8C766</item>
    </style>

    <style name="MiraDialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#D7CCC8</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">#20D7CCC8</item>
    </style>

    <style name="MiraDialogButton.Neutral" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#BCAAA4</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">#20BCAAA4</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📄 MiraBottomSheetDialogTheme
         ═══════════════════════════════════════════════════════ -->
    <style name="MiraBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MiraBottomSheetStyle</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="colorPrimary">#E8C766</item>
        <item name="colorOnSurface">#F9FAFB</item>
        <item name="colorSurface">#1A1816</item>
    </style>

    <style name="MiraBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet_dark</item>
        <item name="shapeAppearanceOverlay">@style/MiraBottomSheetShape</item>
    </style>

    <style name="MiraBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📝 Text Appearance
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="AppTextAppearance.Medium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="AppTextAppearance.Bold">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="AppTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🔘 Buttons
         ═══════════════════════════════════════════════════════ -->
    <style name="AppButtonStyle" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         ✅ Checkbox & Radio & Chip
         ═══════════════════════════════════════════════════════ -->
    <style name="AppRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:buttonTint">@color/selector_radio_tint_dark</item>
    </style>

    <style name="AppCheckBoxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:buttonTint">@color/selector_checkbox_tint_dark</item>
    </style>

    <style name="AppChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg_dark</item>
        <item name="android:textColor">@color/selector_chip_text_dark</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke_dark</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📑 Tab Style
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTabStyle" parent="Widget.Material3.TabLayout">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="tabIndicatorColor">#E8C766</item>
        <item name="tabTextColor">@color/selector_tab_text_dark</item>
        <item name="tabRippleColor">#20E8C766</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🏷️ Toolbar
         ═══════════════════════════════════════════════════════ -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎯 Bottom Navigation
         ═══════════════════════════════════════════════════════ -->
    <style name="CustomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#25E8C766</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📝 Text Input
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTextInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/colorSurface</item>
        <item name="boxStrokeColor">@color/selector_text_input_stroke_dark</item>
        <item name="hintTextColor">@color/colorOnSurfaceVariant</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎴 Card View
         ═══════════════════════════════════════════════════════ -->
    <style name="AppCardViewStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎯 Popup Menu
         ═══════════════════════════════════════════════════════ -->
    <style name="AppPopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_custom_popup_menu_dark</item>
        <item name="android:itemTextAppearance">@style/AppPopupMenuTextStyle</item>
    </style>

    <style name="AppPopupMenuTextStyle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

</resources>
