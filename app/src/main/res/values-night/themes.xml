<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════
         🌙 Base.Theme — Luxury Jewelry Dark Theme v2.0
         ═══════════════════════════════════════════════════════ -->
    <style name="Base.Theme.Uhfuartdemo" parent="Theme.Material3.Dark.NoActionBar">

        <!-- 🔗 ربط مكونات Material 3 -->
        <item name="bottomNavigationStyle">@style/AppBottomNavigationViewStyle</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar</item>
        <item name="actionOverflowMenuStyle">@style/CustomOverflowMenu</item>
        <item name="textInputStyle">@style/AppTextInputStyle</item>
        <item name="materialCardViewStyle">@style/AppCardViewStyle</item>

        <!-- 🔤 الخطوط -->
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>

        <!-- 🔤 أوزان Typography -->
        <item name="textAppearanceDisplayLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceDisplayMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceDisplaySmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineMedium">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceHeadlineSmall">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleLarge">@style/AppTextAppearance.Bold</item>
        <item name="textAppearanceTitleMedium">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceTitleSmall">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceBodyLarge">@style/AppTextAppearance</item>
        <item name="textAppearanceBodyMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceBodySmall">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelLarge">@style/AppTextAppearance.Medium</item>
        <item name="textAppearanceLabelMedium">@style/AppTextAppearance</item>
        <item name="textAppearanceLabelSmall">@style/AppTextAppearance</item>

        <!-- 🔤 إجبار المكونات -->
        <item name="android:textViewStyle">@style/AppTextViewStyle</item>
        <item name="materialButtonStyle">@style/AppButtonStyle</item>
        <item name="buttonStyle">@style/AppButtonStyle</item>
        <item name="radioButtonStyle">@style/AppRadioButtonStyle</item>
        <item name="checkboxStyle">@style/AppCheckBoxStyle</item>
        <item name="tabStyle">@style/AppTabStyle</item>
        <item name="chipStyle">@style/AppChipStyle</item>

        <!-- ═══════════════════════════════════════════════════
             🎨 MATERIAL 3 COLOR ROLES — Dark Palette
             ═══════════════════════════════════════════════════ -->

        <!-- ✨ Primary — الذهبي الأساسي -->
        <item name="colorPrimary">@color/gold_luxury</item>
        <item name="colorOnPrimary">@color/gold_luxury_dark_deep</item>
        <item name="colorPrimaryContainer">@color/gold_luxury_soft</item>
        <item name="colorOnPrimaryContainer">@color/gold_luxury_highlight</item>
        <item name="colorPrimaryInverse">@color/gold_luxury_dark</item>
        <item name="colorPrimaryFixed">@color/gold_luxury_light</item>
        <item name="colorPrimaryFixedDim">@color/gold_luxury</item>
        <item name="colorOnPrimaryFixed">@color/gold_luxury_dark_deep</item>
        <item name="colorOnPrimaryFixedVariant">@color/gold_luxury_dark</item>

        <!-- 🍫 Secondary — البني الفاتح -->
        <item name="colorSecondary">@color/chocolate</item>
        <item name="colorOnSecondary">@color/chocolate_dark_deep</item>
        <item name="colorSecondaryContainer">@color/chocolate_dark</item>
        <item name="colorOnSecondaryContainer">@color/chocolate_light</item>
        <item name="colorSecondaryFixed">@color/chocolate_light</item>
        <item name="colorSecondaryFixedDim">@color/chocolate</item>
        <item name="colorOnSecondaryFixed">@color/chocolate_dark_deep</item>
        <item name="colorOnSecondaryFixedVariant">@color/chocolate_dark</item>

        <!-- 🥃 Tertiary — البني المتوسط -->
        <item name="colorTertiary">@color/chocolate_light</item>
        <item name="colorOnTertiary">@color/chocolate_dark_deep</item>
        <item name="colorTertiaryContainer">@color/chocolate_dark</item>
        <item name="colorOnTertiaryContainer">@color/chocolate_light</item>
        <item name="colorTertiaryFixed">@color/chocolate_light</item>
        <item name="colorTertiaryFixedDim">@color/chocolate</item>
        <item name="colorOnTertiaryFixed">@color/chocolate_dark_deep</item>
        <item name="colorOnTertiaryFixedVariant">@color/chocolate_dark</item>

        <!-- 🚨 Error -->
        <item name="colorError">@color/error_luxury</item>
        <item name="colorOnError">@color/error_container_deep</item>
        <item name="colorErrorContainer">@color/error_container_luxury</item>
        <item name="colorOnErrorContainer">@color/error_luxury_light</item>

        <!-- 🖼️ Background -->
        <item name="android:colorBackground">@color/black_luxury</item>
        <item name="colorOnBackground">@color/text_light_primary</item>

        <!-- 🗂️ Surface -->
        <item name="colorSurface">@color/gray_dark_warm</item>
        <item name="colorOnSurface">@color/text_light_primary</item>
        <item name="colorSurfaceVariant">@color/chocolate_soft</item>
        <item name="colorOnSurfaceVariant">@color/text_light_secondary</item>
        

        <!-- ✅ إصلاح: Inverse Surface (يمثل الوضع الفاتح) -->
        <item name="colorSurfaceInverse">@color/surface_inverse_dark</item>
        <item name="colorOnSurfaceInverse">@color/on_surface_inverse_dark</item>

        <!-- 🎯 Surface Containers (Material 3) -->
        <item name="colorSurfaceBright">@color/gray_warm</item>
        <item name="colorSurfaceDim">@color/black_luxury</item>
        <item name="colorSurfaceContainerLowest">@color/black_luxury</item>
        <item name="colorSurfaceContainerLow">@color/black_soft</item>
        <item name="colorSurfaceContainer">@color/black_highlight</item>
        <item name="colorSurfaceContainerHigh">@color/chocolate_soft</item>
        <item name="colorSurfaceContainerHighest">@color/gray_warm</item>

        <!-- 🔲 الحدود — ✅ إصلاح: outlineVariant أفتح -->
        <item name="colorOutline">@color/border_dark_warm</item>
        <item name="colorOutlineVariant">@color/border_dark_medium</item>
        

        <!-- 💫 State Layers -->
        <item name="android:colorControlHighlight">@color/state_layer_gold_pressed</item>
        <item name="android:colorControlActivated">@color/gold_luxury</item>
        <item name="android:colorControlNormal">@color/text_light_secondary</item>

        <!-- ═══════════════════════════════════════════════════
             🔗 عناصر الواجهة الموحّدة
             ═══════════════════════════════════════════════════ -->

        <item name="android:alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="alertDialogTheme">@style/MiraDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/MiraDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/MiraBottomSheetDialogTheme</item>

        <item name="popupMenuStyle">@style/AppPopupMenuStyle</item>
        <item name="android:itemBackground">@android:color/transparent</item>
        <item name="android:textColor">@color/primary_text</item>

        <!-- ✅ إصلاح: Status Bar شفاف (Edge-to-Edge) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>

        <!-- 🎬 Animations -->
        <item name="android:windowAnimationStyle">@style/Animation.App.Window</item>
    </style>

    <!-- ==================== الثيمات المُصدَّرة ==================== -->
    <style name="Theme.Uhfuartdemo" parent="Base.Theme.Uhfuartdemo" />
    <style name="AppBaseTheme" parent="Theme.Uhfuartdemo" />
    <style name="AppTheme" parent="Theme.Uhfuartdemo" />

    <!-- ═══════════════════════════════════════════════════════
         ⚡ SplashTheme
         ═══════════════════════════════════════════════════════ -->
    <style name="SplashTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background_gradient_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/black_luxury</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>

        <item name="colorPrimary">@color/gold_luxury</item>
        <item name="colorOnPrimary">@color/gold_luxury_dark_deep</item>
        <item name="colorSurface">@color/gray_dark_warm</item>
        <item name="colorOnSurface">@color/text_light_primary</item>

        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         💬 MiraDialogTheme
         ═══════════════════════════════════════════════════════ -->
    <style name="MiraDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/bg_mira_dialog_dark</item>
        <item name="android:backgroundDimAmount">0.75</item>

        <item name="android:textColorPrimary">@color/text_light_primary</item>
        <item name="android:textColorSecondary">@color/text_light_secondary</item>
        <item name="android:titleTextColor">@color/gold_luxury</item>

        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>

        <item name="colorPrimary">@color/gold_luxury</item>
        <item name="colorOnPrimary">@color/gold_luxury_dark_deep</item>
        <item name="colorSurface">@color/black_highlight</item>
        <item name="colorOnSurface">@color/text_light_primary</item>
        <item name="colorAccent">@color/gold_luxury</item>

        <item name="shapeAppearanceOverlay">@style/MiraDialogShape</item>

        <item name="buttonBarPositiveButtonStyle">@style/MiraDialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/MiraDialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/MiraDialogButton.Neutral</item>
    </style>

    <style name="MiraDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MiraDialogButton.Positive" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/gold_luxury</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/state_layer_gold_pressed</item>
    </style>

    <style name="MiraDialogButton.Negative" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/chocolate</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/state_layer_hover</item>
    </style>

    <style name="MiraDialogButton.Neutral" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/chocolate_light</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/state_layer_hover</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📄 MiraBottomSheetDialogTheme
         ═══════════════════════════════════════════════════════ -->
    <style name="MiraBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MiraBottomSheetStyle</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="colorPrimary">@color/gold_luxury</item>
        <item name="colorOnSurface">@color/text_light_primary</item>
        <item name="colorSurface">@color/black_highlight</item>
    </style>

    <style name="MiraBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_bottom_sheet_dark</item>
        <item name="shapeAppearanceOverlay">@style/MiraBottomSheetShape</item>
    </style>

    <style name="MiraBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📝 Text Appearance
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppTextAppearance.Medium">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppTextAppearance.Bold">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTextAppearance.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="AppTextAppearance.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="AppTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🔘 Buttons
         ═══════════════════════════════════════════════════════ -->
    <style name="AppButtonStyle" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/gold_luxury</item>
        <item name="android:textColor">@color/gold_luxury_dark_deep</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AppButtonStyle.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/gold_luxury</item>
        <item name="android:textColor">@color/gold_luxury</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AppButtonStyle.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/gold_luxury_soft</item>
        <item name="android:textColor">@color/gold_luxury_highlight</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AppButtonStyle.Text" parent="Widget.Material3.Button.TextButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/gold_luxury</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AppButtonStyle.IconTonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="backgroundTint">@color/chocolate_soft</item>
        <item name="iconTint">@color/gold_luxury</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="AppButtonStyle.IconPrimary" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/gold_luxury</item>
        <item name="iconTint">@color/gold_luxury_dark_deep</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="AppButtonStyle.Success" parent="AppButtonStyle">
        <item name="backgroundTint">@color/success_luxury</item>
        <item name="android:textColor">@color/chocolate_dark_deep</item>
    </style>

    <style name="AppButtonStyle.Danger" parent="AppButtonStyle">
        <item name="backgroundTint">@color/error_luxury</item>
        <item name="android:textColor">@color/error_container_deep</item>
    </style>

    <style name="AppButtonStyle.Segmented" parent="Widget.Material3.Button.OutlinedButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/gold_luxury</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/gold_luxury</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="iconTint">@color/gold_luxury</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         ✅ Checkbox & Radio & Chip
         ═══════════════════════════════════════════════════════ -->
    <style name="AppRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:buttonTint">@color/selector_radio_tint_dark</item>
    </style>

    <style name="AppCheckBoxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:buttonTint">@color/selector_checkbox_tint_dark</item>
    </style>

    <style name="AppChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg_dark</item>
        <item name="android:textColor">@color/selector_chip_text_dark</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke_dark</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📑 Tab Style
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTabStyle" parent="Widget.Material3.TabLayout">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="tabIndicatorColor">@color/gold_luxury</item>
        <item name="tabTextColor">@color/selector_tab_text_dark</item>
        <item name="tabRippleColor">@color/state_layer_gold_pressed</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🏷️ Toolbar
         ═══════════════════════════════════════════════════════ -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:textColor">@color/text_light_primary</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎯 Bottom Navigation
         ═══════════════════════════════════════════════════════ -->
    <style name="CustomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/state_layer_gold_pressed</item>
        <item name="android:width">48dp</item>
        <item name="android:height">32dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         📝 Text Input
         ═══════════════════════════════════════════════════════ -->
    <style name="AppTextInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/gray_dark_warm</item>
        <item name="boxStrokeColor">@color/selector_text_input_stroke_dark</item>
        <item name="hintTextColor">@color/text_light_secondary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════
         🎴 Card View
         ═══════════════════════════════════════════════════════ -->
    <style name="AppCardViewStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/gray_dark_warm</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_dark_warm</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AppCardViewStyle.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/gray_dark_warm</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_dark_warm</item>
