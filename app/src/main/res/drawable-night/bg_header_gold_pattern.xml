<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- تدرج داكن فاخر -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A1A1A"
                android:centerColor="#22201E"
                android:endColor="#3D3529"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- لمعان ذهبي داكن في الزاوية -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:centerX="0.8"
                android:centerY="0.2"
                android:startColor="#33D4AF37" 
                android:endColor="#00D4AF37" />
        </shape>
    </item>
</layer-list>
