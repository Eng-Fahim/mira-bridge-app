<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- خلفية كربونية داكنة -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0C" />
        </shape>
    </item>
    
    <!-- تدرج خفيف من الأعلى -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1A1A1E"
                android:endColor="#0B0B0C"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
