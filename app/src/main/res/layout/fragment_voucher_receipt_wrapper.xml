<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFF8E1">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧾 معاينة السند"
            android:textColor="#B8860B"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- WebView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="420dp"
        android:background="@android:color/white">

        <WebView
            android:id="@+id/webVoucherReceipt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="420dp"/>

        <ProgressBar
            android:id="@+id/progressVoucherLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"/>
    </FrameLayout>

    <!-- Action Buttons -->
    <!-- Action Buttons Row 1 -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:paddingBottom="6dp"
    android:background="#F5F5F5"
    android:weightSum="3">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrintVoucher"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:text="🖨️ طباعة"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#B8860B"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareVoucher"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:text="📤 مشاركة"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#16A34A"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveVoucherPDF"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:text="💾 حفظ PDF"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#DC2626"/>
</LinearLayout>

<!-- ✅ Action Button Row 2: تفاصيل القيد -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:paddingTop="0dp"
    android:background="#F5F5F5">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewJournalDetail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="📊 عرض التفاصيل المحاسبية (القيد)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#1976D2"/>
</LinearLayout>
</LinearLayout>
