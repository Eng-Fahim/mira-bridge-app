<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="140dp"
    android:layout_marginEnd="12dp"
    android:id="@+id/karatCardRoot">

    <LinearLayout
        android:id="@+id/karatBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- الشارة (24K / 21K) -->
        <TextView
            android:id="@+id/tvChipKaratTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/bg_badge_karat"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="24K"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- الوزن -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvChipKaratWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450.00"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="جم"
                android:textColor="#E0FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- القيمة الإجمالية -->
        <TextView
            android:id="@+id/tvChipKaratValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginTop="12dp"
            android:text="29,025,000.00 YER"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.9" />
    </LinearLayout>
</FrameLayout>
