<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_h">

        <!-- ═══════════════════════════════════════════════════════
             العنوان الرئيسي
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/pwd_settings_title"
            android:textAppearance="@style/TextAppearance.App.Headline.Small"
            android:textColor="@color/text_gold_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_6"
            android:text="@string/pwd_settings_subtitle"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ═══════════════════════════════════════════════════════
             بطاقة وضع كلمة المرور
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3"
                    android:text="@string/pwd_mode_label"
                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                    android:textColor="?attr/colorOnSurface" />

                <RadioGroup
                    android:id="@+id/rgPasswordMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- الوضع 1: ثابتة -->
                    <RadioButton
                        android:id="@+id/rbModeStatic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/pwd_mode_static"
                        android:textAppearance="@style/TextAppearance.App.Body.Large" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_marginBottom="@dimen/space_2"
                        android:text="@string/pwd_mode_static_desc"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- الوضع 2: مشتقة من TID -->
                    <RadioButton
                        android:id="@+id/rbModeDerived"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/pwd_mode_derived"
                        android:textAppearance="@style/TextAppearance.App.Body.Large" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_marginBottom="@dimen/space_2"
                        android:text="@string/pwd_mode_derived_desc"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- الوضع 3: من السيرفر -->
                    <RadioButton
                        android:id="@+id/rbModeServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/pwd_mode_server"
                        android:textAppearance="@style/TextAppearance.App.Body.Large" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="@string/pwd_mode_server_desc"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════
             حقل كلمة المرور
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/AppTextInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:hint="@string/pwd_field_hint"
            app:endIconMode="password_toggle"
            app:helperText="@string/pwd_hint_8_hex">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789ABCDEFabcdef"
                android:fontFamily="monospace"
                android:inputType="textPassword"
                android:maxLength="8"
                android:textColor="?attr/colorOnSurface"
                android:textDirection="ltr" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══════════════════════════════════════════════════════
             الأزرار الرئيسية
             ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:orientation="horizontal">

            <!-- زر الحفظ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePassword"
                style="@style/AppButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:text="@string/pwd_save"
                app:icon="@android:drawable/ic_menu_save" />

            <!-- زر الاختبار -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestPassword"
                style="@style/AppButtonStyle.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/pwd_test_on_tag"
                app:icon="@android:drawable/ic_menu_search" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             بطاقة إدارة Salt (نسخ احتياطي)
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="@string/pwd_backup_title"
                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3"
                    android:text="@string/pwd_backup_desc"
                    android:textAppearance="@style/TextAppearance.App.Body.Small"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- زر التصدير -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportSalt"
                        style="@style/AppButtonStyle.Text"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_sm"
                        android:layout_marginEnd="@dimen/space_1"
                        android:layout_weight="1"
                        android:text="@string/pwd_export_salt"
                        app:icon="@android:drawable/ic_menu_upload" />

                    <!-- زر الاستيراد -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportSalt"
                        style="@style/AppButtonStyle.Text"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height_sm"
                        android:layout_marginStart="@dimen/space_1"
                        android:layout_weight="1"
                        android:text="@string/pwd_import_salt"
                        app:icon="@android:drawable/ic_menu_save" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════
             منطقة الخطر: إعادة تعيين
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetAll"
            style="@style/AppButtonStyle.Text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_sm"
            android:text="@string/pwd_reset_all"
            android:textColor="@color/danger_500"
            app:icon="@android:drawable/ic_menu_close_clear_cancel"
            app:iconTint="@color/danger_500" />
    </LinearLayout>
</ScrollView>
