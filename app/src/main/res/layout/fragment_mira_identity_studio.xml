<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_h">

        <!-- ═══════════════════════════════════════════════════════
             بطاقة الحالة والـ RFID
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <!-- رأس البطاقة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStepTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/step_title"
                        android:textAppearance="@style/TextAppearance.App.Title.Small"
                        android:textColor="@color/text_gold_accent" />

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_1"
                        android:text="@string/waiting"
                        android:textAppearance="@style/TextAppearance.App.Label.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- زر عرض المعلقة -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewPending"
                    style="@style/AppButtonStyle.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_sm"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/btn_view_pending"
                    app:icon="@android:drawable/ic_menu_upload" />

                <!-- حقل EPC -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEpc"
                    style="@style/AppTextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:hint="@string/hint_epc"
                    app:endIconDrawable="@android:drawable/ic_menu_camera"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
    android:id="@+id/etEpc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:inputType="textNoSuggestions|textVisiblePassword"
    android:imeOptions="actionDone"
    android:textColor="?attr/colorOnSurface"
    android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- معرفات مخفية (تُملأ برمجياً) -->
                <TextView
                    android:id="@+id/tvTidCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvGs1CodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- زر مسح RFID -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanRfid"
                    style="@style/AppButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/identity_scan_rfid" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════
             قسم التصنيف
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/classify_item"
            android:textAppearance="@style/TextAppearance.App.Title.Small"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_1"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRing"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/ring" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSet"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBracelet"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bracelet" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNecklace"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/necklace" />
        </com.google.android.material.chip.ChipGroup>

        <!-- حقل العنوان -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppTextInputStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:hint="@string/hint_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- اقتراحات أفقية -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSuggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_1"
                app:singleLine="true" />
        </HorizontalScrollView>

        <!-- ═══════════════════════════════════════════════════════
             قسم مواصفات المعدن
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/metal_specs"
            android:textAppearance="@style/TextAppearance.App.Title.Small"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/karat"
            android:textAppearance="@style/TextAppearance.App.Label.Medium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupKarat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_1"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip24K"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/karat_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip21K"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/karat_21" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip18K"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/karat_18" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip14K"
                style="@style/AppChipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/karat_14" />
        </com.google.android.material.chip.ChipGroup>

        <!-- بطاقة الوزن والقيمة -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/gross_weight_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGrossWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:textAppearance="@style/TextAppearance.App.Title.Large"
                        android:textColor="@color/text_gold_accent" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_3"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/estimated_gold_value"
                        android:textAppearance="@style/TextAppearance.App.Body.Medium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvEstimatedGoldValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:text="@string/identity_default_value"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="@color/text_gold_accent"
                        android:textDirection="ltr" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════════
             قسم الأحجار
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/stones_title"
            android:textAppearance="@style/TextAppearance.App.Title.Small"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutStonesContainer"
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/has_stones"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/toggle_stones_hint"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSummaryPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/text_gold_accent"
                    android:textDirection="ltr" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHasStones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- تفاصيل الأحجار -->
        <LinearLayout
            android:id="@+id/layoutStonesDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/stone_type_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStoneType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    android:hint="@string/stone_weight_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStoneWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTextInputStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_weight="1"
                    android:hint="@string/stone_count_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStoneCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="?attr/colorOnSurface" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/identity_stone_value_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStoneValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             قسم الصور
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:text="@string/photos_title"
            android:textAppearance="@style/TextAppearance.App.Title.Small"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPhotos"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_sm"
            android:text="@string/btn_add_photos"
            app:icon="@android:drawable/ic_menu_camera" />

        <TextView
            android:id="@+id/tvPhotosCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/no_photos"
            android:textAppearance="@style/TextAppearance.App.Body.Small"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPhotosPreview"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="@dimen/space_2"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- صور مخفية (تُملأ برمجياً) -->
        <ImageView
            android:id="@+id/imgGs1DataMatrix"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgMicroQr"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgFullGs1Matrix"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imgFullQrCode"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- ═══════════════════════════════════════════════════════
             زر الحفظ
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveIdentity"
            style="@style/AppButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_3"
            android:text="@string/btn_save_identity"
            app:icon="@android:drawable/ic_menu_save" />

        <TextView
            android:id="@+id/tvPendingSyncCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.Label.Medium"
            android:textColor="@color/text_gold_accent"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
