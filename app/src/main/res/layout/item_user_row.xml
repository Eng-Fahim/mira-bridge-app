<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_person_outline"
            android:tint="?attr/colorPrimary"
            android:background="@drawable/circle_primary_bg"
            android:padding="10dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRowDisplayName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="محمد أحمد"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/vStatusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/circle_green" />

                <TextView
                    android:id="@+id/tvRowStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نشط"
                    android:textColor="#FF22C55E"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRowUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@mohammed"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvRowRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مدير المخزون"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <!-- ✅ رقم الموظف -->
            <TextView
                android:id="@+id/tvRowEmployeeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪪 MA-001"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- ✅ الفرع -->
            <TextView
                android:id="@+id/tvRowBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏢 الفرع الرئيسي"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnRowEdit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/colorSurfaceVariant"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="تعديل"
                android:tint="?attr/colorPrimary"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnRowDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/colorSurfaceVariant"
                android:src="@android:drawable/ic_delete"
                android:contentDescription="حذف"
                android:tint="#FFEF4444" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
