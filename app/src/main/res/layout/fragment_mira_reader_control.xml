<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ لوحة التحكم بالقارئ"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="هذه الإعدادات تُطبَّق على كل شاشات MIRA تلقائياً"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <!-- ═══════════ Power Card ═══════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ قوة الإرسال"
                        android:textStyle="bold"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tvPowerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="27 dBm"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                </LinearLayout>
                <SeekBar
                    android:id="@+id/seekPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="33"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Radio Configuration Card ═══════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Frequency -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌍 Working Mode (التردد)"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <Spinner
                    android:id="@+id/spFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>

                <!-- ✅ RFLink (جديد) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔗 RFLink (Miller / Gen2X)"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <Spinner
                    android:id="@+id/spRfLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>

                <!-- Session -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Session"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <Spinner
                    android:id="@+id/spSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>

                <!-- Target -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Target"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <Spinner
                    android:id="@+id/spTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>

                <!-- Q Value -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔢 Q Value (StartQ)"
                    android:textStyle="bold"
                    android:textSize="14sp"/>
                <Spinner
                    android:id="@+id/spQValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Advanced Features Card ═══════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFastId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚀 FastID"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swTagFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 TagFocus"
                    android:layout_marginBottom="8dp"/>

                <!-- ✅ Fast Inventory (كان Dynamic Power) -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFastInventory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Fast Inventory"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        
        <!-- ═══════════ 📡 Live Test Card ═══════════ -->
<com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 اختبار القراءة المباشر"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اضبط الإعدادات، ثم اختبرها هنا قبل الاستخدام"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="12dp"/>

        <!-- Stats 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="?attr/colorSurfaceVariant"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 القراءات"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <TextView
                    android:id="@+id/tvLiveReadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="?attr/colorSurfaceVariant"
                android:layout_marginStart="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ المعدل"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <TextView
                    android:id="@+id/tvLiveRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/s"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Last EPC -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 آخر EPC:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLiveLastEpc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <!-- RSSI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 RSSI: "
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvLiveRssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— dBm"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLiveTestToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="▶️ ابدأ اختبار القراءة"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ قرّب وسم ذهبي من القارئ لرؤية النتائج مباشرة"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:padding="8dp"
            android:background="?attr/colorSurfaceVariant"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

        <!-- ═══════════ Summary Card ═══════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/tvSettingsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurface"/>
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/readerLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- ═══════════ Buttons ═══════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✅ تطبيق على القارئ الآن"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReadCurrent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📖 قراءة الحالة الحالية من العتاد"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefaults"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 إعادة تعيين الافتراضيات"
            android:textColor="?attr/colorError"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
