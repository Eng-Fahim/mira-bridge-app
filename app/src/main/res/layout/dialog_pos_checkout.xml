<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0B0F17"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- العنوان -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳 تأكيد عملية البيع"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- العميل -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 معلومات العميل"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etCustomerName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="اسم العميل"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_dark_input"
            android:paddingHorizontal="12dp"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="رقم الهاتف"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_dark_input"
            android:paddingHorizontal="12dp"
            android:inputType="phone"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- الدفع -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳 طريقة الدفع"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_dark_input"
            android:layout_marginBottom="16dp" />

        <!-- الخصم والمبلغ النهائي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الخصم:"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etDiscount"
                android:layout_width="65dp"
                android:layout_height="38dp"
                android:hint="0"
                android:textColorHint="#64748B"
                android:textColor="#FACE15"
                android:background="@drawable/bg_dark_input"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:textSize="13sp"
                android:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginStart="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvFinalTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#FACE15"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- أزرار الإجراءات (تأكيد / إلغاء) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelCheckout"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dark_input"
                android:text="إلغاء"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnConfirmCheckout"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.5"
                android:background="@drawable/bg_blue_btn"
                android:text="تأكيد البيع والحسم"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
