<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <com.google.android.material.card.MaterialCardView
        style="@style/AppCardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الدفع"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseDialog"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Total Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الإجمالي المطلوب"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvFinalTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 YER"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textDirection="ltr" />
                        
                    <TextView
                        android:id="@+id/tvItemCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 قطعة"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="4dp" />
                        
                    <!-- Hidden fields for compatibility -->
                    <TextView android:id="@+id/tvSubtotal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvDiscountAmount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/tvAccountNumber" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Payments Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="المدفوعات"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTradeIn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="دفع بالذهب"
                    android:textSize="12sp"
                    app:icon="@android:drawable/ic_menu_add"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPayment"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ إضافة دفعة"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dynamic Payment Container -->
            <LinearLayout
                android:id="@+id/llPaymentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Trade-In Summary -->
            <LinearLayout
                android:id="@+id/llTradeInSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/colorSecondaryContainer"
                android:padding="10dp"
                android:layout_marginVertical="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+ ذهب مُستلم:"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/tvTradeInTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 YER"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textDirection="ltr" />
            </LinearLayout>

            <!-- Status Banner (Shortage/Excess) -->
            <LinearLayout
                android:id="@+id/llStatusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FEE2E2"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvStatusIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="مبلغ ناقص"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#B91C1C" />

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 YER"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#B91C1C"
                    android:textDirection="ltr" />
            </LinearLayout>

            <!-- Customer Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomerName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="اسم العميل (اختياري)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomerPhone"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="رقم الهاتف">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Hidden fields for compatibility -->
            <EditText android:id="@+id/etSimpleAmount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/etDiscount" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/etCustomerEmail" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/etCustomerAddress" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/etCustomerNotes" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/llDiscountToggle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/llDiscountFields" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tvDiscountArrow" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/llCustomerToggle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/llCustomerFields" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tvCustomerArrow" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnTabCash" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnTabGold" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilPaymentMethod" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"><com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/spPaymentMethod" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelCheckout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="إلغاء" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmCheckout"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:text="تأكيد الدفع" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
