<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <com.google.android.material.card.MaterialCardView
        style="@style/AppCardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <!-- ═══════════════════════════════════════════════════════
                 عنوان النافذة
                 ═══════════════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:gravity="center"
                android:text="إتمام عملية البيع"
                android:textAppearance="@style/TextAppearance.App.Title.Large"
                android:textColor="@color/text_gold_accent" />

            <!-- ═══════════════════════════════════════════════════════
                 بطاقة ملخص الفاتورة
                 ═══════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_3">

                    <!-- عدد القطع -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="عدد القطع:"
                            android:textAppearance="@style/TextAppearance.App.Body.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvItemCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 قطعة"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- الإجمالي الفرعي -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="الإجمالي الفرعي:"
                            android:textAppearance="@style/TextAppearance.App.Body.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 YER"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnSurface"
                            android:textDirection="ltr" />
                    </LinearLayout>

                    <!-- قيمة الخصم -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="قيمة الخصم:"
                            android:textAppearance="@style/TextAppearance.App.Body.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvDiscountAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 YER"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="@color/danger_500"
                            android:textDirection="ltr" />
                    </LinearLayout>

                    <!-- فاصل -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_2"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- المبلغ الصافي -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="المبلغ الصافي:"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvFinalTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 YER"
                            android:textAppearance="@style/TextAppearance.App.Headline.Small"
                            android:textColor="@color/text_gold_accent"
                            android:textDirection="ltr" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════════════
                 قسم بيانات العميل
                 ═══════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="👤 بيانات العميل"
                android:textAppearance="@style/TextAppearance.App.Title.Small"
                android:textColor="@color/text_gold_accent" />

            <!-- اسم العميل (إلزامي) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomerName"
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="اسم العميل *"
                    android:inputType="textPersonName"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- رقم الهاتف (إلزامي) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCustomerPhone"
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="رقم الهاتف *"
                    android:inputType="phone"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- البريد الإلكتروني (اختياري) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomerEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="البريد الإلكتروني (اختياري)"
                    android:inputType="textEmailAddress"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- العنوان (اختياري) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="العنوان (اختياري)"
                    android:inputType="text"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ملاحظات (اختياري) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomerNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ملاحظات (اختياري)"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:minLines="2"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ═══════════════════════════════════════════════════════
                 قسم طريقة الدفع والخصم
                 ═══════════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="💳 طريقة الدفع والخصم"
                android:textAppearance="@style/TextAppearance.App.Title.Small"
                android:textColor="@color/text_gold_accent" />

            <!-- قائمة اختيار طريقة الدفع -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPaymentMethod"
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:hint="طريقة الدفع"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- رقم الحساب (يظهر شرطياً) -->
            <TextView
                android:id="@+id/tvAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:gravity="center"
                android:text=""
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- نسبة الخصم -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/AppTextInputStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:hint="نسبة الخصم"
                app:suffixText="%">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ═══════════════════════════════════════════════════════
                 ✅ قسم الدفع المتعدد (جديد)
                 ═══════════════════════════════════════════════════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/space_3"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:text="💵 تفاصيل الدفع"
                android:textAppearance="@style/TextAppearance.App.Title.Small"
                android:textColor="@color/text_gold_accent" />

            <!-- حاوية سطور الدفع (يتم تعبئتها برمجياً) -->
            <LinearLayout
                android:id="@+id/llPaymentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- زر إضافة عملة أخرى -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPayment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:layout_marginBottom="@dimen/space_2"
                android:text="+ إضافة عملة أخرى"
                android:textColor="?attr/colorPrimary" />

            <!-- شريط المتبقي للعميل -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                android:background="?attr/colorSurfaceVariant"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3"
                app:cardCornerRadius="@dimen/radius_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="المتبقي للعميل:"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 YER"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/danger_500"
                    android:textDirection="ltr"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════
                 أزرار الإجراء
                 ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelCheckout"
                    style="@style/AppButtonStyle.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/space_2"
                    android:layout_weight="1"
                    android:text="إلغاء"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:strokeColor="?attr/colorOutline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmCheckout"
                    style="@style/AppButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="2"
                    android:text="تأكيد البيع ✓" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
