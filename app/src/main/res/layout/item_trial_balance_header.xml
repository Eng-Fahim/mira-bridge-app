<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#F1F5F9"
    android:paddingVertical="10dp">

    <TextView
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:text="الكود"
        android:textStyle="bold"
        android:textSize="12sp"
        android:gravity="center" />

    <TextView
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="wrap_content"
        android:text="الحساب"
        android:textStyle="bold"
        android:textSize="12sp"
        android:paddingStart="8dp" />

    <!-- عناوين أول المدة -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أول المدة"
            android:textStyle="bold"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="مدين" android:textSize="10sp" android:gravity="center"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="دائن" android:textSize="10sp" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- عناوين حركة الفترة -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حركة الفترة"
            android:textStyle="bold"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="مدين" android:textSize="10sp" android:gravity="center"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="دائن" android:textSize="10sp" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- عناوين آخر المدة -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="آخر المدة"
            android:textStyle="bold"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="مدين" android:textSize="10sp" android:gravity="center"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="دائن" android:textSize="10sp" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
