<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ═══════════════════════════════════════════════════════
         APP BAR
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding_h"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_2">

            <!-- عنوان الشاشة -->
            <TextView
                android:id="@+id/tvReportsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التقارير والإحصائيات"
                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- الفرع -->
            <TextView
                android:id="@+id/tvBranchInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="الفرع الرئيسي"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="@color/text_gold_accent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReportsTitle" />

            <!-- أزرار التحكم السريعة -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchReports"
                    style="@style/AppButtonStyle.IconTonal"
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:contentDescription="Search reports"
                    app:icon="@android:drawable/ic_menu_search"
                    app:iconSize="@dimen/icon_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterReports"
                    style="@style/AppButtonStyle.IconTonal"
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:layout_marginStart="@dimen/space_2"
                    android:contentDescription="Filter reports"
                    app:icon="@android:drawable/ic_menu_manage"
                    app:iconSize="@dimen/icon_md" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- تبويبات الفلترة -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabReportCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/text_gold_accent"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/text_gold_accent"
            app:tabTextColor="?attr/colorOnSurfaceVariant" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════════
         شبكة التقارير
         ═══════════════════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshReports"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReportsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="100dp"
            tools:listitem="@layout/item_report_card_pro" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ═══════════════════════════════════════════════════════
         زر التصدير العائم
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabQuickExport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginBottom="90dp"
        android:text="تصدير"
        app:backgroundTint="@color/md_primary"
        app:icon="@android:drawable/ic_menu_share"
        app:iconTint="@color/md_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
