<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- قوالب الصلاحيات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spinnerTemplates"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/btnApplyTemplate"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="?attr/colorPrimary"
                android:text="تطبيق"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>

        <!-- عنوان الصلاحيات -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="الصلاحيات المتاحة:"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- صلاحيات المخزون -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📦 المخزون"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbViewInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عرض المخزون"
            android:textColor="?attr/colorOnSurface" />

        <CheckBox
            android:id="@+id/cbEditInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعديل المخزون"
            android:textColor="?attr/colorOnSurface" />

        <!-- صلاحيات التقارير -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="📊 التقارير"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbViewReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عرض التقارير"
            android:textColor="?attr/colorOnSurface" />

        <CheckBox
            android:id="@+id/cbExportData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تصدير البيانات"
            android:textColor="?attr/colorOnSurface" />

        <!-- صلاحيات الإدارة -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="👥 الإدارة"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbManageUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إدارة المستخدمين"
            android:textColor="?attr/colorOnSurface" />

        <CheckBox
            android:id="@+id/cbApproveTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الموافقة على المعاملات"
            android:textColor="?attr/colorOnSurface" />

        <!-- صلاحيات النظام -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="⚙️ النظام"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbViewAuditLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عرض سجل التدقيق"
            android:textColor="?attr/colorOnSurface" />

        <CheckBox
            android:id="@+id/cbAccessSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الوصول إلى الإعدادات"
            android:textColor="?attr/colorOnSurface" />

        <!-- أزرار الحفظ والإلغاء -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelPermissions"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="إلغاء"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/btnSavePermissions"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:text="حفظ الصلاحيات"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>

        <!-- Loading Overlay -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/colorSurface"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="جاري الحفظ..."
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
