<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9FAFB"
    android:layoutDirection="rtl"
    android:id="@+id/rootLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#D4AF37">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MIRA RFID Inventory"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBranchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Branch"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutReaderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvReaderStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reader: Checking..."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#16A34A" />

        <Button
            android:id="@+id/btnScanCamera"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Camera"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#8B5CF6"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnHelpGuide"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="?"
            android:textSize="16sp"
            android:backgroundTint="#F59E0B"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutZoneSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone:"
            android:textSize="13sp"
            android:textColor="#4B5563"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spinnerZone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#F3F4F6" />

        <Button
            android:id="@+id/btnSelectZone"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Select"
            android:textSize="12sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#D4AF37"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#F3F4F6"
        android:weightSum="4">

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvTotalScanned" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="#111827" />
            <TextView android:text="Scans" android:textSize="10sp" android:textColor="#4B5563" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvUniqueTags" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="#D4AF37" />
            <TextView android:text="Unique" android:textSize="10sp" android:textColor="#4B5563" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvScanRate" android:text="0/s" android:textSize="22sp" android:textStyle="bold" android:textColor="#16A34A" />
            <TextView android:text="Rate" android:textSize="10sp" android:textColor="#4B5563" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvElapsed" android:text="00:00" android:textSize="22sp" android:textStyle="bold" android:textColor="#111827" />
            <TextView android:text="Time" android:textSize="10sp" android:textColor="#4B5563" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:weightSum="4">

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvExpectedTotal" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#111827" />
            <TextView android:text="Expected" android:textSize="9sp" android:textColor="#4B5563" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvFoundCount" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#16A34A" />
            <TextView android:text="Found" android:textSize="9sp" android:textColor="#4B5563" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvMissingCount" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#DC2626" />
            <TextView android:text="Missing" android:textSize="9sp" android:textColor="#4B5563" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/tvUnexpectedCount" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="#F59E0B" />
            <TextView android:text="Extra" android:textSize="9sp" android:textColor="#4B5563" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvReconciliationResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:text="Awaiting inventory start..."
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:background="#FFFFFF" />

    <ProgressBar
        android:id="@+id/pbScanProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cardLastTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLastTagTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Awaiting scan..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvLastTagStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="22sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLastTagEPC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="11sp"
            android:textColor="#9CA3AF"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView android:id="@+id/tvLastTagKarat" android:text="-"
                android:textSize="12sp" android:textColor="#D4AF37" android:textStyle="bold" />
            <TextView android:text=" . " android:textColor="#9CA3AF" android:textSize="12sp" />
            <TextView android:id="@+id/tvLastTagWeight" android:text="-"
                android:textSize="12sp" android:textColor="#4B5563" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFilterTabs"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:visibility="gone">

        <TextView
            android:id="@+id/tabFilterAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#D4AF37"
            android:background="#FDF8E7" />

        <TextView
            android:id="@+id/tabFilterFound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Found"
            android:textSize="12sp"
            android:textColor="#4B5563" />

        <TextView
            android:id="@+id/tabFilterMissing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Missing"
            android:textSize="12sp"
            android:textColor="#4B5563" />

        <TextView
            android:id="@+id/tabFilterUnexpected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Extra"
            android:textSize="12sp"
            android:textColor="#4B5563" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <Button android:id="@+id/btnStartInventory"
            android:text="Start"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginEnd="2dp" android:textSize="12sp" android:textStyle="bold"
            android:backgroundTint="#D4AF37" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btnPauseInventory"
            android:text="Pause"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginHorizontal="2dp" android:textSize="12sp" android:textStyle="bold"
            android:backgroundTint="#F59E0B" android:textColor="#FFFFFF" android:visibility="gone" />

        <Button android:id="@+id/btnStopInventory"
            android:text="Stop"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginHorizontal="2dp" android:textSize="12sp" android:textStyle="bold"
            android:enabled="false"
            android:backgroundTint="#DC2626" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btnClearInventory"
            android:text="Clear"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginHorizontal="2dp" android:textSize="12sp"
            android:enabled="false"
            android:backgroundTint="#94A3B8" android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp">

        <Button android:id="@+id/btnExportInventory"
            android:text="Export"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginEnd="2dp" android:textSize="12sp"
            android:backgroundTint="#16A34A" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btnExportMissing"
            android:text="Missing"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginHorizontal="2dp" android:textSize="12sp"
            android:backgroundTint="#DC2626" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btnScreenshot"
            android:text="SS"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:layout_marginStart="2dp" android:textSize="12sp"
            android:backgroundTint="#8B5CF6" android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFinalizeAudit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Finalize Audit"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="2dp"
        android:visibility="gone"
        android:backgroundTint="#16A34A"
        android:textColor="#FFFFFF" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentTags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false" />

</LinearLayout>
