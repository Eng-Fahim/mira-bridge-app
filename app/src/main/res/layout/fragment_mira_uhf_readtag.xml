<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="?attr/colorPrimary">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📡 جرد MIRA RFID"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBranchName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 الفرع"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:alpha="0.85" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/colorSurfaceVariant"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/tvTotalScanned" android:text="0"
                android:textSize="24sp" android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
            <TextView android:text="المسوحات" android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/tvUniqueTags" android:text="0"
                android:textSize="24sp" android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />
            <TextView android:text="فريدة" android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/tvScanRate" android:text="0/s"
                android:textSize="24sp" android:textStyle="bold"
                android:textColor="#22C55E" />
            <TextView android:text="معدل" android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:id="@+id/tvElapsed" android:text="00:00"
                android:textSize="24sp" android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
            <TextView android:text="الوقت" android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbScanProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="?attr/colorPrimary" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLastTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutline">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="القطعة الحالية"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastTagEPC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLastTagTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="في انتظار المسح..."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvLastTagStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚪"
                    android:textSize="24sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView android:id="@+id/tvLastTagKarat" android:text="—"
                    android:textSize="13sp" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
                <TextView android:text="  •  " android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                <TextView android:id="@+id/tvLastTagWeight" android:text="—"
                    android:textSize="13sp" android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <Button android:id="@+id/btnStartInventory"
            android:text="▶ بدء"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginEnd="2dp" android:textSize="13sp" android:textStyle="bold"
            android:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" />

        <Button android:id="@+id/btnStopInventory"
            android:text="⏹ إيقاف"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:textSize="13sp" android:textStyle="bold"
            android:enabled="false"
            android:backgroundTint="#DC2626" android:textColor="#FFFFFF" />

        <Button android:id="@+id/btnClearInventory"
            android:text="🗑️ مسح"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginHorizontal="2dp" android:textSize="13sp"
            android:enabled="false"
            android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?attr/colorOnSurface" />

        <Button android:id="@+id/btnExportInventory"
            android:text="📤 تصدير"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:layout_marginStart="2dp" android:textSize="13sp"
            android:backgroundTint="#16A34A" android:textColor="#FFFFFF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentTags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
