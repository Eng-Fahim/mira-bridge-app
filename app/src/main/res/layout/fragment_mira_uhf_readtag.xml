<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tvBranchName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 الفرع"
        android:textSize="16sp"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvTotalScanned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="24sp"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvUniqueTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvScanRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0/s"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvElapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvLastTagEPC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvLastTagTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Awaiting scan..."
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvLastTagKarat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvLastTagWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvLastTagStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚪"
        android:padding="16dp"/>

    <ProgressBar
        android:id="@+id/pbScanProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLastTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CARD"
            android:padding="16dp"/>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnStartInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start"/>

    <Button
        android:id="@+id/btnStopInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop"/>

    <Button
        android:id="@+id/btnClearInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear"/>

    <Button
        android:id="@+id/btnExportInventory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentTags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
