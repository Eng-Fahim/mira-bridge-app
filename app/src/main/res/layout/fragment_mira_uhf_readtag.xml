<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/app_title_inventory"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBranchName"
            android:text="@string/branch_label"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:alpha="0.85" />
    </LinearLayout>

    <!-- Metrics Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/colorSurfaceVariant"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView 
                android:id="@+id/tvTotalScanned" 
                android:text="0"
                android:textSize="24sp" 
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
            <TextView 
                android:text="@string/metric_total_scans" 
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView 
                android:id="@+id/tvUniqueTags" 
                android:text="0"
                android:textSize="24sp" 
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />
            <TextView 
                android:text="@string/metric_unique_tags" 
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView 
                android:id="@+id/tvScanRate" 
                android:text="0/s"
                android:textSize="24sp" 
                android:textStyle="bold"
                android:textColor="@color/status_online" />
            <TextView 
                android:text="@string/metric_scan_rate" 
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView 
                android:id="@+id/tvElapsed" 
                android:text="00:00"
                android:textSize="24sp" 
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
            <TextView 
                android:text="@string/metric_time" 
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbScanProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="?attr/colorPrimary" />

    <!-- Current Tag Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLastTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:text="@string/current_tag_header"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastTagEPC"
                android:text="—"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLastTagTitle"
                    android:text="@string/awaiting_scan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvLastTagStatus"
                    android:text="⚪"
                    android:textSize="24sp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView 
                    android:id="@+id/tvLastTagKarat" 
                    android:text="—"
                    android:textSize="13sp" 
                    android:textColor="?attr/colorPrimary" 
                    android:textStyle="bold" />
                <TextView 
                    android:text="  •  " 
                    android:textColor="?attr/colorOnSurfaceVariant" 
                    android:textSize="13sp" />
                <TextView 
                    android:id="@+id/tvLastTagWeight" 
                    android:text="—"
                    android:textSize="13sp" 
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnStartInventory"
            android:text="@string/btn_start_inventory"
            android:layout_width="0dp" 
            android:layout_weight="1" 
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp" 
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary" 
            android:textColor="?attr/colorOnPrimary" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnStopInventory"
            android:text="@string/btn_stop_inventory"
            android:layout_width="0dp" 
            android:layout_weight="1" 
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp" 
            android:textStyle="bold"
            android:enabled="false" 
            app:backgroundTint="@color/status_offline" 
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnClearInventory"
            android:text="@string/btn_clear_inventory"
            android:layout_width="0dp" 
            android:layout_weight="1" 
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp"
            android:enabled="false"
            app:backgroundTint="?attr/colorOutlineVariant" 
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnExportInventory"
            android:text="@string/btn_export_inventory"
            android:layout_width="0dp" 
            android:layout_weight="1" 
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp"
            app:backgroundTint="@color/status_online" 
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Recent Tags List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentTags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
