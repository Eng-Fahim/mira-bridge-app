<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A237E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="📡 جرد MIRA RFID"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBranchName"
            android:text="📍 الفرع"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.85" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F1F5F9"
        android:weightSum="4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTotalScanned"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />
            <TextView
                android:text="المسوحات"
                android:textSize="10sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvUniqueTags"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A237E" />
            <TextView
                android:text="فريدة"
                android:textSize="10sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvScanRate"
                android:text="0/s"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#16A34A" />
            <TextView
                android:text="معدل"
                android:textSize="10sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvElapsed"
                android:text="00:00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />
            <TextView
                android:text="الوقت"
                android:textSize="10sp"
                android:textColor="#64748B" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbScanProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateTint="#1A237E" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLastTag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:text="القطعة الحالية"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastTagEPC"
                android:text="—"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#94A3B8"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvLastTagTitle"
                    android:text="في انتظار المسح..."
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvLastTagStatus"
                    android:text="⚪"
                    android:textSize="24sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvLastTagKarat"
                    android:text="—"
                    android:textSize="13sp"
                    android:textColor="#1A237E"
                    android:textStyle="bold" />
                <TextView
                    android:text="  •  "
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvLastTagWeight"
                    android:text="—"
                    android:textSize="13sp"
                    android:textColor="#475569" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <Button
            android:id="@+id/btnStartInventory"
            android:text="▶ بدء الجرد"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#1A237E"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnStopInventory"
            android:text="⏹ إيقاف"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:enabled="false"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnClearInventory"
            android:text="🗑️ مسح"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp"
            android:enabled="false"
            android:backgroundTint="#94A3B8"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExportInventory"
            android:text="📤 تصدير"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:textSize="13sp"
            android:backgroundTint="#16A34A"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentTags"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
