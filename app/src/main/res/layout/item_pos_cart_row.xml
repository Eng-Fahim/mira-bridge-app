<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppCardViewStyle.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_3">

        <!-- ═══════════════════════════════════════════════════════
             معلومات القطعة (يسار)
             ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- عنوان القطعة -->
            <TextView
                android:id="@+id/tvRowItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Label.Large"
                android:textColor="?attr/colorOnSurface"
                tools:text="خاتم ذهب 21K" />

            <!-- EPC -->
            <TextView
                android:id="@+id/tvRowItemEpc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr"
                tools:text="EPC: 070045537109" />

            <!-- العيار + الوزن + الحالة -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRowItemKaratWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="21K | 5.20g" />

                <TextView
                    android:id="@+id/tvRowItemStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                    android:textColor="@color/text_gold_accent"
                    tools:text="✅ متاحة" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             السعر (يمين)
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvRowItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.App.Title.Small"
            android:textColor="@color/text_gold_accent"
            android:textDirection="ltr"
            tools:text="$350.00" />

        <!-- ═══════════════════════════════════════════════════════
             زر الحذف
             ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRowRemove"
            style="@style/AppButtonStyle.Text"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:contentDescription="@string/pos_remove_item"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="?attr/colorError"
            android:textSize="16sp"
            app:cornerRadius="@dimen/radius_full"
            app:iconTint="?attr/colorError"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
