<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ==================== معلومات القطعة (يسار) ==================== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- عنوان القطعة -->
            <TextView
                android:id="@+id/tvRowItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="خاتم ذهب 21K" />

            <!-- EPC -->
            <TextView
                android:id="@+id/tvRowItemEpc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr"
                android:textSize="11sp"
                tools:text="EPC: 070045537109" />

            <!-- العيار + الوزن + الحالة -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRowItemKaratWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="21K | 5.20g" />

                <TextView
                    android:id="@+id/tvRowItemStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="✅ متاحة" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== السعر (يمين) ==================== -->
        <TextView
            android:id="@+id/tvRowItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="$350.00" />

        <!-- ==================== زر الحذف (أقصى اليمين) ==================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRowRemove"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textColor="?attr/colorError"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="@string/pos_remove_item"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:cornerRadius="20dp"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
