<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAuditSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="توقيع المستلم:"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <!-- لوحة التوقيع الرقمي -->
    <com.example.uhf.view.SignatureView
        android:id="@+id/signatureView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#F5F5F5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnClearSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مسح التوقيع"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmReceipt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تأكيد الاستلام" />
    </LinearLayout>

</LinearLayout>
