<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- أيقونة الفرع -->
        <ImageView
            android:id="@+id/ivBranchIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_branch"
            android:tint="?attr/colorPrimary"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_primary_bg"
            android:padding="8dp" />

        <!-- معلومات الفرع -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفرع الرئيسي"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBranchInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MAIN-001 • صنعاء"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/vBranchStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_green"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvBranchStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نشط • 245 قطعة"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- علامة الاختيار -->
        <ImageView
            android:id="@+id/ivBranchSelected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_help"
            android:tint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
