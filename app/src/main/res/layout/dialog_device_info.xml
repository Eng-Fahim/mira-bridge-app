<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mira_dialog"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <!-- العنوان الرئيسي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info"
            app:tint="@color/text_gold_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:text="معلومات الجهاز و UHF"
            android:textAppearance="@style/TextAppearance.App.Title.Large"
            android:textColor="@color/text_gold_accent" />
    </LinearLayout>

    <!-- قسم بيئة التشغيل -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📱 بيئة التشغيل"
        android:textAppearance="@style/TextAppearance.App.Label.Medium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_4"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <TextView
            android:id="@+id/tv_device_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الموديل: SM-S908U"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurface"
            android:textDirection="ltr" />

        <TextView
            android:id="@+id/tv_device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="الحالة: متصل عبر Bluetooth / Serial"
            android:textAppearance="@style/TextAppearance.App.Body.Small"
            android:textColor="@color/success_500" />
    </LinearLayout>

    <!-- قسم قارئ RFID / UHF -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 قارئ RFID / UHF"
        android:textAppearance="@style/TextAppearance.App.Label.Medium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_5"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <TextView
            android:id="@+id/tv_uhf_software"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="البرمجيات (Software): v2.4.1"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurface"
            android:textDirection="ltr" />

        <TextView
            android:id="@+id/tv_uhf_hardware"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="العتاد (Hardware): Chainway C72 Module"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurface"
            android:textDirection="ltr" />
    </LinearLayout>

    <!-- زر الإغلاق -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_dialog"
        style="@style/AppButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="إغلاق" />
</LinearLayout>
