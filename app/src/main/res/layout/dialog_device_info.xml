<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_mira_dialog">

    <!-- العنوان مع أيقونة الهاتف/الملاحة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_info"
            app:tint="#D4AF37" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/cairo"
            android:text="معلومات الجهاز و UHF"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- قسم بيانات الهاتف -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo"
        android:text="📱 بيئة التشغيل"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="#2C2C2E"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_device_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:text="الموديل: SM-S908U"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/cairo"
            android:text="الحالة: متصل عبر Bluetooth / Serial"
            android:textColor="#34C759"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- قسم وحدة RFID / UHF -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo"
        android:text="📡 قارئ RFID / UHF"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp"
        android:background="#2C2C2E"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_uhf_software"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo"
            android:text="البرمجيات (Software): v2.4.1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_uhf_hardware"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/cairo"
            android:text="العتاد (Hardware): Chainway C72 Module"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- زر الإغلاق -->
    <Button
        android:id="@+id/btn_close_dialog"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#D4AF37"
        android:fontFamily="@font/cairo"
        android:text="إغلاق"
        android:textColor="#1C1C1E"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
