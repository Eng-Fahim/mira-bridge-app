<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quickActionsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- ═══ DRAG HANDLE (مقبض السحب المحسن) ═══ -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.5"
        android:background="?attr/colorOnSurfaceVariant" />

    <!-- ═══ PRIMARY CTA (Identity Studio) ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIdentityStudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_identity_studio"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qa_identity_studio"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="استوديو التكويد" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/qa_identity_studio_desc"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="ابدأ بتكويد قطعة جديدة" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_forward"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ DIVIDER ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:alpha="0.3"
        android:background="?attr/colorOutlineVariant" />

    <!-- ═══ SCROLL VIEW (ديناميكي لا يترك فراغات) ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- ═══ GRID ═══ -->
            <GridLayout
                android:id="@+id/qaGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:paddingHorizontal="16dp"
                android:useDefaultMargins="false">

                <!-- ROW 1 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardRfidWrite" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_rfid_write" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="RFID" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardRadarLocation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_radar" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="رادار" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardRfidBindings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_rfid_bindings" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="شرائح" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardSecureGate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_security_gate" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="بوابات" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ROW 2 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardReports" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_reports" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="تقارير" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardAccounting" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_accounting" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="مالية" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardVouchers" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_accounting" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="سندات" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardTransfer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_transfer" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="تحويلات" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ROW 3 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardSalesHistory" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_sales_history" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="مبيعات" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardGoldConversion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_gold_scrap" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="أمر صياغة" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardGoldRates" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_gold_scrap" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="أسعار الذهب" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardScrapBuy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_gold_scrap" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="شراء كسر" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ROW 4 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardScrapHistory" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_sales_history" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="سجل الكسر" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardScrapBatches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_inventory_items" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="دفعات الكسر" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardScrapAging" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_reports" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="أعمار الكسر" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardParties" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_users" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="عملاء وموردين" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ROW 5 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardCashReconciliation" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_accounting" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="تقفيل الخزينة" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardAdminHub" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_admin_hub" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="إداري" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardServerConfig" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_server" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="سيرفر" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardAdminUsers" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_users" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="مستخدمين" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ROW 6 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardAdminBranches" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_branches" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="فروع" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardReaderSetup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_server" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="إعداد القارئ" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuickAccess" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_settings" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="تخصيص الوصول" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardAuditLogs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_reports" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="سجل التدقيق" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ROW 7 -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/cardPurchaseInvoice" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="?attr/colorSurface" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingVertical="16dp">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_inventory_items" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="فاتورة مشتريات" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ═══ License Status Card ═══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLicenseStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A237E"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="#FFD700" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="حالة الترخيص"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="عرض تفاصيل ترخيص MIRA ID"
                            android:textColor="#B3C5FF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══ CLOSE BUTTON (زر إغلاق محسن) ═══ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="32dp"
        android:text="@string/qa_close"
        android:textColor="?attr/colorPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="24dp" />

</LinearLayout>
