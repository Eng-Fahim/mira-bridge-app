<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <!-- ═══════════════════════════════════════════════════════
         DRAG HANDLE
         ═══════════════════════════════════════════════════════ -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6" />

    <!-- ═══════════════════════════════════════════════════════
         TITLE
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/qa_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="إجراءات سريعة" />

    <!-- ═══════════════════════════════════════════════════════
         GROUP 1 — الأجهزة والتكويد
         ═══════════════════════════════════════════════════════ -->

    <!-- RFID Write -->
    <LinearLayout
        android:id="@+id/cardRfidWrite"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_rfid_write"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_rfid_write"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="برمجة RFID" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Identity Studio -->
    <LinearLayout
        android:id="@+id/cardIdentityStudio"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_identity_studio"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_identity_studio"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="استوديو التكويد" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Radar Location -->
    <LinearLayout
        android:id="@+id/cardRadarLocation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_radar"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_radar"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="رادار التتبع" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- RFID Bindings -->
    <LinearLayout
        android:id="@+id/cardRfidBindings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_rfid_bindings"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_rfid_bindings"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="إدارة الشرائح" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         DIVIDER 1
         ═══════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.5" />

    <!-- ═══════════════════════════════════════════════════════
         GROUP 2 — العمليات والمالية
         ═══════════════════════════════════════════════════════ -->

    <!-- Reports -->
    <LinearLayout
        android:id="@+id/cardReports"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_reports"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_reports"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="التقارير" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Accounting -->
    <LinearLayout
        android:id="@+id/cardAccounting"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_accounting"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_accounting"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="المالية" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Transfers -->
    <LinearLayout
        android:id="@+id/cardTransfer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_transfer"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_transfers"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="التحويلات" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Sales History -->
    <LinearLayout
        android:id="@+id/cardSalesHistory"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sales_history"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_sales_history"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="سجل المبيعات" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         DIVIDER 2
         ═══════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.5" />

    <!-- ═══════════════════════════════════════════════════════
         GROUP 3 — الإدارة والبوابات
         ═══════════════════════════════════════════════════════ -->

    <!-- Secure Gate -->
    <LinearLayout
        android:id="@+id/cardSecureGate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_security_gate"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_secure_gate"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="مراقبة البوابات" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Admin Hub -->
    <LinearLayout
        android:id="@+id/cardAdminHub"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_admin_hub"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_admin_hub"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="الخيارات الإدارية" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Server Config -->
    <LinearLayout
        android:id="@+id/cardServerConfig"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_server"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/qa_server_config"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="إعدادات السيرفر" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         DIVIDER 3
         ═══════════════════════════════════════════════════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.5" />

    <!-- ═══════════════════════════════════════════════════════
         CLOSE BUTTON
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="@string/qa_close"
        android:textColor="?attr/colorPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="إغلاق" />

</LinearLayout>
