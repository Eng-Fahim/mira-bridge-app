<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- شريط التاريخ والنوع -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant">

        <Button
            android:id="@+id/btnPickDateAging"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="📅 التاريخ"
            android:textSize="12sp"/>

        <Spinner
            android:id="@+id/spAgingType"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:drawable/btn_dropdown"/>
    </LinearLayout>

    <!-- رأس الجدول -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/colorPrimaryContainer"
                android:padding="8dp">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="الحساب" android:textStyle="bold"/>
                <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="الرصيد" android:textStyle="bold" android:gravity="center"/>
                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="0-30" android:textStyle="bold" android:gravity="center" android:textColor="#27AE60"/>
                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="31-60" android:textStyle="bold" android:gravity="center" android:textColor="#F39C12"/>
                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="61-90" android:textStyle="bold" android:gravity="center" android:textColor="#E67E22"/>
                <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="+90" android:textStyle="bold" android:gravity="center" android:textColor="#E74C3C"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAging"
                android:layout_width="wrap_content"
                android:layout_height="match_parent" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- تذييل الإجماليات -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant">
        <TextView
            android:id="@+id/tvAgingTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إجمالي الديون: 0.00"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
