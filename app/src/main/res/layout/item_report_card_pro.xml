<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#0F1D1D1D"
    app:rippleColor="#22C9A961">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- مؤشر ملون جانبي للحالة/النوع -->
        <View
            android:id="@+id/viewColorAccent"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_accent_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- حاوية الأيقونة -->
        <FrameLayout
            android:id="@+id/flIconContainer"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_icon_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewColorAccent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivReportIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/accent_dark" />
        </FrameLayout>

        <!-- تفاصيل التقرير -->
        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="المبيعات التفصيلي والوزن"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintStart_toEndOf="@id/flIconContainer"
            app:layout_constraintTop_toTopOf="@id/flIconContainer" />

        <TextView
            android:id="@+id/tvReportSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:text="فواتير + تكلفة الأجور + مكافئ العيار"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintStart_toEndOf="@id/flIconContainer"
            app:layout_constraintTop_toBottomOf="@id/tvReportTitle" />

        <!-- شارة النوع/المستوى -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipAdvanced"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="تحليل حي"
            android:textColor="@color/accent_dark"
            android:textSize="9sp"
            app:chipMinHeight="20dp"
            app:chipPadding="0dp"
            app:layout_constraintStart_toEndOf="@id/flIconContainer"
            app:layout_constraintTop_toBottomOf="@id/tvReportSubtitle" />

        <!-- سهم الانتقال -->
        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_media_play"
            android:rotation="180"
            app:tint="#B0BEC5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
