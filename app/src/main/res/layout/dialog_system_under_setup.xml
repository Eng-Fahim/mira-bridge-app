<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_setup_sheet"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- أيقونة أعلى النافذة -->
    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@android:drawable/ic_lock_lock"
        android:background="@drawable/bg_setup_icon_circle"
        android:padding="20dp"
        android:tint="#FFC107"
        android:contentDescription="setup"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp" />

    <!-- العنوان -->
    <TextView
        android:id="@+id/tvSetupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="النظام قيد الإعداد"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- الرسالة -->
    <TextView
        android:id="@+id/tvSetupMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="لم يتم استكمال الإعداد المحاسبي بعد.\nيرجى التواصل مع مهندس النظام أو مدير الجهة."
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:textColor="#CCCCCC"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- صندوق جهات الاتصال -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_setup_contact_box"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvContactSystemAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔧  مهندس النظام (System Admin)"
            android:textSize="14sp"
            android:textColor="#FFC107"
            android:paddingVertical="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="6dp" />

        <TextView
            android:id="@+id/tvContactOrgAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏢  مدير الجهة (Org Admin)"
            android:textSize="14sp"
            android:textColor="#FFC107"
            android:paddingVertical="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="6dp" />

        <TextView
            android:id="@+id/tvContactEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📧  support@mirabarcode.com"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- زر تسجيل الخروج -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetupLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="تسجيل الخروج"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="26dp"
        app:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF" />
</LinearLayout>
