<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:direction="rtl"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- العمود 1: رقم القيد / الكود -->
        <TextView
            android:id="@+id/tvRowCol1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:textColor="#2C3E50"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="JV-2026-001" />

        <!-- العمود 2: البيان / اسم الحساب -->
        <TextView
            android:id="@+id/tvRowCol2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="start|center_vertical"
            android:paddingStart="8dp"
            android:textColor="#34495E"
            android:textSize="12sp"
            tools:ignore="RtlSymmetry"
            tools:text="مبيعات مجوهرات - الفرع الرئيسي" />

        <!-- العمود 3: مدين / نوع الحساب -->
        <TextView
            android:id="@+id/tvRowCol3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:textColor="#27AE60"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="150,000" />

        <!-- العمود 4: دائن / الرصيد -->
        <TextView
            android:id="@+id/tvRowCol4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:textColor="#C0392B"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="0.00" />
    </LinearLayout>

    <!-- خط فاصل خفيف بين الأسطر -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#E0E0E0" />

</LinearLayout>
