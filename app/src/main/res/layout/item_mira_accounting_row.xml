<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp">

    <!-- العمود الأول: الكود / الرقم -->
    <TextView
        android:id="@+id/tvRowCol1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#2C3E50"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- العمود الثاني: البيان + شارة RFID -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:orientation="vertical"
        android:paddingStart="6dp">

        <TextView
            android:id="@+id/tvRowCol2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#34495E"
            android:textSize="11sp" />

        <!-- ✅ الـ ID المفقود تم إضافته هنا بشكل أنيق -->
        <TextView
            android:id="@+id/tvRowRfidTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="#10000000"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#7F8C8D"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- العمود الثالث: وزن الذهب -->
    <TextView
        android:id="@+id/tvRowCol3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="center"
        android:textColor="#F1C40F"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- العمود الرابع: النقدية -->
    <TextView
        android:id="@+id/tvRowCol4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:gravity="center"
        android:textColor="#2ECC71"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
