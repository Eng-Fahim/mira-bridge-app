<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <!-- ═══════════════════════════════════════════════════════
         مقبض السحب السفلي (Drag Handle)
         ═══════════════════════════════════════════════════════ -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_4"
        android:background="?attr/colorOutline"
        android:alpha="0.4" />

    <!-- ═══════════════════════════════════════════════════════
         عنوان النافذة
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:text="إدارة المنظومة والأجهزة"
        android:textAppearance="@style/TextAppearance.App.Title.Medium"
        android:textColor="?attr/colorOnSurface" />

    <!-- ═══════════════════════════════════════════════════════
         قسم 1: العمليات والإدارة
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_2"
        android:text="العمليات والإدارة"
        android:textAppearance="@style/TextAppearance.App.Label.Medium"
        android:textColor="@color/text_gold_accent"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <!-- بطاقة التكويد -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAdminIdentity"
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/space_1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_barcode"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:text="تكويد الذهب"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقة الفروع والمستخدمين -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAdminUsers"
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/space_1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_users"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:text="الفروع والموظفين"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقة التقارير والمالية -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAdminReports"
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/space_1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_reports"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:text="التقارير والمالية"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- بطاقة الإعدادات العامة -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAdminSettings"
            style="@style/AppCardViewStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/space_1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:text="إعدادات النظام"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>

    <!-- ═══════════════════════════════════════════════════════
         قسم 2: الأجهزة والربط الميداني
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_2"
        android:text="الأجهزة والربط الميداني"
        android:textAppearance="@style/TextAppearance.App.Label.Medium"
        android:textColor="@color/text_gold_accent"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- زر ماسح RFID -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHardwareRfid"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="ماسح RFID"
            android:textSize="12sp"
            app:icon="@drawable/ic_rfid"
            app:iconSize="@dimen/icon_sm" />

        <!-- زر البوابات -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHardwareGate"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="البوابات"
            android:textSize="12sp"
            app:icon="@drawable/ic_gate"
            app:iconSize="@dimen/icon_sm" />
    </LinearLayout>

</LinearLayout>
