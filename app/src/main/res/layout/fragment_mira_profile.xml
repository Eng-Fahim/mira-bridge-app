<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. كارت الهوية الشخصية والبطاقة الرقمية -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- الصورة الشخصية العائمة -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="#E0E0E0"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:shapeAppearanceOverlay="@style/CircleImageView"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="2dp" />

                <!-- الاسم الكامل -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="فهيم محسن الهاشمي"
                    android:textColor="#1E1E1E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- المسمى الوظيفي / الصلاحية -->
                <TextView
                    android:id="@+id/tvUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="مدير النظام الرئيسي | MIRA Trust"
                    android:textColor="#757575"
                    android:textSize="13sp" />

                <!-- شريط رقم الحساب والرمز البديل المزدوج (شديد الاحترافية كالصورة) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- بطاقة البيانات الرئيسية (حمراء/ذهبية داكنة حسب هويتكم) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_account_box"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <!-- القسم الثاني: الرقم البديل -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="الرقم البديل"
                                android:textColor="#FFEAEA"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvAltNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9300874"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="28dp"
                            android:background="#40FFFFFF" />

                        <!-- القسم الأول: رقم الحساب / المعرف -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="رقم الحساب"
                                android:textColor="#FFEAEA"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvAccountNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="779033392"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- زر QR Code الذكي للمشاركة والتكويد -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnQrCode"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#22252A"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@android:color/white" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. قائمة الخيارات التفاعلية (مطابقة للديزاين والمفهوم في الصورة) -->

        <!-- خيار 1: تحديث بيانات التطبيق والفرع -->
        <include
            id="@+id/itemSyncData"
            layout="@layout/item_profile_action" />

        <!-- خيار 2: إدارة أجهزة RFID والقارئ Handheld -->
        <include
            id="@+id/itemDeviceManagement"
            layout="@layout/item_profile_action" />

        <!-- خيار 3: ملف الشركة والفرع الحالي -->
        <include
            id="@+id/itemBranchInfo"
            layout="@layout/item_profile_action" />

        <!-- خيار 4: الخصوصية والأمان والتشفير -->
        <include
            id="@+id/itemSecurity"
            layout="@layout/item_profile_action" />

        <!-- خيار 5: إعدادات التطبيق وتفضيلات اللغة -->
        <include
            id="@+id/itemAppSettings"
            layout="@layout/item_profile_action" />

        <!-- خيار 6: الدعم الفني والمساعدة المباشرة -->
        <include
            id="@+id/itemSupport"
            layout="@layout/item_profile_action" />

        <!-- زر تسجيل الخروج المحترف -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="تسجيل الخروج"
            android:textColor="#D32F2F"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#FFEBEE"
            app:cornerRadius="14dp"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconGravity="textStart"
            app:iconTint="#D32F2F"
            app:strokeColor="#FFCDD2"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
