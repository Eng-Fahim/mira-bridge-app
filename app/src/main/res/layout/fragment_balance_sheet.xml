<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- التاريخ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsOf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كما في: 01/01/2026"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:icon="@android:drawable/ic_menu_my_calendar"
            android:layout_marginBottom="12dp"/>

        <!-- KPIs -->
        <LinearLayout
            android:id="@+id/kpiContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"/>

        <!-- حالة التوازن -->
        <TextView
            android:id="@+id/tvBalanceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ جاري الحساب..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- 3 أقسام -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- الأصول -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 الأصول"
                        android:textColor="#3498DB"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/assetsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <TextView
                        android:id="@+id/tvTotalAssets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إجمالي: 0.00"
                        android:textColor="#2C3E50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:background="#ECF0F1"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- الالتزامات -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📉 الالتزامات"
                        android:textColor="#E74C3C"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/liabilitiesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <TextView
                        android:id="@+id/tvTotalLiabilities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إجمالي: 0.00"
                        android:textColor="#2C3E50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:background="#ECF0F1"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- حقوق الملكية -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💰 حقوق الملكية"
                        android:textColor="#9B59B6"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/equityContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <TextView
                        android:id="@+id/tvTotalEquity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إجمالي: 0.00"
                        android:textColor="#2C3E50"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:background="#ECF0F1"
                        android:padding="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
