            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLiveUSD_EGP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 USD = 30.90 EGP"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLiveUSD_SAR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
