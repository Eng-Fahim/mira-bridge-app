                android:textColor="?attr/colorOnBackground"/>
            <EditText
                android:id="@+id/etExchangeEGP"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="30.90"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurfaceVariant"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- SAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SAR"
                android:textColor="?attr/colorOnBackground"/>
            <EditText
                android:id="@+id/etExchangeSAR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="3.75"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurfaceVariant"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- AED -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AED"
                android:textColor="?attr/colorOnBackground"/>
            <EditText
                android:id="@+id/etExchangeAED"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:hint="3.67"
                android:textColor="?attr/colorOnSurface"
                android:background="?attr/colorSurfaceVariant"
                android:padding="12dp"/>
        </LinearLayout>

        
        <!-- الأسعار المباشرة -->
        <TextView
            android:id="@+id/tvLiveUSD_YER"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 USD = 250.00 YER"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLiveUSD_EGP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 USD = 30.90 EGP"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLiveUSD_SAR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 USD = 3.75 SAR"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLiveUSD_AED"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 USD = 3.67 AED"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp"/>

        <!-- أزرار الحفظ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCurrencySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_currency_settings"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshRates"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_rates"
            android:textColor="?attr/colorPrimary"
            app:strokeColor="?attr/colorPrimary"
            app:cornerRadius="8dp"/>

    </LinearLayout>
</ScrollView>
