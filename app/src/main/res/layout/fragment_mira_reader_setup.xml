<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════════
         العنوان الرئيسي
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding_h"
        android:text="🔌 إعدادات قارئ RFID"
        android:textAppearance="@style/TextAppearance.App.Title.Large"
        android:textColor="?attr/colorOnSurface" />

    <!-- حالة الجهاز النشط -->
    <TextView
        android:id="@+id/tvActiveDeviceStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_2"
        android:text="لا يوجد جهاز نشط"
        android:textAppearance="@style/TextAppearance.App.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- ═══════════════════════════════════════════════════════
         الصف الأول: اكتشاف وإضافة
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetectAuto"
            style="@style/AppButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="🔍 اكتشاف تلقائي"
            app:icon="@drawable/ic_search"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddReader"
            style="@style/AppButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="➕ إضافة"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_2" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         الصف الثاني: اختبار وبحث بلوتوث
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestConnection"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="📡 اختبار اتصال"
            android:textColor="?attr/colorPrimary"
            app:icon="@drawable/ic_signal"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_2"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBluetoothScan"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="🔗 بحث بلوتوث"
            android:textColor="?attr/colorPrimary"
            app:icon="@drawable/ic_bluetooth"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_2"
            app:iconTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         الصف الثالث: الصوت والاهتزاز
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingBottom="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSoundToggle"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="🔊 الصوت: مفعل"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            app:icon="@drawable/ic_volume_on"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_1"
            app:iconSize="@dimen/icon_sm"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVibrationToggle"
            style="@style/AppButtonStyle.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            android:text="📳 الاهتزاز: مفعل"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            app:icon="@drawable/ic_vibration"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_1"
            app:iconSize="@dimen/icon_sm"
            app:iconTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         زر الإعدادات المتقدمة
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdvancedSettings"
        style="@style/AppButtonStyle.Tonal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginBottom="@dimen/space_2"
        android:text="⚙️ الإعدادات المتقدمة للقارئ"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_2" />

    <!-- ═══════════════════════════════════════════════════════
         زر تطبيق الإعدادات
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplySettings"
        style="@style/AppButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/screen_padding_h"
        android:layout_marginBottom="@dimen/space_4"
        android:text="🔄 تطبيق الإعدادات الآن"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_2" />

    <!-- ═══════════════════════════════════════════════════════
         عنوان "الأجهزة المحفوظة"
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2"
        android:text="الأجهزة المحفوظة"
        android:textAppearance="@style/TextAppearance.App.Label.Medium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <!-- ═══════════════════════════════════════════════════════
         قائمة الأجهزة
         ═══════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReaderDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingBottom="@dimen/space_4" />

</LinearLayout>
