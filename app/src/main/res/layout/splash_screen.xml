<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background_gradient">

    <!-- الشعار الرئيسي والعنوان -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- حاوية الشعار -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp">

            <!-- الشعار -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mira_logo"
                android:contentDescription="MIRA Logo"
                android:elevation="8dp" />
        </FrameLayout>

        <!-- اسم التطبيق -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIRA"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.3"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="8"
            android:elevation="6dp" />

        <!-- الشعار الفرعي -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Jewelry Enterprise Platform"
            android:textSize="14sp"
            android:textColor="#CCFFFFFF"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-light"
            android:gravity="center" />
    </LinearLayout>

    <!-- مؤشر التحميل -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="50dp"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="#FFD700"
            android:indeterminateTintMode="src_atop" />

        <!-- نسخة التطبيق -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="v4.1.0"
            android:textSize="10sp"
            android:textColor="#40FFFFFF"
            android:fontFamily="sans-serif-light" />
    </LinearLayout>

</RelativeLayout>
