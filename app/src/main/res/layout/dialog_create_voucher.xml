<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        style="@style/AppCardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="إنشاء سند جديد"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- نوع السند -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نوع السند"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"/>
            <Spinner
                android:id="@+id/spVoucherType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"/>

            <!-- الحساب -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الحساب (إلى/من)"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:boxStrokeColor="?attr/colorPrimary">
                <AutoCompleteTextView
                    android:id="@+id/ddVoucherAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="اختر الحساب"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- المبلغ النقدي -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="المبلغ النقدي (YER)"
                android:layout_marginBottom="8dp"
                app:boxStrokeColor="?attr/colorPrimary">
                <EditText
                    android:id="@+id/etVoucherCashAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- الوزن الذهبي -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="الوزن الذهبي (جرام) - اختياري"
                android:layout_marginBottom="8dp"
                app:boxStrokeColor="?attr/colorPrimary">
                <EditText
                    android:id="@+id/etVoucherGoldWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- العيار -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العيار"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"/>
            <Spinner
                android:id="@+id/spVoucherKarat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"/>

            <!-- طريقة الدفع -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طريقة الدفع"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"/>
            <Spinner
                android:id="@+id/spVoucherPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"/>

            <!-- ملاحظات -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="البيان / الملاحظات"
                android:layout_marginBottom="16dp"
                app:boxStrokeColor="?attr/colorPrimary">
                <EditText
                    android:id="@+id/etVoucherNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- الأزرار -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoucherCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="إلغاء"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoucherSave"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="2"
                    android:text="حفظ السند"
                    android:textColor="?attr/colorOnPrimary"
                    app:backgroundTint="?attr/colorPrimary"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
