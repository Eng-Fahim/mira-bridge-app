<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إنشاء سند جديد"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- نوع السند -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نوع السند"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spVoucherType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp" />

        <!-- المبلغ النقدي -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoucherCashAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="المبلغ النقدي"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- وزن الذهب -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoucherGoldWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="وزن الذهب (جرام)"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- العيار -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العيار"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spVoucherKarat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp" />

        <!-- طريقة الدفع -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="طريقة الدفع"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spVoucherPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp" />

        <!-- ملاحظات -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxCornerRadiusTopStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusBottomEnd="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoucherNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ملاحظات"
                android:inputType="textMultiLine"
                android:maxLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- أزرار -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoucherCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="إلغاء"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoucherSave"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="حفظ"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
