<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppCardViewStyle.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_3">

        <!-- ═══════════════════════════════════════════════════════
             الصف الأول: العنوان + الـ Karat Badge
             ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPendingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="عنوان القطعة"
                android:textAppearance="@style/TextAppearance.App.Label.Large"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvPendingKarat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_karat_badge"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:text="21K"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="@color/text_gold_accent"
                android:textDirection="ltr" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════
             EPC
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvPendingEpc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="EPC: ABC123"
            android:textAppearance="@style/TextAppearance.App.Label.Small"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textDirection="ltr" />

        <!-- ═══════════════════════════════════════════════════════
             الوزن
             ═══════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvPendingWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="الوزن: 5.5 جم"
            android:textAppearance="@style/TextAppearance.App.Label.Small"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- ═══════════════════════════════════════════════════════
             أزرار الإجراء
             ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <!-- زر المزامنة (أخضر Success) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncItem"
                style="@style/AppButtonStyle.Text"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_sm"
                android:layout_marginEnd="@dimen/space_1"
                android:layout_weight="1"
                android:text="🔄 مزامنة"
                android:textColor="@color/success_500"
                app:iconTint="@color/success_500" />

            <!-- زر الحذف (أحمر Danger) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteItem"
                style="@style/AppButtonStyle.Text"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_sm"
                android:layout_marginStart="@dimen/space_1"
                android:layout_weight="1"
                android:text="🗑️ حذف"
                android:textColor="@color/danger_500"
                app:iconTint="@color/danger_500" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
