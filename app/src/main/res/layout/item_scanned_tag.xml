<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ID: tvTagTitle -->
            <TextView
                android:id="@+id/tvTagTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="خاتم ذهب عيار 21"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ID: tvTagEpc (تم تصحيح الحرف الأخير إلى c صغيرة لتطابق الجافا) -->
            <TextView
                android:id="@+id/tvTagEpc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E2801191A00000000000"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp" />

            <!-- ID: tvTagDetails -->
            <TextView
                android:id="@+id/tvTagDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الوزن: 12.5 جم | العدد: 1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- ID: tvTagStatus -->
            <TextView
                android:id="@+id/tvTagStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مطابق"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- ID: tvTagTime -->
            <TextView
                android:id="@+id/tvTagTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:45:12"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />

            <!-- ID: tvTagRssi (مضاف حديثاً لتجنب خطأ الكومبايلر) -->
            <TextView
                android:id="@+id/tvTagRssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-55 dBm"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
