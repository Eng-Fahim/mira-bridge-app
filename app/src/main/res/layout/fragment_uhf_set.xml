<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 1. Language & System Mode Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 إعدادات اللغة والنظام"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="لغة التطبيق:"
                    android:textColor="#475569" />

                <RadioGroup
                    android:id="@+id/rgLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbLangAr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="العربية" />

                    <RadioButton
                        android:id="@+id/rbLangEn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="English" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="وضع العمل:"
                    android:textColor="#475569" />

                <Spinner
                    android:id="@+id/spWorkingMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/working_modes" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Organization Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏢 ملف المنشأة المؤسسي"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E2E8F0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivOrgLogo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="#F1F5F9"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_gallery" />

                    <Button
                        android:id="@+id/btnPickLogo"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="اختيار الشعار" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etOrgNameAr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="اسم المنشأة (بالعربي)" />

                <EditText
                    android:id="@+id/etOrgNameEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Organization Name (English)" />

                <EditText
                    android:id="@+id/etOrgSloganAr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="الشعار اللفظي (بالعربي)" />

                <EditText
                    android:id="@+id/etOrgSloganEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Slogan (English)" />

                <EditText
                    android:id="@+id/etOrgPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="رقم الهاتف"
                    android:inputType="phone" />

                <EditText
                    android:id="@+id/etOrgEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="البريد الإلكتروني"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/etOrgAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="العنوان" />

                <EditText
                    android:id="@+id/etOrgWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="الموقع الإلكتروني" />

                <TextView
                    android:id="@+id/tvOrgStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveOrgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="حفظ بيانات المنشأة" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. MIRA Bridge Integration Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗 ربط خادم MIRA Bridge"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رابط الـ API الخادم:"
                    android:textColor="#475569" />

                <Spinner
                    android:id="@+id/spMiraApiUrl"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/mira_api_urls" />

                <EditText
                    android:id="@+id/etMiraApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="مفتاح API Key"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/etMiraGateId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="معرف البوابة / الجهاز (Gate/Device ID)" />

                <TextView
                    android:id="@+id/tvMiraConnectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTestMiraConnection"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="اختبار الاتصال بالسيرفر" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. Scan & Identification Settings Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 وضع المسح والالتقاط"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E2E8F0" />

                <RadioGroup
                    android:id="@+id/rgScanMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbRfidMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="قراءة UHF RFID فقط" />

                    <RadioButton
                        android:id="@+id/rbCameraMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="كاميرا / باركود ضوئي فقط" />

                    <RadioButton
                        android:id="@+id/rbHybridMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="مزدوج (RFID + باركود)" />

                    <RadioButton
                        android:id="@+id/rbManualMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إدخال يدوي" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/cbParseGS1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تحليل معايير GS1 تلقائياً" />

                <CheckBox
                    android:id="@+id/cbVibrateOnScan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تفعيل الاهتزاز عند القراءة الناجحة" />

                <CheckBox
                    android:id="@+id/cbInventorySound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تفعيل صوت الجرد (Beeper)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. UHF RFID Hardware Settings Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 إعدادات العتاد والمعلمات (UHF RFID)"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E2E8F0" />

                <!-- Power Control -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="طاقة الإشارة (Power dBm):"
                    android:textColor="#475569" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spPower"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:entries="@array/arrayPower" />

                    <Button
                        android:id="@+id/btnSetPower"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ضبط" />

                    <Button
                        android:id="@+id/btnGetPower"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="قراءة" />
                </LinearLayout>

                <!-- Frequency Mode -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="نطاق التردد (Frequency Region):"
                    android:textColor="#475569" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spFrequency"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:entries="@array/arrayMode" />

                    <Button
                        android:id="@+id/btnSetFrequency"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ضبط" />

                    <Button
                        android:id="@+id/btnGetFrequency"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="قراءة" />
                </LinearLayout>

                <!-- Advanced Gen2 Protocol Parameters -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="بنك الذاكرة المستهدف (Memory Bank):"
                    android:textColor="#475569" />

                <Spinner
                    android:id="@+id/spMemoryBank"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/arrayMemoryBank" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الجلسة (Session):"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spSession"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:entries="@array/arraySession" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الهدف (Target):"
                            android:textSize="12sp" />

                        <Spinner
                            android:id="@+id/spTarget"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:entries="@array/arrayTarget" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="معدل الربط (Link Profile):"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spLinkParams"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/arrayLinkParams" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="نمط الجرد (Inventory Mode):"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spInventoryMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/arrayInventoryMode" />

                <CheckBox
                    android:id="@+id/cbFastId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FastID (سرعة قراءة TID)" />

                <CheckBox
                    android:id="@+id/cbTagFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TagFocus (تركيز القراءة)" />

                <CheckBox
                    android:id="@+id/cbDynamicPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إدارة الطاقة الديناميكية" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSetRfParams"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="حفظ معلمات Gen2" />

                    <Button
                        android:id="@+id/btnGetRfParams"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="جلب معلمات Gen2" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 6. Global Action Buttons -->
        <Button
            android:id="@+id/btnSaveAllSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2563EB"
            android:text="💾 حفظ كافة الإعدادات والتطبيقات"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFactoryReset"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#EF4444"
            android:text="🔄 استعادة ضبط المصنع" />

    </LinearLayout>
</ScrollView>
