<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تعديل بيانات المنشأة / Edit Profile"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etEditNameAr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اسم المنشأة بالعربي"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etEditNameEn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Facility Name (English)"
        android:inputType="text"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etEditPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="رقم الهاتف"
        android:inputType="phone"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etEditEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="البريد الإلكتروني"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/etEditTax"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="الرقم الضريبي"
        android:inputType="number" />

</LinearLayout>
