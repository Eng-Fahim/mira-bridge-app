<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:layoutDirection="rtl">

    <!-- ═══════════════════════════════════════════════════════
         Header Toolbar
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="0dp"
        app:cardElevation="@dimen/elevation_2"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding_h"
            android:paddingVertical="@dimen/space_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transfers_title"
                    android:textAppearance="@style/TextAppearance.App.Title.Medium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/tvTransferCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                    android:textColor="?attr/colorOnPrimaryContainer" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewTransfer"
                style="@style/AppButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_sm"
                android:text="@string/new_transfer"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_input_add"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_sm" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════════════════
         Filter Chips (تُولَّد ديناميكياً في Java)
         ═══════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="@dimen/space_2"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_2"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- ═══════════════════════════════════════════════════════
         زر مسح RFID السريع
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingBottom="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanItems"
            style="@style/AppButtonStyle.Tonal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/scan_verify"
            android:textSize="13sp"
            app:icon="@android:drawable/ic_menu_search"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_md" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         قائمة التحويلات
         ═══════════════════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransfers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_2" />

        <!-- الحالة الفارغة -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyTransfers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/no_transfers"
                android:textAppearance="@style/TextAppearance.App.Body.Large"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:alpha="0.7"
                android:gravity="center"
                android:text="اضغط على تحويل جديد للبدء"
                android:textAppearance="@style/TextAppearance.App.Body.Small"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
