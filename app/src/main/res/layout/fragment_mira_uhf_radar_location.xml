<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="5dp"
    android:background="?android:attr/colorBackground">

    <!-- ══════════════════════════════════════════════ -->
    <!--  شريط العنوان مع زر الإغلاق                  -->
    <!-- ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnRadarClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvRadarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📡 رادار تحديد الموقع"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- عنصر وهمي للتوازن -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════ -->
    <!--  أزرار الأوضاع والأدوات                        -->
    <!-- ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/layoutTitleBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnModeSingle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="🎯 محدد"
            android:textSize="11sp"
            android:textColor="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary" />

        <Button
            android:id="@+id/btnModeOpen"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="📡 مسح مفتوح"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:backgroundTint="?attr/colorSurfaceVariant" />

        <Button
            android:id="@+id/btnModeGate"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="🔍 مفقودات"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:backgroundTint="?attr/colorSurfaceVariant" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════ -->
    <!--  حالة القارئ                                   -->
    <!-- ══════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvReaderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:gravity="center"
        android:text="📡 القارئ: جاري الفحص..."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/layoutModes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════════ -->
    <!--  حقل EPC + أزرار الاختيار والتصدير             -->
    <!-- ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/epcLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/tvReaderStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/etRadarEPC"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="أدخل EPC أو اختر قطعة مفقودة"
            android:textSize="12sp"
            android:background="@drawable/seekbar_bg"
            android:paddingHorizontal="10dp" />

        <Button
            android:id="@+id/btnFetchMissing"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:text="📋 المفقودات"
            android:textSize="10sp"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <Button
            android:id="@+id/btnExportResults"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:text="📤"
            android:textSize="12sp"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════ -->
    <!--  مؤشر القرب المتقدم و Geiger RSSI              -->
    <!-- ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutRssi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/epcLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProximityLevel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="جاهز للتتبع..."
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSignalStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEstimatedDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📏 المسافة: غير معروفة"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp"
            android:gravity="center"
            android:padding="2dp" />

        <ProgressBar
            android:id="@+id/rssiBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="?attr/colorPrimary"
            android:progressBackgroundTint="?attr/colorSurfaceVariant" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════ -->
    <!--  أزرار التحكم والتشغيل (مثبتة بالأعلى لتأمين القيود) -->
    <!-- ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/llButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btRadarStart"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▶ بدء التتبع"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btRadarStop"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/stop_location"
            android:backgroundTint="?attr/colorError"
            android:textColor="?attr/colorOnError"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSearchRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/searchRange"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:padding="2dp"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/llButton" />

    <LinearLayout
        android:id="@+id/_llSearchRange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toTopOf="@id/tvSearchRange">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="+"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.example.uhf.view.CircleSeekBar
            android:id="@+id/seekBarPower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:max="30"
            android:progressDrawable="@drawable/seekbar_bg"
            android:splitTrack="false"
            android:thumb="@drawable/shape_seekbar_circle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="-"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/_llSearchRange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAuthorizedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#22C55E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ مصرح"
                android:textColor="?attr/colorOnSurface"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDeniedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#EF4444"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 تنبيه"
                android:textColor="?attr/colorOnSurface"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvUnknownCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F59E0B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ مفقود/غريب"
                android:textColor="?attr/colorOnSurface"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRecent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="?attr/colorSurface"
        app:layout_constraintBottom_toTopOf="@id/layoutStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvRecentScans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="9sp"
            android:maxLines="3" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMiraRadarInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutRecent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRadarItemStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="حالة القطعة"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkFound"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✅ تم العثور عليها"
                android:textSize="10sp"
                android:visibility="gone"
                android:backgroundTint="#22C55E"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRadarItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 اسم القطعة"
            android:textColor="?attr/colorOnPrimary"
            android:alpha="0.9"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvRadarItemDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ التفاصيل"
            android:textColor="?attr/colorOnPrimary"
            android:alpha="0.75"
            android:textSize="9sp"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════ -->
    <!--  شاشة الرادار البصرية (تأخذ المساحة المتبقية بدقة) -->
    <!-- ══════════════════════════════════════════════ -->
    <com.example.uhf.view.RadarView
        android:id="@+id/radarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutRssi"
        app:layout_constraintBottom_toTopOf="@id/layoutMiraRadarInfo"
        app:center_image="@drawable/phone"
        android:layout_margin="4dp" />

    <!-- وضع الرادار (نص مخفي للتوافق البرمجي) -->
    <TextView
        android:id="@+id/tvRadarMode"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>
