<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 مرتجع مبيعات"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- مسح القطعة -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="رمز القطعة (EPC / Serial)"
        app:boxStrokeColor="?attr/colorPrimary"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRefundScanCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="14sp"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- زر مسح باركود -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRefundScanBarcode"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📷 مسح باركود"
        app:cornerRadius="8dp"
        android:layout_marginBottom="12dp" />

    <!-- سبب الإرجاع -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="سبب الإرجاع (اختياري)"
        app:boxStrokeColor="?attr/colorPrimary"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRefundReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textSize="14sp"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ✅ قائمة اختيار طريقة الإرجاع (تم إخراجها لتكون مستقلة وصحيحة) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="طريقة الإرجاع (كيف سيستلم العميل أمواله؟)"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"/>

    <Spinner
        android:id="@+id/spRefundMethod"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:drawable/btn_dropdown"
        android:layout_marginBottom="20dp"/>

    <!-- معلومات القطعة -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRefundItemInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="8dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvRefundItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم القطعة"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRefundItemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الحالة"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- أزرار -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefundCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إلغاء"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefundConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ تأكيد الإرجاع"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
