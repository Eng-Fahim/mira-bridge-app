<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:layoutDirection="rtl">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 مركز التقارير"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDateRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="كل التواريخ"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:alpha="0.85" />
    </LinearLayout>

    <!-- شريط اختيار التقرير والفلاتر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant">

        <Spinner
            android:id="@+id/spReportType"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="8dp" />

        <LinearLayout
            android:id="@+id/layoutReportFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Spinner
                android:id="@+id/spBranchFilter"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="2"
                android:layout_marginEnd="4dp"
                android:background="?attr/colorSurface" />

            <Button
                android:id="@+id/btnDateFrom"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="من"
                android:textSize="11sp"
                android:backgroundTint="?attr/colorSurface"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/btnDateTo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="إلى"
                android:textSize="11sp"
                android:backgroundTint="?attr/colorSurface"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/btnApplyFilter"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="تطبيق"
                android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>

    <!-- عارض التقرير التفاعلي -->
    <WebView
        android:id="@+id/webReport"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- أزرار الإجراءات والتصدير -->
    <LinearLayout
        android:id="@+id/layoutReportActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant"
        android:weightSum="4">

        <Button android:id="@+id/btnPrintReport" android:text="🖨️ طباعة" android:layout_weight="1" android:layout_marginEnd="2dp" android:textSize="11sp" android:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" />
        <Button android:id="@+id/btnShareReport" android:text="📤 مشاركة" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:textSize="11sp" android:backgroundTint="?attr/colorSurface" android:textColor="?attr/colorOnSurface" />
        <Button android:id="@+id/btnExportPDF" android:text="📄 PDF" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:textSize="11sp" android:backgroundTint="?attr/colorSurface" android:textColor="?attr/colorOnSurface" />
        <Button android:id="@+id/btnExportExcel" android:text="📊 Excel" android:layout_weight="1" android:layout_marginStart="2dp" android:textSize="11sp" android:backgroundTint="?attr/colorSurface" android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</LinearLayout>
