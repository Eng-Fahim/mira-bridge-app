<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFF9E6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGoldAccountName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="مخزون ذهب 21K"
                android:textColor="#8B6914"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvGoldAccountCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="115103"
                android:textColor="#95A5A6"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="افتتاحي"
                    android:textColor="#7F8C8D"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvGoldOpening"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.000 g"
                    android:textColor="#2C3E50"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="وارد"
                    android:textColor="#7F8C8D"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvGoldIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.000 g"
                    android:textColor="#27AE60"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صادر"
                    android:textColor="#7F8C8D"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvGoldOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-0.000 g"
                    android:textColor="#E74C3C"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ختامي"
                    android:textColor="#7F8C8D"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/tvGoldClosing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.000 g"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
