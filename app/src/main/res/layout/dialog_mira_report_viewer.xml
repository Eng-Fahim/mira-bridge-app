<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/report_background">

    <!-- شريط علوي -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/report_primary"
        app:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- عنوان التقرير -->
            <TextView
                android:id="@+id/tvReportDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="تقرير المبيعات"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnReportClose"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- زر إغلاق -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@android:color/transparent"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✕"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- شريط الفلاتر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- من تاريخ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportDateFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 من: 2024-01-01"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- إلى تاريخ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportDateTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="📅 إلى: 2024-01-31"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

        <!-- أزرار الإجراءات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- تطبيق -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportApplyFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ تطبيق"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:backgroundTint="@color/report_success" />

            <!-- فلتر متقدم -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdvancedFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="⚙️ فلتر"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- تصدير -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="📄 تصدير"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- طباعة -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportPrint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="🖨️ طباعة"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- حاوية التحميل -->
    <FrameLayout
        android:id="@+id/layoutLoadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CCFFFFFF"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:indicatorColor="@color/report_primary"
                app:indicatorSize="50dp"
                app:trackThickness="4dp" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="جاري تحميل البيانات..."
                android:textColor="@color/report_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- قائمة البيانات -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReportData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- رسالة فارغة -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="#F0F0F0"
            android:gravity="center"
            android:text="📊"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="لا توجد بيانات"
            android:textColor="@color/report_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="قم بتغيير الفلاتر أو الفترة الزمنية"
            android:textColor="@color/report_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
