<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:minWidth="90dp"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_2">

    <!-- الأيقونة + اسم العيار -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- الأيقونة: استخدمنا لون الـ Primary الخاص بالتطبيق (الذهبي) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary" />

        <!-- اسم العيار: سيتم تلوينه برمجياً في الجافا حسب العيار، لكن هذا اللون الافتراضي -->
        <TextView
            android:id="@+id/tvKaratLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="?attr/colorPrimary"
            tools:text="24K" />
    </LinearLayout>

    <!-- العدد (البطل): يتغير تلقائياً (أسود في النهاري، أبيض في الليلي) -->
    <TextView
        android:id="@+id/tvKaratCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" 
        android:fontFamily="sans-serif-medium"
        tools:text="12" />

    <!-- كلمة "قطعة": لون ثانوي يتكيف مع الثيم -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pieces"
        android:textSize="10sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="-4dp" />

    <!-- خط فاصل ذهبي رفيع: نستخدم لون الـ Primary مع شفافية -->
    <View
        android:layout_width="24dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.3"
        android:background="?attr/colorPrimary" />

    <!-- الوزن: لون ثانوي يتكيف مع الثيم -->
    <TextView
        android:id="@+id/tvKaratWeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="sans-serif-light"
        tools:text="134.0 g" />
</LinearLayout>
