<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_2"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke_warm"
    app:strokeWidth="@dimen/stroke_normal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="86dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="@dimen/space_3">

        <!-- Karat Label (24K / 21K / 18K) -->
        <TextView
            android:id="@+id/tvKaratLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Title.Small"
            android:textStyle="bold"
            tools:text="24K"
            tools:textColor="#B8860B" />

        <!-- Count + unit -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_baseline"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvKaratCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Number.Large"
                android:textColor="?attr/colorOnSurface"
                tools:text="50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@string/pieces"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Weight -->
        <TextView
            android:id="@+id/tvKaratWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.App.Label.Small"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="800.0 g" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
