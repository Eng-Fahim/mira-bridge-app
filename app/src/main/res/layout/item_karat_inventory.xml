<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:minWidth="90dp"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/space_2">

    <!-- اسم العيار بتأثير لوني -->
    <TextView
        android:id="@+id/tvKaratLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        tools:text="24K"
        tools:textColor="#D4AF37" />

    <!-- العدد (البطل) -->
    <TextView
        android:id="@+id/tvKaratCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        tools:text="12" />

    <!-- كلمة "قطعة" -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pieces"
        android:textSize="10sp"
        android:textColor="#A0A0A0"
        android:layout_marginTop="-4dp" />

    <!-- خط فاصل ذهبي رفيع -->
    <View
        android:layout_width="24dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#44D4AF37" />

    <!-- الوزن -->
    <TextView
        android:id="@+id/tvKaratWeight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#E0E0E0"
        android:fontFamily="sans-serif-light"
        tools:text="134.0 g" />
</LinearLayout>
