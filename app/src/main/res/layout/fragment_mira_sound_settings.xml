<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <!-- المفتاح الرئيسي لتفعيل الأصوات -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMasterSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تفعيل الأصوات العامة"
        android:textSize="16sp"
        android:paddingBottom="12dp"/>

    <!-- المفتاح الرئيسي للاهتزاز -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchMasterVibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تفعيل الاهتزاز مع التنبيهات"
        android:textSize="16sp"
        android:paddingBottom="16dp"/>

    <!-- شريط التحكم بمستوى الصدمة أو الصوت -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مستوى الصوتي والتنبيه"
        android:textColor="?attr/colorPrimary"
        android:paddingBottom="8dp"/>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="100"
        android:stepSize="10"
        android:value="80"
        android:paddingBottom="16dp"/>

    <!-- قائمة أحداث الأصوات -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSoundEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="16dp"/>

    <!-- زر الحفظ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSoundSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حفظ الإعدادات"
        app:cornerRadius="8dp"/>

</LinearLayout>
