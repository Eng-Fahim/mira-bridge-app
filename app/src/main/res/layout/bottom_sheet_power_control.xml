<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="32dp"
    android:paddingHorizontal="20dp">

    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle_bar" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="⚡ التحكم بقدرة الهوائي"
        android:textColor="?attr/colorOnSurface"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="@font/cairo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="قلل القدرة للتركيز على القطع القريبة فقط"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:fontFamily="@font/cairo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPowerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="26 dBm"
            android:textColor="?attr/colorPrimary"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="@font/cairo" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderPower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:valueFrom="5"
        android:valueTo="30"
        android:stepSize="1"
        android:value="26"
        app:thumbColor="?attr/colorPrimary"
        app:trackColorActive="?attr/colorPrimary"
        app:trackColorInactive="#20D9A736"
        app:haloColor="#30D9A736" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 dBm"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="30 dBm"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyPower"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="تطبيق"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/cairo"
        app:cornerRadius="12dp" />
</LinearLayout>
