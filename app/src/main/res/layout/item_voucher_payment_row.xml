<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp"
    android:background="?attr/colorSurfaceVariant"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spVoucherPayCurrency"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:backgroundTint="?attr/colorPrimary"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:hint="المبلغ"
            app:boxStrokeColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVoucherPayAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/btnVoucherPayRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#DC2626"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <Spinner
            android:id="@+id/spVoucherPayMethod"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:backgroundTint="?attr/colorOnSurfaceVariant"/>

        <TextView
            android:id="@+id/tvVoucherPayEquivalent"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="0.00 YER"
            android:gravity="end"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
