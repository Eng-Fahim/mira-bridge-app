<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <!-- ═══════════════════════════════════════════════════════
         مقبض السحب
         ═══════════════════════════════════════════════════════ -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/space_4"
        android:background="?attr/colorOutline"
        android:alpha="0.4" />

    <!-- ═══════════════════════════════════════════════════════
         أيقونة النجاح
         ═══════════════════════════════════════════════════════ -->
    <ImageView
        android:layout_width="@dimen/icon_2xl"
        android:layout_height="@dimen/icon_2xl"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/space_2"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/gold_500" />

    <!-- ═══════════════════════════════════════════════════════
         عنوان النجاح
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="تم تكويد القطعة بنجاح!"
        android:textAppearance="@style/TextAppearance.App.Title.Large"
        android:textColor="?attr/colorOnSurface" />

    <!-- ═══════════════════════════════════════════════════════
         صورة القطعة
         ═══════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/imgSummaryPhoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/space_3"
        android:contentDescription="صورة القطعة"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_image"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════════════════
         بطاقة ملخص البيانات
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_5"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="@dimen/elevation_0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <!-- عنوان القطعة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="عنوان القطعة:"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="خاتم ذهب عيار 21"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- EPC / MIRA ID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="رمز EPC / MIRA ID:"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvSummaryEpc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:fontFamily="monospace"
                    android:text="E20000001234"
                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                    android:textColor="@color/text_gold_accent"
                    android:textDirection="ltr" />
            </LinearLayout>

            <!-- الوزن -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الوزن القائم:"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvSummaryWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="4.52 جرام"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- السعر النهائي -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="السعر النهائي:"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvSummaryPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="0.00"
                    android:textAppearance="@style/TextAppearance.App.Title.Medium"
                    android:textColor="@color/text_gold_accent"
                    android:textDirection="ltr" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════════════════
         زر عرض الهوية الرقمية
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewDigitalIdentity"
        style="@style/AppButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="💎 عرض الهوية الرقمية للقطعة" />

    <!-- ═══════════════════════════════════════════════════════
         زر تكويد قطعة جديدة
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewEncode"
        style="@style/AppButtonStyle.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_2"
        android:text="➕ تكويد قطعة جديدة" />

    <!-- ═══════════════════════════════════════════════════════
         زر الإغلاق
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDialog"
        style="@style/AppButtonStyle.Text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_sm"
        android:layout_marginTop="@dimen/space_1"
        android:text="إلغاء / إغلاق"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
