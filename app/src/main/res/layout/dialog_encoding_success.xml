<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/app-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <!-- مقبض السحب -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="?attr/colorOutline"
        android:layout_marginBottom="16dp" />

    <!-- أيقونة النجاح -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="?attr/colorPrimary"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="تم تكويد القطعة بنجاح!"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- بطاقة موجز البيانات -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="عنوان القطعة:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="خاتم ذهب عيار 21"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="رمز EPC / MIRA ID:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvSummaryEpc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E20000001234"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="الوزن القائم:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvSummaryWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.52 جرام"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- الخيارات الثلاثة -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewDigitalIdentity"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="💎 عرض الهوية الرقمية للقطعة"
        android:textStyle="bold"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewEncode"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="➕ تكويد قطعة جديدة"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:cornerRadius="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDialog"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="إلغاء / إغلاق"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
