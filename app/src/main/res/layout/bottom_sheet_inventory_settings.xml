<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:paddingHorizontal="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle_bar" />

    <!-- العنوان -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_circle_gold"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="?attr/colorOnPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ إعدادات الجلسة"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/cairo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حدد النمط والقدرة قبل البدء"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:fontFamily="@font/cairo" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 1. نمط الجرد ==================== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="📋 نمط الجرد"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/cairo" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/bsSegmentedModes"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/bsBtnModeFull">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bsBtnModeFull"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚡ شامل"
            android:textSize="12sp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bsBtnModeCategory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📂 فئوي"
            android:textSize="12sp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bsBtnModeBlind"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👁 أعمى"
            android:textSize="12sp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="12dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ==================== 2. قدرة الهوائي ==================== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="⚡ قدرة الهوائي"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/cairo" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="القيمة الحالية"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo" />

                <TextView
                    android:id="@+id/bsTvPowerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26 dBm"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/bsSliderPower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:valueFrom="5"
                android:valueTo="30"
                android:stepSize="1"
                android:value="26"
                app:thumbColor="?attr/colorPrimary"
                app:trackColorActive="?attr/colorPrimary"
                app:trackColorInactive="#20D9A736"
                app:haloColor="#30D9A736" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 dBm"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="30 dBm"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="💡 قلل القدرة للتركيز على القطع القريبة فقط"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                android:fontFamily="@font/cairo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ==================== 3. تصفية العيار ==================== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        android:text="💎 تصفية العيار"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/cairo" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/bsChipKarat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:chipSpacingHorizontal="6dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/bsChipAll"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الكل"
            android:checked="true"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bsChip24K"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24K"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bsChip22K"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22K"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bsChip21K"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21K"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bsChip18K"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18K"
            android:fontFamily="@font/cairo" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bsChip14K"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14K"
            android:fontFamily="@font/cairo" />
    </com.google.android.material.chip.ChipGroup>

    <!-- ==================== 4. أزرار الإجراءات ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bsBtnCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="إلغاء"
            android:textSize="13sp"
            android:fontFamily="@font/cairo"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bsBtnSaveAndStart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="2"
            android:text="✅ حفظ وبدء الجرد"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/cairo"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>
