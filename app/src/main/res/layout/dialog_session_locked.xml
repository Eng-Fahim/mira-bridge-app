<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_6">

    <!-- ═══════════════════════════════════════════════════════
         أيقونة القفل الكبيرة
         ═══════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="@dimen/space_4"
        android:contentDescription="@string/security_icon"
        android:importantForAccessibility="yes"
        android:src="@drawable/ic_lock_secure"
        app:tint="@color/text_gold_accent" />

    <!-- ═══════════════════════════════════════════════════════
         العنوان الرئيسي
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/session_locked_title"
        android:textAppearance="@style/TextAppearance.App.Headline.Small"
        android:textColor="?attr/colorOnSurface" />

    <!-- ═══════════════════════════════════════════════════════
         الوصف
         ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center"
        android:text="@string/session_locked_message"
        android:textAppearance="@style/TextAppearance.App.Body.Medium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- ═══════════════════════════════════════════════════════
         بطاقة المعلومات الإضافية
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/space_3">

        <TextView
            android:id="@+id/tvInfoIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕐"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:text="@string/session_locked_info"
            android:textAppearance="@style/TextAppearance.App.Label.Medium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         زر الفتح بالبصمة (الأساسي)
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiometricUnlock"
        style="@style/AppButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/unlock_with_biometric"
        app:icon="@drawable/ic_fingerprint"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_3" />

    <!-- ═══════════════════════════════════════════════════════
         زر تسجيل الخروج (الثانوي)
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/AppButtonStyle.Text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_sm"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/logout"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_2"
        app:iconTint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
