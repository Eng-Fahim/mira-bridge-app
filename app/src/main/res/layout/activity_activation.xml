<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gold_luxury_gradient"
    android:padding="24dp">

    <!-- نقش الموتيف الهندسي الفاخر -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.04"
        android:background="@drawable/ic_jewelry_motif" />

    <!-- شعار أو أيقونة الشركة الملكية -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_gold_diamond" 
        app:tint="@color/gold_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- عنوان الشاشة الفخم -->
    <TextView
        android:id="@+id/tvActivationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="ترخيص نظام ميرا للذهب"
        android:textColor="@color/gold_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <!-- وصف تحفيزي فرعي -->
    <TextView
        android:id="@+id/tvActivationSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="أدخل مفتاح الترخيص الخاص بمنشأتك لتفعيل النظام والبدء بأمان تام"
        android:textColor="@color/gold_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvActivationTitle"
        app:layout_constraintWidth_percent="0.85" />

    <!-- بطاقة الزجاج الفاخرة -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/gold_card_background"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardPreventCornerOverlap="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvActivationSubtitle"
        app:layout_constraintWidth_percent="0.92">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- حقل إدخال السيرفر (مخفي برمجياً) -->
            <!-- ✅ تم تصحيح style هنا -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilServerUrl"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- حقل مفتاح الترخيص -->
            <!-- ✅ تم تصحيح style هنا أيضاً -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLicenseKey"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/gold_accent"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="@color/gold_accent"
                app:startIconDrawable="@drawable/ic_key_gold"
                app:startIconTint="@color/gold_accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLicenseKey"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:fontFamily="sans-serif-medium"
                    android:hint="MIRA-XXXX-XXXX-XXXX"
                    android:inputType="textCapCharacters"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/gold_text_hint"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- رسالة الخطأ -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawableStart="@drawable/ic_error_alert"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="#FF5252"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- حاوية التحميل -->
            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/gold_accent" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="جاري التحقق من الترخيص..."
                    android:textColor="@color/gold_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- زر التفعيل الملكي -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/gold_button_selector"
                android:fontFamily="sans-serif-medium"
                android:text="تفعيل النظام الآن"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="6dp" />

            <!-- زر إعادة المحاولة -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="إعادة المحاولة"
                android:textColor="@color/gold_accent"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:strokeColor="@color/gold_accent"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- تذييل الشاشة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:alpha="0.8"
        android:text="MIRA Gold &amp; Jewelry ERP Systems v2.6"
        android:textColor="@color/gold_text_secondary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
