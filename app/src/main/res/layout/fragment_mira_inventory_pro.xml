<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inventoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:layoutDirection="rtl">

    <!-- ═══════════════════════════════════════════════════════
         Flash Overlay (وميض ملون عند المسح)
         ═══════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:elevation="999dp"
        android:focusable="false"
        android:visibility="visible" />

    <!-- ═══════════════════════════════════════════════════════
         APP BAR
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/inventoryAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="@dimen/elevation_0">

        <!-- 1. STATUS STRIP -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimaryContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_2">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_green" />

            <TextView
                android:id="@+id/tvInventoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:text="جاهز"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="📶 -45"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textDirection="ltr" />

            <TextView
                android:id="@+id/tvElapsedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textDirection="ltr" />
        </LinearLayout>

        <!-- 2. SEGMENTED CONTROL -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/segmentedModes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginHorizontal="@dimen/space_3"
            android:layout_marginTop="@dimen/space_2"
            android:layout_marginBottom="@dimen/space_2"
            app:checkedButton="@id/btnModeFull"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeFull"
                style="@style/AppButtonStyle.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚡ شامل"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeCategory"
                style="@style/AppButtonStyle.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📂 فئوي"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeBlind"
                style="@style/AppButtonStyle.Outlined"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="👁 أعمى"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="150dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 3. LAST SCAN CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lastScanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_2"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/elevation_2"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="220dp"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_status"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_1">

                        <TextView
                            android:id="@+id/tvLastScanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ آخر مسح"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastScanTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="لا توجد مسوحات"
                        android:textAppearance="@style/TextAppearance.App.Title.Large"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/tvLastScanEpc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:alpha="0.8"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="—"
                        android:textAppearance="@style/TextAppearance.App.Label.Medium"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textDirection="ltr" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLastScanKarat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_2"
                            android:alpha="0.5"
                            android:text="•"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/tvLastScanWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00g"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textDirection="ltr" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_2"
                            android:alpha="0.5"
                            android:text="•"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView
                            android:id="@+id/tvLastScanRssi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📶 -50"
                            android:textAppearance="@style/TextAppearance.App.Label.Medium"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastScanStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:background="@drawable/bg_chip_status"
                        android:paddingHorizontal="@dimen/space_4"
                        android:paddingVertical="@dimen/space_1"
                        android:text="✅ مطابق"
                        android:textAppearance="@style/TextAppearance.App.Label.Medium"
                        android:textColor="@color/text_gold_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. PROGRESS BAR CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/AppCardViewStyle.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📊 التقدم"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textAppearance="@style/TextAppearance.App.Title.Medium"
                            android:textColor="@color/text_gold_accent"
                            android:textDirection="ltr" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressScanned"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="@dimen/space_2"
                        android:max="100"
                        android:progress="0"
                        android:progressBackgroundTint="?attr/colorSurfaceVariant"
                        android:progressTint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvScannedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.App.Title.Large"
                            android:textColor="@color/text_gold_accent"
                            android:textDirection="ltr" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_1"
                            android:text="/"
                            android:textAppearance="@style/TextAppearance.App.Body.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvExpectedCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.App.Body.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textDirection="ltr" />

                        <TextView
                            android:id="@+id/tvAccuracy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.App.Label.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textDirection="ltr" />

                        <TextView
                            android:id="@+id/tvVariance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.App.Label.Medium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textDirection="ltr" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. GOLD METRICS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- بطاقة الوزن -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorTertiaryContainer"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="@dimen/elevation_0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:id="@+id/tvTotalWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 g"
                            android:textAppearance="@style/TextAppearance.App.Headline.Small"
                            android:textColor="?attr/colorOnTertiaryContainer"
                            android:textDirection="ltr" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:text="⚖️ الوزن"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- بطاقة القيمة -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="@dimen/elevation_0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:id="@+id/tvTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textAppearance="@style/TextAppearance.App.Headline.Small"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:textDirection="ltr" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:text="💎 القيمة"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 6. ALERTS ROW -->
            <LinearLayout
                android:id="@+id/alertsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_alert_strip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_3"
                android:paddingVertical="@dimen/space_2"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvAlertsText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- 7. ACTION BUTTONS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenItemsList"
                style="@style/AppButtonStyle.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                android:text="📋 عرض قائمة الممسوحات"
                app:icon="@android:drawable/ic_menu_sort_by_size"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakeSnapshot"
                style="@style/AppButtonStyle.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_sm"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_2"
                android:text="📸 حفظ لقطة"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearSession"
                style="@style/AppButtonStyle.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_sm"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_2"
                android:text="🔄 بدء جرد جديد"
                app:icon="@android:drawable/ic_menu_revert"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewSnapshots"
                style="@style/AppButtonStyle.Tonal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_sm"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_2"
                android:text="📂 عرض اللقطات السابقة"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <!-- 8. SEARCH & FILTER (مخفي) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSearchItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/btnLiveFilter"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- 9. EMPTY STATE -->
            <LinearLayout
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_12"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="لا توجد مسوحات بعد"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- RECYCLERVIEW (مخفي) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInventoryItems"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- HIDDEN CONTAINERS (للتوافق مع Java) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPowerControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnArchiveReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════
         10. FLOATING ACTION DOCK
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_3"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="@dimen/radius_2xl"
        app:cardElevation="@dimen/elevation_8"
        app:strokeColor="@color/border_gold"
        app:strokeWidth="@dimen/stroke_normal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_1">

            <!-- زر البدء الرئيسي -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainToggleScan"
                style="@style/AppButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="▶️ بدء جرد RFID"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <!-- زر الطاقة -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPowerControlCompact"
                style="@style/AppButtonStyle.IconTonal"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_marginStart="@dimen/space_1"
                android:contentDescription="Power"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconSize="@dimen/icon_md" />

            <!-- زر التقرير -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateReport"
                style="@style/AppButtonStyle.IconTonal"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_marginStart="@dimen/space_1"
                android:contentDescription="Report"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="@dimen/icon_md" />

            <!-- زر الأرشيف -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArchiveReportsCompact"
                style="@style/AppButtonStyle.IconTonal"
                android:layout_width="@dimen/icon_xl"
                android:layout_height="@dimen/icon_xl"
                android:layout_marginStart="@dimen/space_1"
                android:contentDescription="Archive"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconSize="@dimen/icon_md" />

            <!-- زر الاعتماد -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCommitSession"
                style="@style/AppButtonStyle.Tonal"
                android:layout_width="wrap_content"
