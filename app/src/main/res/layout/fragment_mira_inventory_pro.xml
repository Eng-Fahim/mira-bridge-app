<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inventoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:layoutDirection="rtl">

    <!-- Flash Overlay -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:elevation="999dp"
        android:focusable="false"
        android:visibility="visible" />

    <!-- ═══════════════════════════════════════════════════════
         APP BAR
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/inventoryAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="@dimen/elevation_0">

        <!-- ✨ STATUS STRIP — متكيف مع الوضعين -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scan_status_gradient"
            android:elevation="@dimen/elevation_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_2">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_status_dot_green" />

            <TextView
                android:id="@+id/tvInventoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="جاهز"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="@color/scan_status_text"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="📶 -45"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="@color/scan_status_text"
                android:textDirection="ltr"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvElapsedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="@color/scan_status_text"
                android:textDirection="ltr"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ✨ SEGMENTED CONTROL -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/segmentedModes"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/space_3"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginBottom="@dimen/space_3"
            app:checkedButton="@id/btnModeFull"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeFull"
                style="@style/AppButtonStyle.Segmented"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚡ شامل" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeCategory"
                style="@style/AppButtonStyle.Segmented"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📂 فئوي" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeBlind"
                style="@style/AppButtonStyle.Segmented"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="👁 أعمى" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="150dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════════════════
                 ✨ LAST SCAN CARD — متكيف (Hero-like)
                 ═══════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lastScanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/elevation_2"
                app:strokeColor="@color/scan_hero_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_scan_last_gradient"
                    android:gravity="center"
                    android:minHeight="140dp"
                    android:orientation="vertical"
                    android:padding="@dimen/space_3">

                    <!-- Chip "آخر مسح" -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_scan_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_1">

                        <TextView
                            android:id="@+id/tvLastScanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨ آخر مسح"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="@color/scan_hero_chip_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastScanTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="لا توجد مسوحات"
                        android:textAppearance="@style/TextAppearance.App.Title.Large"
                        android:textColor="@color/scan_hero_title" />

                    <TextView
                        android:id="@+id/tvLastScanEpc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:alpha="0.65"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.App.Label.Medium"
                        android:textColor="@color/scan_hero_secondary"
                        android:textDirection="ltr"
                        android:visibility="gone"
                        tools:text="E280 1160 6000 0204 1B2C"
                        tools:visibility="visible" />

                    <!-- Row: Karat • Weight • RSSI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLastScanKarat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="@color/scan_hero_value" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_2"
                            android:alpha="0.5"
                            android:text="•"
                            android:textColor="@color/scan_hero_secondary" />

                        <TextView
                            android:id="@+id/tvLastScanWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00g"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="@color/scan_hero_value"
                            android:textDirection="ltr" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_2"
                            android:alpha="0.5"
                            android:text="•"
                            android:textColor="@color/scan_hero_secondary" />

                        <TextView
                            android:id="@+id/tvLastScanRssi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="📶 -50"
                            android:textAppearance="@style/TextAppearance.App.Label.Medium"
                            android:textColor="@color/scan_hero_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLastScanStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:background="@drawable/bg_status_chip"
                        android:paddingHorizontal="@dimen/space_4"
                        android:paddingVertical="@dimen/space_1"
                        android:text="✅ مطابق"
                        android:textAppearance="@style/TextAppearance.App.Label.Medium"
                        android:textColor="@color/scan_hero_chip_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════════════
                 ✨ PROGRESS CARD — Warm Surface
                 ═══════════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                app:cardBackgroundColor="@color/scan_card_bg"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="@dimen/elevation_0"
                app:strokeColor="@color/scan_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📊 التقدم"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="0%"
                            android:textColor="@color/scan_hero_title"
                            android:textDirection="ltr"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressScanned"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="@dimen/space_3"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/scan_progress_gold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:weightSum="6">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:gravity="start|center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvScannedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:text="0"
                                android:textColor="@color/scan_hero_title"
                                android:textDirection="ltr"
                                android:textSize="34sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/space_1"
                                android:text="/"
                                android:textAppearance="@style/TextAppearance.App.Title.Large"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvExpectedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="@style/TextAppearance.App.Title.Large"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textDirection="ltr" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="—"
                                android:textColor="@color/success_500"
                                android:textDirection="ltr"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="الدقة"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical"
                            android:background="?attr/colorOutlineVariant"
                            android:alpha="0.3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvVariance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="—"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textDirection="ltr"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="الفرق"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════════════
                 ✨ GOLD METRICS ROW — Weight + Value
                 ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Weight — Warm Surface -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/scan_card_bg"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="@dimen/elevation_0"
                    app:strokeColor="@color/scan_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:id="@+id/tvTotalWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="0.00 g"
                            android:textColor="?attr/colorOnSurface"
                            android:textDirection="ltr"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="⚖️ الوزن"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Value — Golden Adaptive -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/scan_value_bg"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="@dimen/elevation_3">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:id="@+id/tvTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="$0.00"
                            android:textColor="@color/scan_value_text"
                            android:textDirection="ltr"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="💎 القيمة"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="@color/scan_value_label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════
                 ✨ ALERTS ROW — Warm Alert
                 ═══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/alertsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_scan_alert"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_3"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvAlertsText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                    android:textColor="@color/scan_alert_text" />
            </LinearLayout>

            <!-- Fancy Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/space_8"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_gold_divider_gradient" />

            <!-- ═══════════════════════════════════════════════════════
                 ✨ ACTION BUTTONS
                 ═══════════════════════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenItemsList"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_4"
                android:text="📋 عرض قائمة الممسوحات"
                app:icon="@android:drawable/ic_menu_sort_by_size"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_3"
                android:layout_marginTop="@dimen/space_2"
                android:background="@color/scan_card_bg"
                android:orientation="horizontal"
                android:padding="4dp"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakeSnapshot"
                    style="@style/AppButtonStyle.IconTonal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="حفظ لقطة"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconSize="@dimen/icon_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearSession"
                    style="@style/AppButtonStyle.IconTonal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="@dimen/space_1"
                    android:layout_weight="1"
                    android:contentDescription="بدء جرد جديد"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconSize="@dimen/icon_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewSnapshots"
                    style="@style/AppButtonStyle.IconTonal"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:contentDescription="عرض اللقطات"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconSize="@dimen/icon_md" />
            </LinearLayout>

            <!-- SEARCH & FILTER (hidden for Java) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSearchItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/btnClearSearch"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/btnLiveFilter"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- ✨ EMPTY STATE -->
            <LinearLayout
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_12"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_empty_state_gold_circle">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📡"
                        android:textSize="48sp" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:text="لا توجد مسوحات بعد"
                    android:textAppearance="@style/TextAppearance.App.Title.Large"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="ابدأ بمسح أول قطعة للحصول على النتائج"
                    android:textAppearance="@style/TextAppearance.App.Body.Medium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvInventoryItems"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- HIDDEN CONTAINERS (Java compatibility) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPowerControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnArchiveReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════
         ✨ FLOATING DOCK — Warm Surface
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_3"
        app:cardBackgroundColor="@color/scan_card_bg"
        app:cardCornerRadius="@dimen/radius_2xl"
        app:cardElevation="@dimen/elevation_12"
        app:strokeColor="@color/scan_card_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainToggleScan"
                style="@style/AppButtonStyle"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="▶️ بدء الجرد"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPowerControlCompact"
                style="@style/AppButtonStyle.IconTonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_2"
                android:contentDescription="Power"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArchiveReportsCompact"
                style="@style/AppButtonStyle.IconTonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_2"
                android:contentDescription="Archive"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:icon="@android:drawable/ic_menu_agenda"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCommitSession"
                style="@style/AppButtonStyle.Success"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_2"
                android:enabled="false"
                android:text="اعتماد"
                app:icon="@android:drawable/ic_menu_save"
                app:iconSize="@dimen/icon_sm" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
