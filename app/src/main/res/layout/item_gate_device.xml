<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- الصف العلوي: الاسم والحالة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGateName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="البوابة الرئيسية"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGateLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="📍 المدخل الرئيسي"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvGateBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🏢 الفرع الرئيسي"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- ✅ جديد: نوع الجهاز -->
                <TextView
                    android:id="@+id/tvGateDeviceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📱 Chainway C72"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="⚪ غير متصل"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- خط فاصل خفيف داخل البطاقة -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginVertical="8dp"
            android:alpha="0.4"/>

        <!-- الصف السفلي: الإحصائيات وأزرار التحكم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGateStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ 0 | ❌ 0"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGateLastEvent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="لا أحداث"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- ✅ [v2.3] زر الربط بالجهاز -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLinkDevice"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:text="📌 ربط"
                android:textSize="11sp"
                android:minWidth="0dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp" />

            <!-- زر التشغيل/الإيقاف -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleGate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:text="🔓"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="20dp" />

            <!-- زر الحذف -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveGate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:text="🗑"
                android:textSize="14sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconTint="#E74C3C" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
