<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🏢 قسم البوابات -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gate_settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp"/>

        <!-- قائمة البوابات -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGates"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="8dp"/>

        <!-- زر إضافة بوابة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddGate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/add_gate"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="8dp"
            android:layout_marginBottom="16dp"/>

        <!-- خط فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:layout_marginVertical="16dp"/>

        <!-- 🔊 قسم الأصوات -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp"/>

        <!-- صوت النجاح -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_pass"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spSoundPass"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <!-- صوت الرفض -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_deny"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spSoundDeny"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <!-- صوت الإنذار -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_alarm"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spSoundAlarm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <!-- أزرار الصوت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestSound"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="@string/test_sound"
                android:textColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorPrimary"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSounds"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="@string/save_sounds"
                android:textColor="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="8dp"/>
        </LinearLayout>

        <!-- خط فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:layout_marginVertical="16dp"/>

        <!-- ⚙️ قسم إعدادات إضافية -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/additional_settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp"/>

        <!-- الاهتزاز -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/vibration_enabled"
                android:textSize="14sp"
                android:textColor="?attr/colorOnBackground"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- وميض الشاشة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/flash_enabled"
                android:textSize="14sp"
                android:textColor="?attr/colorOnBackground"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchFlash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- مدة الإنذار -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alarm_duration_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etAlarmDuration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:inputType="number"
            android:hint="10"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="12dp"/>

        <!-- قوة RFID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rfid_power_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/seekRfidPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:min="5"
            android:progress="28"
            android:progressTint="?attr/colorPrimary"
            android:thumbTint="?attr/colorPrimary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvRfidPowerValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="28 dBm"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp"/>

        <!-- زر حفظ الكل -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/save_all"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="10dp"/>

    </LinearLayout>
</ScrollView>
