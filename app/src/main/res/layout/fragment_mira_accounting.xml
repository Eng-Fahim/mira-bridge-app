<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 1. شريط العناوين والإحصائيات المزدوجة (ذهب + نقدية) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#1A2530"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAccountingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="نظام ERP المحاسبة المالية والعيارات"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2C3E50"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="الفرع الرئيسي - صنعاء"
                    android:textColor="#ECF0F1"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_my="8dp"
                android:background="#2C3E50" />

            <!-- ملخص مالي ثنائي (نقدية + وزن صافي) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- 1. المبيعات النقدية -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="النقدية المقبوضة"
                        android:textColor="#BDC3C7"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTodayRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0.00 YER"
                        android:textColor="#2ECC71"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. حركة صافي الذهب (عيار 24) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="صافي الحركة (24k)"
                        android:textColor="#BDC3C7"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTotalGoldVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0.000 جرام"
                        android:textColor="#F1C40F"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. حالة التوازن المزدوج -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="توازن الميزان"
                        android:textColor="#BDC3C7"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvBalanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="متوازن ✓"
                        android:textColor="#2ECC71"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 2. أزرار التبديل المحاسبية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabJournal"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="#2980B9"
            android:text="القيود اليومية"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabChartOfAccounts"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="#BDC3C7"
            android:text="دليل الحسابات"
            android:textColor="#2C3E50"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabTrialBalance"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="#BDC3C7"
            android:text="ميزان الذهب والنقدية"
            android:textColor="#2C3E50"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. شريط البحث والتصفية المتقدم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchAccounting"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background"
            android:hint="بحث بالمرجع، RFID، أو الحساب..."
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnRefreshAccounting"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="#34495E"
            android:contentDescription="تحديث البيانات"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 4. ترويسة الجدول الاحترافية (تتضمّن صافي الذهب والنقدية) -->
    <LinearLayout
        android:id="@+id/headerTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A2530"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/thCol1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="المرجع/الرمز"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/thCol2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.8"
            android:paddingStart="6dp"
            android:text="البيان/اسم الحساب"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/thCol3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="صافي 24 (جم)"
            android:textColor="#F1C40F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/thCol4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="center"
            android:text="المبلغ النقدي"
            android:textColor="#2ECC71"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. قائمة عرض البيانات (RecyclerView) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAccountingData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pbAccountingLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="لا توجد قيود أو بيانات محاسبية متوفرة"
            android:textColor="#7F8C8D"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 6. شريط الإجراءات والقيود المركبة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCreateManualEntry"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="#27AE60"
            android:text="+ إنشاء قيد ذهب ونقدية مركب"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
