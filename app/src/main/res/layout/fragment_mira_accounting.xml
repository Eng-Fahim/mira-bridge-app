<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:direction="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. شريط العناوين والإحصائيات السريعة -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1A2530"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAccountingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="النظام المحاسبي والقيود الآلية"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActiveBranch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2C3E50"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="الفرع الرئيسي"
                    android:textColor="#ECF0F1"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ملخص مالي سريع -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- إجمالي الإيرادات -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مبيعات اليوم"
                        android:textColor="#BDC3C7"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTodayRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0.00 YER"
                        android:textColor="#2ECC71"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- إجمالي المدين/الدائن -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حجم القيود"
                        android:textColor="#BDC3C7"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalJournalVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0.00 YER"
                        android:textColor="#3498DB"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- حالة التوازن المحاسبي -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="توازن الميزان"
                        android:textColor="#BDC3C7"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBalanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="متوازن ✓"
                        android:textColor="#2ECC71"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 2. أزرار التبديل بين الأقسام (Chart / Journal / Balance) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabJournal"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#2980B9"
            android:text="القيود اليومية"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabChartOfAccounts"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="#BDC3C7"
            android:text="دليل الحسابات"
            android:textColor="#2C3E50"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabTrialBalance"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#BDC3C7"
            android:text="ميزان المراجعة"
            android:textColor="#2C3E50"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. شريط البحث والتصفية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchAccounting"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background"
            android:hint="بحث بالمرجع، رقم الحساب، أو البيان..."
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnRefreshAccounting"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="#34495E"
            android:contentDescription="تحديث البيانات"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- 4. ترويسة الجدول التوضيحية (تتغير حسب التبويب النشط) -->
    <LinearLayout
        android:id="@+id/headerTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#34495E"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/thCol1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="رقم القيد / الحساب"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/thCol2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="start|center_vertical"
            android:paddingStart="8dp"
            android:text="البيان / اسم الحساب"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/thCol3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="مدين (YER)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/thCol4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="دائن (YER)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5. قائمة عرض البيانات (RecyclerView) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAccountingData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            tools:listitem="@android:layout/simple_list_item_2" />

        <!-- مؤشر التحميل -->
        <ProgressBar
            android:id="@+id/pbAccountingLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- رسالة عدم وجود بيانات -->
        <TextView
            android:id="@+id/tvEmptyData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="لا توجد قيود أو بيانات محاسبية متوفرة حالياً"
            android:textColor="#7F8C8D"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 6. شريط إجراءات إضافة قيد يدوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCreateManualEntry"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#27AE60"
            android:text="+ إضافة قيد محاسبي يدوي"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
