<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ✅ عنوان -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚪 لوحة مراقبة البوابات"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- ✅ العناصر القديمة - مخفية لكنها موجودة للكود -->
            <TextView
                android:id="@+id/tvGateIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚪"
                android:textSize="42sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvGateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 معطلة"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLastEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:visibility="gone" />

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/circle_indicator_red"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spGateSelector"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etManualEpc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="رقم القطعة"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnArmGate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arm"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnDisarmGate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disarm"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSubmitManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnScanBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSimulateAllowed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sim Allowed"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSimulateDenied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sim Denied"
                android:visibility="gone" />

            <!-- ✅ إحصائيات عامة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tvTotalCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="إجمالي: 0"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvPassCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✅ مسموح: 0"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />

                <TextView
                    android:id="@+id/tvDenyCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚨 إنذار: 0"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#C62828" />
            </LinearLayout>

            <!-- ✅ قائمة البوابات الحية -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGatesMonitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp" />

            <!-- ✅ سجل الأحداث -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="8dp">

                <ScrollView
                    android:id="@+id/scrollDebugLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvDebugConsole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚀 جاهز للمراقبة..."
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ✅ غطاء الإنذار -->
    <FrameLayout
        android:id="@+id/overlayAlarm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 إنذار أمني"
                android:textColor="#FFD600"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvOverlayDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopAlarm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔕 إيقاف الإنذار"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
