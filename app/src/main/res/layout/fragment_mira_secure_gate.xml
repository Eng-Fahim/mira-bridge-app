<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGateLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ✅ عنوان -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚪 لوحة مراقبة البوابات"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- ✅ زر تفعيل/إيقاف المسح -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleScan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🛡️ تفعيل مسح RFID"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                android:layout_marginBottom="8dp" />

            <!-- ✅ أزرار المحاكاة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateAllowed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✅ محاكاة مسموح"
                    android:layout_marginEnd="4dp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateDenied"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚨 محاكاة مرفوض"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="8dp" />

                <!-- ✅ بعد أزرار المحاكاة -->
                <com.google.android.material.button.MaterialButton
    android:id="@+id/btnScanBarcode"
    style="@style/Widget.Material3.Button.OutlinedButton"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:text="📷 مسح باركود بالكاميرا"
    android:textSize="14sp"
    app:cornerRadius="8dp"
    android:layout_marginBottom="8dp" />
            </LinearLayout>

            <!-- ✅ إحصائيات عامة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tvTotalCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="إجمالي: 0"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvPassCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✅ مسموح: 0"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />

                <TextView
                    android:id="@+id/tvDenyCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚨 إنذار: 0"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#C62828" />
            </LinearLayout>

            <!-- ✅ قائمة البوابات الحية -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGatesMonitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp" />

            <!-- ✅ سجل الأحداث -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="8dp">

                <ScrollView
                    android:id="@+id/scrollDebugLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvDebugConsole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚀 جاهز للمراقبة..."
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ✅ غطاء الإنذار -->
    <FrameLayout
        android:id="@+id/overlayAlarm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 إنذار أمني"
                android:textColor="#FFD600"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvOverlayDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopAlarm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔕 إيقاف الإنذار"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"/>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
