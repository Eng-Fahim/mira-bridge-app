<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!-- أيقونة البوابة -->
    <TextView
        android:id="@+id/tvGateIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚪"
        android:textSize="72sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" />

    <!-- عنوان -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIRA Secure Gate™"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="البوابة الأمنية الذكية"
        android:textColor="#90A4AE"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <!-- مؤشر الحالة الدائري -->
    <View
        android:id="@+id/statusIndicator"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_indicator_red"
        android:layout_marginBottom="12dp" />

    <!-- نص الحالة -->
    <TextView
        android:id="@+id/tvGateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 البوابة غير مفعلة"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- آخر حدث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:background="#1B2838"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLastEvent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="في انتظار التفعيل..."
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- إحصائيات -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:background="#1B2838"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvPassCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#4CAF50"
                android:textSize="32sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ مصرح"
                android:textColor="#81C784"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvDenyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F44336"
                android:textSize="32sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 ممنوع"
                android:textColor="#EF9A9A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 المجموع"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- أزرار التحكم -->
    <Button
        android:id="@+id/btnArmGate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🛡️ تفعيل البوابة"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnDisarmGate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔒 إيقاف البوابة"
        android:background="#F44336"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp" />

</LinearLayout>
