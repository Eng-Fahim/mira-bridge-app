<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- شريط الأدوات: البحث والفلاتر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="?attr/colorSurfaceVariant">

        <!-- صف 1: الفرع + البحث + التاريخ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerBranch"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginEnd="4dp"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background"
                android:hint="🔍 بحث..."
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="12sp"
                android:inputType="text"/>

            <!-- زر التاريخ -->
<Button
    android:id="@+id/btnFilterDate"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginStart="4dp"
    android:text="الفترة 📅"
    android:textSize="10sp"
    style="@style/Widget.AppCompat.Button.Colored"/>

<!-- ✅ زر التصدير الجديد -->
<Button
    android:id="@+id/btnExport"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginStart="4dp"
    android:text="📥"
    android:textSize="14sp"
    style="@style/Widget.AppCompat.Button.Colored"/>
        </LinearLayout>

        <!-- صف 2: التبويبات + فرعي فقط -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:tabMode="fixed"
                app:tabGravity="fill">
                
                <com.google.android.material.tabs.TabItem android:text="الميزان المالي 💵" />
                <com.google.android.material.tabs.TabItem android:text="ميزان الذهب 🥇" />
            </com.google.android.material.tabs.TabLayout>

            <CheckBox
                android:id="@+id/cbLeafOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="فرعي"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"/>
        </LinearLayout>
    </LinearLayout>

    <!-- KPI Container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/kpiContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"/>
    </HorizontalScrollView>

    <!-- Header العناوين -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorPrimaryContainer">

        <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="الكود" android:textColor="?attr/colorOnPrimaryContainer" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="الحساب" android:textColor="?attr/colorOnPrimaryContainer" android:textSize="11sp" android:textStyle="bold"/>
        
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="أول المدة" android:textColor="?attr/colorOnPrimaryContainer" android:textSize="10sp" android:textStyle="bold" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="حركة الفترة" android:textColor="?attr/colorOnPrimaryContainer" android:textSize="10sp" android:textStyle="bold" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="آخر المدة" android:textColor="?attr/colorOnPrimaryContainer" android:textSize="10sp" android:textStyle="bold" android:gravity="center"/>
    </LinearLayout>

    <!-- ✅ مؤشر التحميل (يظهر فوق الجدول) -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <!-- قائمة الحسابات -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface"
        android:clipToPadding="false"
        android:paddingBottom="16dp"/>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="📭 لا توجد بيانات"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        android:visibility="gone"/>
</LinearLayout>
