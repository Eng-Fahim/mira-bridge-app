<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gold_luxury_gradient"
    android:clipChildren="false">

    <!-- 🌟 نقش الموتيف الهندسي الفاخر (مطابق لشاشة الترخيص) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.04"
        android:background="@drawable/ic_jewelry_motif" />

    <!-- ==================== التوهجات الخفية ==================== -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/radial_glow_gold"
        android:translationX="-60dp"
        android:translationY="-60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bottomGlow"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/radial_glow_gold"
        android:translationX="40dp"
        android:translationY="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView 
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="600dp"
            android:padding="24dp">

            <!-- ==================== الشريط العلوي: اللغة والإصدار ==================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleLanguage"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN / AR"
                android:textColor="@color/gold_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_language"
                app:iconSize="18dp"
                app:iconTint="@color/gold_text_secondary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0.0 Enterprise"
                android:textColor="@color/gold_text_secondary"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/btnToggleLanguage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnToggleLanguage" />

            <!-- ==================== تجميعة المنتصف (الشعار + الكارت) ==================== -->
            <LinearLayout
                android:id="@+id/centerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/tvFooter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnToggleLanguage"
                app:layout_constraintVertical_bias="0.5">

                <!-- الشعار والأنشطة -->
                <LinearLayout
                    android:id="@+id/logoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_logo_glow"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivAppLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_luxury_mira_logo" />
                    </FrameLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBrandName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="MIRA Jewelry Enterprise"
                        android:textColor="@color/gold_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBrandSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MIRA ID™ Smart Jewelry Tag"
                        android:textAllCaps="true"
                        android:textColor="@color/gold_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBrandDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="منظومة التتبع والمصادقة المعتمدة للمجوهرات"
                        android:textAlignment="center"
                        android:textColor="@color/gold_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- كارت تسجيل الدخول الزجاجي -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/loginCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/gold_card_background"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp"
                    app:cardPreventCornerOverlap="true"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvSignInTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="مرحباً بعودتك"
                            android:textAlignment="center"
                            android:textColor="@color/gold_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvSignInSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="20dp"
                            android:text="قم بتسجيل الدخول للمتابعة"
                            android:textAlignment="center"
                            android:textColor="@color/gold_text_secondary"
                            android:textSize="13sp" />

                        <!-- اسم المستخدم -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUsername"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="اسم المستخدم"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/gold_accent"
                            app:hintTextColor="@color/gold_accent"
                            app:startIconDrawable="@drawable/ic_key_gold"
                            app:startIconTint="@color/gold_accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUsername"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:autofillHints="username"
                                android:fontFamily="sans-serif-medium"
                                android:imeOptions="actionNext"
                                android:importantForAutofill="yes"
                                android:inputType="textNoSuggestions"
                                android:textAlignment="viewStart"
                                android:textColor="@color/white"
                                android:textColorHint="@color/gold_text_hint"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- كلمة المرور -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPassword"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:hint="كلمة المرور"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/gold_accent"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/gold_accent"
                            app:hintTextColor="@color/gold_accent"
                            app:startIconDrawable="@drawable/ic_key_gold"
                            app:startIconTint="@color/gold_accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:autofillHints="password"
                                android:fontFamily="sans-serif-medium"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="yes"
                                android:inputType="textPassword"
                                android:textAlignment="viewStart"
                                android:textColor="@color/white"
                                android:textColorHint="@color/gold_text_hint"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- مؤشر حالة القفل -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvLockStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:textColor="#EF5350"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <!-- الأزرار -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:animateLayoutChanges="true"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnLogin"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:backgroundTint="@color/gold_button_selector"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="تسجيل الدخول"
                                    android:textColor="#1A1A1A"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="16dp"
                                    app:elevation="6dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBiometric"
                                    style="@Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_marginStart="12dp"
                                    android:padding="0dp"
                                    android:visibility="gone"
                                    app:cornerRadius="16dp"
                                    app:icon="@drawable/ic_fingerprint"
                                    app:iconPadding="0dp"
                                    app:iconSize="28dp"
                                    app:iconTint="@color/gold_accent"
                                    app:strokeColor="@color/gold_accent"
                                    app:strokeWidth="1.5dp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <!-- إعدادات الخادم -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvServerSettings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="18dp"
                            android:padding="6dp"
                            android:text="🔧 إعدادات الخادم والاتصال (Server Settings)"
                            android:textColor="@color/gold_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/serverConfigCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/bg_gold_soft"
                            app:cardCornerRadius="16dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilServerUrl"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="رابط الخادم (Server URL)"
                                    app:boxStrokeColor="@color/gold_accent"
                                    app:hintTextColor="@color/gold_accent">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etServerUrl"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:importantForAutofill="no"
                                        android:inputType="textUri"
                                        android:textColor="@color/white"
                                        android:textSize="13sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSaveServer"
                                    style="@Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="حفظ الإعدادات"
                                    android:textColor="@color/gold_accent"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="@color/gold_accent" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ==================== التذييل ثابت بأسفل الواجهة ==================== -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="MIRA Trust Architecture™\nGlobal Standards &amp; RFID Solutions"
                android:textColor="@color/gold_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- successOverlay كامل الشاشة مع Elevation مرتفع -->
    <LinearLayout
        android:id="@+id/successOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:background="@color/gold_card_background"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_gold_diamond"
            app:tint="@color/gold_accent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSuccessMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تم تسجيل الدخول بنجاح"
            android:textColor="@color/gold_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/gold_accent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
