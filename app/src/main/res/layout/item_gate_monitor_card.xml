<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardGate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- رأس الكرت: مؤشر الحالة واسم البوابة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/vGateStatusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_indicator_green"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvGateName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GATE-01"
                android:textStyle="bold"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvGateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مسلحة"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- اسم الفرع إن وجد -->
        <TextView
            android:id="@+id/tvBranchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🏢 الفرع"
            android:textSize="11sp"
            android:visibility="gone"/>

        <!-- الموقع -->
        <TextView
            android:id="@+id/tvGateLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📍 الموقع"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <!-- خط فاصل خفيف -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginVertical="8dp"/>

        <!-- الإحصائيات (عابر / مرفوض) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مرور"
                    android:textSize="10sp"/>
                <TextView
                    android:id="@+id/tvPassCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إنذار"
                    android:textSize="10sp"/>
                <TextView
                    android:id="@+id/tvDenyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorError"/>
            </LinearLayout>
        </LinearLayout>

        <!-- آخر حدث -->
        <TextView
            android:id="@+id/tvGateLastEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="لا أحداث"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>

                <!-- زر التحكم السريع بالبوابة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSingleGate"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="إغلاق"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:iconGravity="textStart"
            app:iconSize="14dp"/>


    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
