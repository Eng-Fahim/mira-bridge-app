<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. شريط علوي فاخر وهادئ بدل الذهبي الساطع الفاقع -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/ToolbarTitleStyle"
            app:titleTextColor="?attr/colorOnSurface"
            app:menu="@menu/main_menu"
            app:popupTheme="@style/CustomOverflowMenu"
            app:elevation="0dp" />

        <!-- 2. شريط المؤشرات السريع بتصميم ناعم ومفصول بظلال خفيفة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">
            
            <!-- مؤشر حالة الاتصال -->
            <LinearLayout
                android:id="@+id/btnHardwareStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_luxury_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_status_dot_green" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_connected"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- أدوات التحكم والبحث -->
            <ImageButton
                android:id="@+id/btnSubSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_quick_search"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnSubSync"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_sync_data"
                app:srcCompat="@drawable/ic_sync"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- 3. حاوية العرض الرئيسية -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="64dp"
            android:clipToPadding="false"
            android:background="?attr/android:colorBackground" />

    </LinearLayout>

    <!-- 4. شريط التنقل السفلي الفاخر (Material 3 Dock) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        app:elevation="12dp"
        app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/nav_item_color_selector"
        app:itemRippleColor="@color/nav_item_color_selector"
        app:itemTextColor="@color/nav_item_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- 5. الزر الذهبي الأوسط الفاخر (Floating Action Button) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabActionCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:contentDescription="@string/nav_actions"
        app:backgroundTint="?attr/colorPrimary"
        app:strokeColor="?attr/colorSurface"
        app:strokeWidth="4dp"
        app:elevation="8dp"
        app:fabSize="normal"
        app:maxImageSize="26dp"
        app:srcCompat="@drawable/ic_gold_gem"
        app:tint="#FFFFFF" />

    <!-- 6. شاشة التحميل Overlay -->
    <LinearLayout
        android:id="@+id/successOverlayMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1F0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:alpha="0.0"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="?attr/colorPrimary" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
