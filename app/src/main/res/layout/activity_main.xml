<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- الشريط العلوي الرئيسي (Toolbar) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="@string/app_name"
            app:titleTextColor="?attr/colorOnPrimary"
            app:menu="@menu/main_menu"
            app:popupTheme="@style/CustomOverflowMenu">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- زر حالة العتاد والأجهزة المتصلة -->
                <LinearLayout
                    android:id="@+id/btnHardwareStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_green" />

                    <TextView
                        android:id="@+id/tvHardwareStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/hardware_connected"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- حاوية المحتوى الرئيسية للـ Fragments مع حماية الفوتر من التداخل -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="68dp"
            android:clipToPadding="false"
            android:background="?attr/colorSurface" />

    </LinearLayout>

    <!-- شريط التنقل السفلي المتوافق تماماً مع الثيم -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_color_selector"
        app:itemRippleColor="?attr/colorPrimary"
        app:itemTextColor="@color/nav_item_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- الزر العائم الأوسط -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabActionCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:contentDescription="@string/nav_actions"
        app:backgroundTint="?attr/colorPrimary"
        app:strokeColor="?attr/colorSurface"
        app:strokeWidth="3dp"
        app:elevation="14dp"
        app:fabSize="normal"
        app:maxImageSize="28dp"
        app:srcCompat="@drawable/ic_gold_gem"
        app:tint="?attr/colorOnPrimary" />

    <!-- طبقة السنابر والتحميل التفاعلية أثناء التنقل -->
    <LinearLayout
        android:id="@+id/successOverlayMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:alpha="0.0"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="?attr/colorPrimary" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
