<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRowCode"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="1301"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRowName"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="مخزون الذهب"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- أول المدة -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvOpenDebit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#3498DB" android:textSize="9sp" android:gravity="center"/>
            <TextView android:id="@+id/tvOpenCredit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#E74C3C" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- حركة الفترة -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvPeriodDebit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#3498DB" android:textSize="9sp" android:gravity="center"/>
            <TextView android:id="@+id/tvPeriodCredit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#E74C3C" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <!-- آخر المدة -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tvCloseDebit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#27AE60" android:textSize="9sp" android:textStyle="bold" android:gravity="center"/>
            <TextView android:id="@+id/tvCloseCredit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#C0392B" android:textSize="9sp" android:textStyle="bold" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- شريط الذهب -->
    <TextView
        android:id="@+id/tvRowGold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#1AD4AF37" 
        android:padding="3dp"
        android:text="ذهب: 0g"
        android:textColor="@color/mira_gold"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="end"
        android:visibility="gone"/>
</LinearLayout>
