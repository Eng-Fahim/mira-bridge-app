<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRowCode"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="1301"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مخزون الذهب"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvRowDebit"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:gravity="end"/>

        <TextView
            android:id="@+id/tvRowCredit"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="?attr/colorError"
            android:textSize="11sp"
            android:gravity="end"/>

        <TextView
            android:id="@+id/tvRowBalance"
            android:layout_width="75dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/success_500"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end"/>
    </LinearLayout>

    <!-- شريط الذهب (يظهر فقط إذا كان للحساب حركة ذهبية) -->
    <TextView
        android:id="@+id/tvRowGold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#1AD4AF37" 
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="مدين: 0g | دائن: 0g | الرصيد: 0g"
        android:textColor="@color/mira_gold"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="end"
        android:visibility="gone"/>
</LinearLayout>
