<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- الكود -->
        <TextView
            android:id="@+id/tvRowCode"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:gravity="center"
            android:textColor="#64748B" />

        <!-- اسم الحساب -->
        <TextView
            android:id="@+id/tvRowName"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- أول المدة -->
        <TextView android:id="@+id/tvOpenDebit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="center" android:textColor="#3B82F6" />
        <TextView android:id="@+id/tvOpenCredit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="center" android:textColor="#EF4444" />

        <!-- حركة الفترة -->
        <TextView android:id="@+id/tvPeriodDebit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="center" android:textColor="#3B82F6" />
        <TextView android:id="@+id/tvPeriodCredit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:gravity="center" android:textColor="#EF4444" />

        <!-- آخر المدة -->
        <TextView android:id="@+id/tvCloseDebit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textColor="#2563EB" />
        <TextView android:id="@+id/tvCloseCredit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:textColor="#DC2626" />

    </LinearLayout>

    <!-- شريط الذهب الصغير (يظهر فقط في وضع المال) -->
    <TextView
        android:id="@+id/tvRowGold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="4dp"
        android:textColor="#B08D57" />

</LinearLayout>
