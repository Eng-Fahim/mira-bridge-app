<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ==================== SHIMMER LOADING ==================== -->
    <LinearLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/shimmer_background" />
    </LinearLayout>

    <!-- ==================== LOADING OVERLAY ==================== -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.95">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_data"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ==================== MAIN CONTENT ==================== -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ==================== 1. HERO BALANCE CARD ==================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroBalanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/total_inventory_value"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                tools:text="💰 إجمالي قيمة المخزون" />

                            <ImageButton
                                android:id="@+id/btnToggleHeroVisibility"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="4dp"
                                android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:id="@+id/tvHeroTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_status"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                tools:text="📈 +2.4%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_sparkline_placeholder"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_inventory_value"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="11sp"
                                android:alpha="0.75" />

                            <TextView
                                android:id="@+id/tvHeroBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="••••••••"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:textDirection="ltr"
                                android:letterSpacing="-0.02"
                                tools:text="$81,647.51" />

                            <TextView
                                android:id="@+id/tvHeroSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="11sp"
                                android:alpha="0.8"
                                tools:text="👑 7 قطع • 615.0g" />
                        </LinearLayout>

                        <!-- ✅ القيمة بـ 3 عملات -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroValueYER"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textDirection="ltr"
                                    tools:text="12,450,000" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="🇾🇪 ريال يمني"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textSize="10sp"
                                    android:alpha="0.75" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroValueSAR"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textDirection="ltr"
                                    tools:text="306,150" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="🇸🇦 ريال سعودي"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textSize="10sp"
                                    android:alpha="0.75" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroValueUSD"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textDirection="ltr"
                                    tools:text="81,647.51" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="🇺🇸 دولار أمريكي"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textSize="10sp"
                                    android:alpha="0.75" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:id="@+id/heroSparkline"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==================== 2. ALERTS STRIP ==================== -->
                <LinearLayout
                    android:id="@+id/alertsStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_alert_strip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvAlertIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvAlertMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="3 قطع بحاجة إلى تحديث الأسعار" />

                    <TextView
                        android:id="@+id/tvAlertAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عرض →"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ==================== 3. INVENTORY METRICS ==================== -->
                <LinearLayout
                    android:id="@+id/inventoryMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_inventory_items"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/total_items"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalItems"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="7" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_weight_scale"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/total_weight"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textDirection="ltr"
                                tools:text="615.0 g" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sold_today"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/sold_today"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvSoldToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ==================== 4. GOLD PRICES ==================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoldPrices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/live_gold_prices"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">

                                <ImageButton
                                    android:id="@+id/btnRefreshGold"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/refresh_gold_prices"
                                    android:src="@android:drawable/ic_popup_sync"
                                    app:tint="?attr/colorPrimary" />

                                <ProgressBar
                                    android:id="@+id/pbGoldLoading"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:indeterminate="true"
                                    android:indeterminateTint="?attr/colorPrimary"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvGoldTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                tools:text="📊" />

                            <TextView
                                android:id="@+id/tvGoldChange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="-0.00%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_luxury_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ounce_price"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvOuncePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textDirection="ltr"
                                tools:text="$4,282.33" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <TextView
                                android:id="@+id/tvGoldPrice18"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textDirection="ltr"
                                tools:text="18K: $103.26/g" />

                            <TextView
                                android:id="@+id/tvGoldPrice21"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textDirection="ltr"
                                tools:text="21K: $120.47/g" />

                            <TextView
                                android:id="@+id/tvGoldPrice24"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textDirection="ltr"
                                tools:text="24K: $137.68/g" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/tvPriceSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp"
                                tools:text="📡 GoldAPI" />

                            <TextView
                                android:id="@+id/tvLastUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="10sp"
                                tools:text="⏰ آخر تحديث: 21:54:26" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==================== 5. SALES SUMMARY ==================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/salesSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sales_summary"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="📈 ملخص المبيعات" />

                            <ImageButton
                                android:id="@+id/btnToggleSalesVisibility"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="4dp"
                                android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sales_today"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvSalesToday"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="••••••"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="3,798,900 YER" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sales_month"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvSalesMonth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="••••••"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="3,798,900 YER" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sales_year"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/tvSalesYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="••••••"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="3,798,900 YER" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ==================== 6. RECENT ACTIVITY TIMELINE ==================== -->
                <LinearLayout
                    android:id="@+id/recentActivityHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ آخر العمليات"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewAllActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="عرض الكل →"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_activity_timeline" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
