<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- SHIMMER LOADING -->
    <LinearLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_h"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View android:layout_width="match_parent" android:layout_height="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_4" android:background="@drawable/shimmer_background" />
        <View android:layout_width="match_parent" android:layout_height="100dp"
            android:layout_marginBottom="@dimen/space_4" android:background="@drawable/shimmer_background" />
        <View android:layout_width="match_parent" android:layout_height="160dp"
            android:layout_marginBottom="@dimen/space_4" android:background="@drawable/shimmer_background" />
        <View android:layout_width="match_parent" android:layout_height="120dp"
            android:background="@drawable/shimmer_background" />
    </LinearLayout>

    <!-- LOADING OVERLAY -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.95">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_data"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_6">

                <!-- ═══════════════════════════════════════════════════
     CAROUSEL: البطاقات (احترافية وتدعم الثيمات)
     ═══════════════════════════════════════════════════ -->
<HorizontalScrollView
    android:id="@+id/horizontalScrollCarousel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:clipToPadding="false"
    android:paddingHorizontal="40dp"
    android:scrollbars="none"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/cardsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 1. LIVE GOLD PRICES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGoldPrices"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="@color/gold_card_bg"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/gold_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="أسعار الذهب (دولار/جرام)"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true">

                        <ImageButton
                            android:id="@+id/btnRefreshGold"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_popup_sync"
                            app:tint="@color/gold_text_accent" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/pbGoldLoading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/gold_text_accent"
                            app:indicatorSize="16dp"
                            app:trackThickness="2dp" />
                    </FrameLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gold_ounce_box"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="سعر الأونصة العالمي"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvOuncePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="$0.00"
                        android:textColor="@color/gold_text_accent"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/tvGoldPrice24"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/gold_text_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGoldPrice21"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvGoldPrice18"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGoldTrend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvGoldChange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvPriceSource"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. HERO BALANCE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroBalanceCard"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/gold_card_stroke"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="260dp"
                android:background="@drawable/bg_hero_gold_gradient">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="إجمالي قيمة المخزون"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnToggleHeroVisibility"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_eye_off"
                            app:tint="#FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="••••••••"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0.0 g"
                        android:textColor="#E0D1A8"
                        android:textSize="14sp" />
                        
                    <!-- أضف باقي عناصر بطاقة الهيرو هنا كما كانت لديك -->
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. SALES SUMMARY CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/salesSummaryCard"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="@color/gold_card_bg"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/gold_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="260dp"
                android:orientation="vertical"
                android:padding="20dp">
                
                <!-- محتوى بطاقة المبيعات -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📈 ملخص المبيعات"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                    
                <!-- أضف باقي عناصر المبيعات هنا -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</HorizontalScrollView>

                <!-- Dots Indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View android:id="@+id/dot1" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginHorizontal="4dp" android:background="@drawable/dot_active" />
                    <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginHorizontal="4dp" android:background="@drawable/dot_inactive" />
                    <View android:id="@+id/dot3" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginHorizontal="4dp" android:background="@drawable/dot_inactive" />
                </LinearLayout>

                <!-- بقية الأقسام -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_padding_h">

                    <!-- ALERTS STRIP -->
                    <LinearLayout
                        android:id="@+id/alertsStrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        android:background="@drawable/bg_alert_strip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_4"
                        android:paddingVertical="@dimen/space_3"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvAlertIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tvAlertMessage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.App.Body.Small"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="3 قطع بحاجة إلى تحديث الأسعار" />

                        <TextView
                            android:id="@+id/tvAlertAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/view_arrow"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- INVENTORY BY KARAT -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardInventoryByKarat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_inventory_items"
                                    app:tint="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:layout_weight="1"
                                    android:text="@string/inventory_by_karat"
                                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageButton
                                    android:id="@+id/btnToggleInventoryVisibility"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/toggle_visibility"
                                    android:padding="2dp"
                                    android:src="@drawable/ic_eye_off"
                                    app:tint="?attr/colorPrimary" />
                            </LinearLayout>

                            <HorizontalScrollView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:clipToPadding="false"
                                android:scrollbars="none"
                                android:layoutDirection="rtl">

                                <LinearLayout
                                    android:id="@+id/llInventoryByKarat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:showDividers="middle"
                                    android:divider="@drawable/divider_vertical_gold"
                                    android:dividerPadding="10dp" />
                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/tvKaratEmptyState"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:gravity="center"
                                android:paddingVertical="@dimen/space_4"
                                android:text="@string/no_data"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SCRAP GOLD SUMMARY -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardScrapGold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_gold_scrap"
                                    app:tint="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:layout_weight="1"
                                    android:text="@string/scrap_gold_summary"
                                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageButton
                                    android:id="@+id/btnToggleScrapVisibility"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/toggle_visibility"
                                    android:padding="2dp"
                                    android:src="@drawable/ic_eye_off"
                                    app:tint="?attr/colorPrimary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/net_weight_24k"
                                        android:textAppearance="@style/TextAppearance.App.Label.Small"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/tvScrapWeight"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:text="••••••"
                                        android:textAppearance="@style/TextAppearance.App.Number.Small"
                                        android:textColor="@color/text_gold_accent" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="?attr/colorOutlineVariant"
                                    android:alpha="0.5" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/estimated_value"
                                        android:textAppearance="@style/TextAppearance.App.Label.Small"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/tvScrapValue"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/space_1"
                                        android:text="••••••"
                                        android:textAppearance="@style/TextAppearance.App.Number.Small"
                                        android:textColor="?attr/colorOnSurface" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:orientation="horizontal"
                                android:weightSum="3">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnOpenScrapBuy"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/scrap_buy_new"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="10sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnOpenScrapHistory"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/scrap_history"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="10sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnOpenScrapBatches"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/scrap_batches"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SCRAP AGING -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardScrapAging"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvAgingStatusIcon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🟢"
                                    android:textSize="20sp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:layout_weight="1"
                                    android:text="@string/scrap_aging_title"
                                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvAgingStatusLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/status_healthy"
                                    android:textColor="#16A34A"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/scrap_unfiltered_weight"
                                        android:textAppearance="@style/TextAppearance.App.Label.Small"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/tvAgingWeight"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0.000 g"
                                        android:textAppearance="@style/TextAppearance.App.Number.Small"
                                        android:textColor="@color/text_gold_accent"
                                        android:layout_marginTop="@dimen/space_1" />
                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="?attr/colorOutlineVariant"
                                    android:alpha="0.5" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/scrap_invoice_count"
                                        android:textAppearance="@style/TextAppearance.App.Label.Small"
                                        android:textColor="?attr/colorOnSurfaceVariant" />

                                    <TextView
                                        android:id="@+id/tvAgingCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textAppearance="@style/TextAppearance.App.Number.Small"
                                        android:textColor="?attr/colorOnSurface"
                                        android:layout_marginTop="@dimen/space_1" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llAgingAlert"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:background="@color/alert_bg_danger"
                                android:padding="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚠️"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvAgingAlertText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/aging_alert_default"
                                    android:textColor="@color/alert_text_danger"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenAgingReport"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/scrap_aging_report"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SALES TREND CHART -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSalesTrend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chart_sales_trend_title"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/lineChartSales"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_marginTop="@dimen/space_3" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SALES BY KARAT CHART -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSalesByKarat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chart_sales_by_karat_title"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChartKarat"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_marginTop="@dimen/space_3" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- RECENT ACTIVITY HEADER -->
                    <LinearLayout
                        android:id="@+id/recentActivityHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_activity_title"
                            android:textAppearance="@style/TextAppearance.App.Title.Small"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvViewAllActivity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:paddingHorizontal="@dimen/space_2"
                            android:paddingVertical="@dimen/space_1"
                            android:text="@string/view_all_arrow"
                            android:textAppearance="@style/TextAppearance.App.Label.Large"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llRecentActivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        android:orientation="vertical" />

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
