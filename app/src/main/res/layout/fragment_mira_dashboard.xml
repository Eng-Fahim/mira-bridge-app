<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- SHIMMER LOADING -->
    <LinearLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_h"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View android:layout_width="match_parent" android:layout_height="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_4" android:background="@drawable/shimmer_background" />
        <View android:layout_width="match_parent" android:layout_height="100dp"
            android:layout_marginBottom="@dimen/space_4" android:background="@drawable/shimmer_background" />
        <View android:layout_width="match_parent" android:layout_height="160dp"
            android:layout_marginBottom="@dimen/space_4" android:background="@drawable/shimmer_background" />
    </LinearLayout>

    <!-- LOADING OVERLAY -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.95">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_data"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- ═══════════════════════════════════════════════════
                     1. HERO BALANCE CARD (الملك الفاخر للواجهة)
                     ═══════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroBalanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/hero_stroke"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_hero_gold_gradient" />
                        <View android:layout_width="180dp" android:layout_height="180dp"
                            android:layout_gravity="top|end" android:background="@drawable/bg_hero_glow" />
                        <View android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="@drawable/bg_diamond_pattern" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- Header Badge & Visibility -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_mira_badge"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp">

                                    <ImageView android:layout_width="12dp" android:layout_height="12dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_diamond" app:tint="@color/hero_title_text" />

                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp" android:fontFamily="sans-serif-medium"
                                        android:letterSpacing="0.1" android:text="MIRA ID™"
                                        android:textColor="@color/hero_title_text" android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                                <ImageButton
                                    android:id="@+id/btnToggleHeroVisibility"
                                    android:layout_width="36dp" android:layout_height="36dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/toggle_visibility"
                                    android:padding="6dp" android:src="@drawable/ic_eye_off"
                                    app:tint="@color/hero_title_text" />
                            </LinearLayout>

                            <!-- Balance Main Value -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:alpha="0.8" android:text="@string/total_inventory_value"
                                    android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                    android:textColor="@color/hero_label_text" />

                                <TextView
                                    android:id="@+id/tvHeroBalance"
                                    android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp" android:text="••••••••"
                                    android:textAppearance="@style/TextAppearance.App.Number.OnGold.Hero"
                                    android:textColor="@color/hero_value_text"
                                    tools:text="$52,798.66" />
                            </LinearLayout>

                            <!-- Sub-chips (Weight & Items) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:background="@drawable/bg_hero_chip"
                                    android:gravity="center_vertical" android:orientation="horizontal"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp">

                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="⚖" android:textColor="@color/hero_title_text" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvHeroSubtitle"
                                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp" android:text="0.0 g"
                                        android:textAppearance="@style/TextAppearance.App.Number.OnGold.Small"
                                        android:textColor="@color/hero_value_text" tools:text="374.0 g" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_hero_chip"
                                    android:gravity="center_vertical" android:orientation="horizontal"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="6dp">

                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="◈" android:textColor="@color/hero_title_text" android:textSize="12sp" />
                                    <TextView android:id="@+id/tvHeroItemCount"
                                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp" android:text="0 قطعة"
                                        android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                        android:textColor="@color/hero_value_text" tools:text="6 قطعة" />
                                </LinearLayout>
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginTop="14dp" android:layout_marginBottom="12dp"
                                android:background="@color/hero_divider" />

                            <!-- Multi-Currency Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="3">

                                <!-- USD -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇺🇸 USD" android:textColor="@color/hero_secondary_text" android:textSize="10sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvHeroValueUSD" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="••••••" android:textColor="@color/hero_value_text" android:textSize="12sp" android:textStyle="bold" tools:text="52,798" />
                                </LinearLayout>

                                <!-- SAR -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇸🇦 SAR" android:textColor="@color/hero_secondary_text" android:textSize="10sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvHeroValueSAR" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="••••••" android:textColor="@color/hero_secondary_text" android:textSize="12sp" tools:text="197,994" />
                                </LinearLayout>

                                <!-- YER -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🇾🇪 YER" android:textColor="@color/hero_secondary_text" android:textSize="10sp" android:textStyle="bold"/>
                                    <TextView android:id="@+id/tvHeroValueYER" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="••••••" android:textColor="@color/hero_secondary_text" android:textSize="12sp" tools:text="27,983,290" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════
                     2. LIVE GOLD PRICES (نبض السوق الفوري)
                     ═══════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoldPrices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_surface_warm"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke_warm"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">

                            <TextView 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true" 
                                android:layout_centerVertical="true"
                                android:text="@string/live_gold_prices"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <FrameLayout 
                                android:layout_width="32dp" 
                                android:layout_height="32dp"
                                android:layout_alignParentEnd="true" 
                                android:layout_centerVertical="true">

                                <ImageButton 
                                    android:id="@+id/btnRefreshGold"
                                    android:layout_width="32dp" 
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/refresh_gold_prices"
                                    android:src="@android:drawable/ic_popup_sync"
                                    app:tint="?attr/colorPrimary" />

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/pbGoldLoading"
                                    android:layout_width="wrap_content" 
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center" 
                                    android:indeterminate="true"
                                    android:visibility="gone" 
                                    app:indicatorColor="?attr/colorPrimary"
                                    app:indicatorSize="18dp" 
                                    app:trackThickness="2dp" />
                            </FrameLayout>
                        </RelativeLayout>

                        <!-- Ounce Box -->
                        <LinearLayout
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_luxury_card" 
                            android:gravity="center"
                            android:orientation="vertical" 
                            android:paddingVertical="12dp">

                            <TextView 
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content"
                                android:text="@string/ounce_price"
                                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView 
                                android:id="@+id/tvOuncePrice"
                                android:layout_width="wrap_content" 
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.App.Number.Large"
                                android:textColor="@color/text_gold_accent" 
                                tools:text="$4,282.33" />
                        </LinearLayout>

                        <!-- Karats Row -->
                        <LinearLayout
                            android:layout_width="match_parent" 
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" 
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <TextView 
                                android:id="@+id/tvGoldPrice18"
                                android:layout_width="0dp" 
                                android:layout_height="wrap_content"
                                android:layout_weight="1" 
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurface" 
                                tools:text="18K: $103.26" />
                                
                            <TextView 
                                android:id="@+id/tvGoldPrice21"
                                android:layout_width="0dp" 
                                android:layout_height="wrap_content"
                                android:layout_weight="1" 
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurface" 
                                tools:text="21K: $120.47" />
                                
                            <TextView 
                                android:id="@+id/tvGoldPrice24"
                                android:layout_width="0dp" 
                                android:layout_height="wrap_content"
                                android:layout_weight="1" 
                                android:gravity="center"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_gold_accent" 
                                tools:text="24K: $137.68" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════
                     3. ALERTS STRIP
                     ═══════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/alertsStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_alert_strip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView android:id="@+id/tvAlertIcon"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚠️" android:textSize="16sp" />

                    <TextView android:id="@+id/tvAlertMessage"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="3 قطع بحاجة إلى تحديث الأسعار" />

                    <TextView android:id="@+id/tvAlertAction"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="عرض →" android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════
                     4. INVENTORY BY KARAT (المخزون حسب العيار)
                     ═══════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInventoryByKarat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_surface_warm"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke_warm"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_inventory_items"
                                app:tint="?attr/colorPrimary" />

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_marginStart="10dp" android:layout_weight="1"
                                android:text="@string/inventory_by_karat"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageButton android:id="@+id/btnToggleInventoryVisibility"
                                android:layout_width="32dp" android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="4dp" android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:clipToPadding="false"
                            android:scrollbars="none" android:layoutDirection="rtl">

                            <LinearLayout android:id="@+id/llInventoryByKarat"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="horizontal" android:gravity="center_vertical"
                                android:showDividers="middle" android:divider="@drawable/divider_vertical_gold"
                                android:dividerPadding="8dp" />
                        </HorizontalScrollView>

                        <TextView android:id="@+id/tvKaratEmptyState"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:gravity="center"
                            android:paddingVertical="16dp" android:text="@string/no_data"
                            android:textAppearance="@style/TextAppearance.App.Label.Small"
                            android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone"
                            tools:text="لا توجد بيانات" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════
                     5. SCRAP GOLD & AGING (كسر الذهب وأعمار المخزون ببطاقة واحدة منظمة)
                     ═══════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardScrapGold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_surface_warm"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke_warm"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_gold_scrap"
                                app:tint="?attr/colorPrimary" />

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_marginStart="10dp" android:layout_weight="1"
                                android:text="@string/scrap_gold_summary"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageButton android:id="@+id/btnToggleScrapVisibility"
                                android:layout_width="32dp" android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="4dp" android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:gravity="center"
                                android:orientation="vertical">

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/net_weight_24k"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView android:id="@+id/tvScrapWeight"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Number.Small"
                                    android:textColor="@color/text_gold_accent" tools:text="152.35 g" />
                            </LinearLayout>

                            <View android:layout_width="1dp" android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant" android:alpha="0.4" />

                            <LinearLayout
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:gravity="center"
                                android:orientation="vertical">

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/estimated_value"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView android:id="@+id/tvScrapValue"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Number.Small"
                                    android:textColor="?attr/colorOnSurface" tools:text="$10,800.00" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Scrap Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginTop="12dp"
                            android:weightSum="3">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenScrapBuy"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="➕ شراء جديد"
                                android:textColor="?attr/colorPrimary" android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenScrapHistory"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="📋 السجل"
                                android:textColor="?attr/colorPrimary" android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenScrapBatches"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="📦 الدفعات"
                                android:textColor="?attr/colorPrimary" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════
                     6. SALES SUMMARY & ANALYTICS (ملخص المبيعات والرسوم)
                     ═══════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/salesSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/card_surface_warm"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke_warm"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal">

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="@string/sales_summary"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageButton android:id="@+id/btnToggleSalesVisibility"
                                android:layout_width="32dp" android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="4dp" android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:baselineAligned="false"
                            android:orientation="horizontal" android:weightSum="3">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sales_today" android:textSize="10sp" android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/tvSalesToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="••••••" android:textSize="11sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" tools:text="3.7M YER" />
                            </LinearLayout>

                            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant" android:alpha="0.4" />

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sales_month" android:textSize="10sp" android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/tvSalesMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="••••••" android:textSize="11sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" tools:text="14.2M YER" />
                            </LinearLayout>

                            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant" android:alpha="0.4" />

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sales_year" android:textSize="10sp" android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/tvSalesYear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="••••••" android:textSize="11sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" tools:text="45.9M YER" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Charts Section Container (Compact and Clean) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Sales Trend Chart -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSalesTrend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📈 حركة المبيعات (7 أيام)"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/lineChartSales"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Sales By Karat Chart -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSalesByKarat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/card_surface_warm"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/card_stroke_warm"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🥧 توزيع المبيعات حسب العيار"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <com.github.mikephil.charting.charts.PieChart
                                android:id="@+id/pieChartKarat"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════
                     7. RECENT ACTIVITY (آخر العمليات)
                     ═══════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/recentActivityHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="⚡ آخر العمليات"
                        android:textAppearance="@style/TextAppearance.App.Title.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView android:id="@+id/tvViewAllActivity"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="8dp" android:paddingVertical="4dp"
                        android:text="عرض الكل →"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
