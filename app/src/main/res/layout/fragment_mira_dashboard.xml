<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ═══════════════════════════════════════════════════════
         SHIMMER LOADING
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_h"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/shimmer_background" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         LOADING OVERLAY
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:alpha="0.95">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/loading_data"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_6">

              <!-- ═══════════════════════════════════════════════════════
     1. HERO BALANCE CARD — البطاقة الذهبية الفاخرة
     ═══════════════════════════════════════════════════════ -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/heroBalanceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_6"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_gold_metallic"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: العنوان + زر الإخفاء + شارة النسبة -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 إجمالي قيمة المخزون"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnToggleHeroVisibility"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_visibility"
                    android:padding="4dp"
                    android:src="@drawable/ic_eye_off"
                    app:tint="@color/pure_white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroTrend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_on_gold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="📈 +2.4%"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="@color/pure_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Main Value Block: الرقم القياسي الفاخر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.9"
                android:text="القيمة التقديرية الحالية"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="@color/pure_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHeroBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#40000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:text="$81,647.51"
                android:textAppearance="@style/TextAppearance.App.Display.Large"
                android:textColor="@color/pure_white"
                android:textDirection="ltr"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.95"
                android:text="👑 7 قطع • 615.0g"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="@color/pure_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Separator Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:alpha="0.25"
            android:background="@color/pure_white" />

        <!-- Sub Values: العملات الثلاث (YER / SAR / USD) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- YER -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroValueYER"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12,450,000"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textDirection="ltr"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:text="🇾🇪 ريال يمني"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="@color/pure_white"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.25"
                android:background="@color/pure_white" />

            <!-- SAR -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroValueSAR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="306,150"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textDirection="ltr"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:text="🇸🇦 ريال سعودي"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="@color/pure_white"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:alpha="0.25"
                android:background="@color/pure_white" />

            <!-- USD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeroValueUSD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="81,647.51"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textDirection="ltr"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:text="🇺🇸 دولار أمريكي"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="@color/pure_white"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

       <!-- Sparkline Container (تم تفعيل LineChart) -->
<com.github.mikephil.charting.charts.LineChart
    android:id="@+id/heroSparkline"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    android:layout_marginTop="12dp"
    android:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════════
                     2. ALERTS STRIP
                     ═══════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/alertsStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_5"
                    android:background="@drawable/bg_alert_strip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingVertical="@dimen/space_3"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvAlertIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvAlertMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="3 قطع بحاجة إلى تحديث الأسعار" />

                    <TextView
                        android:id="@+id/tvAlertAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عرض →"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="@color/text_gold_accent" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════════
                     3. INVENTORY METRICS — 🆕 حدود ذهبية
                     ═══════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/inventoryMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_5"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Metric 1: عدد القطع -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="@dimen/space_1"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="@dimen/elevation_2"
                        app:strokeColor="@color/border_gold"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_3">

                            <ImageView
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_inventory_items"
                                app:tint="@color/text_gold_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/total_items"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvTotalItems"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="7" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 2: الوزن -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginHorizontal="@dimen/space_1"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="@dimen/elevation_2"
                        app:strokeColor="@color/border_gold"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_3">

                            <ImageView
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_weight_scale"
                                app:tint="@color/text_gold_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/total_weight"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvTotalWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                                android:textColor="@color/text_gold_accent"
                                android:textDirection="ltr"
                                tools:text="615.0 g" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 3: مبيعات اليوم -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="@dimen/elevation_2"
                        app:strokeColor="@color/border_gold"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_3">

                            <ImageView
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sold_today"
                                app:tint="@color/text_gold_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/sold_today"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvSoldToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

               <!-- ═══════════════════════════════════════════════════════
     4. LIVE GOLD PRICES CARD (ديناميكي ومطابق للصورة)
     ═══════════════════════════════════════════════════════ -->
<com.google.android.material.card.MaterialCardView
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGoldPrices"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_5"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="#10000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: العنوان + زر التحديث الدائري -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أسعار الذهب المباشرة"
                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="💰"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRefreshGold"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_icon_button"
                android:contentDescription="@string/refresh_gold_prices"
                android:padding="8dp"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="?attr/colorOnSurface" />
        </RelativeLayout>

        <!-- Chart + Ounce Price Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp">
            
            

            <!-- الرسم البياني التفاعلي لأسعار الذهب -->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/goldPriceChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- تراكب سعر الأونصة في المنتصف فوق Chart -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سعر الأوقية (31.10g)"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOuncePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.App.Display.Large"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="$4,371.29" />
            </LinearLayout>
        </RelativeLayout>

<!-- ═══════════════════════════════════════════════════════
     شارات الاتجاه والتغيير (تظهر أسفل الرسم البياني)
     ═══════════════════════════════════════════════════════ -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvGoldTrend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        tools:text="📊" />

    <TextView
        android:id="@+id/tvGoldChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.App.Label.Medium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="-0.00%" />
</LinearLayout>

        <!-- أسعار العيارات (24K / 21K / 18K) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGoldPrice18"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr"
                android:textSize="12sp"
                tools:text="18K: $105.41/g" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="•"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvGoldPrice21"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="?attr/colorOnSurface"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="21K: $122.98/g" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="•"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tvGoldPrice24"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textDirection="ltr"
                android:textSize="12sp"
                tools:text="24K: $140.54/g" />
        </LinearLayout>

        <!-- شريط حالة التحديث والحفظ المحلي (Footer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPriceSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="⚙️ كاش محلي -" />

            <TextView
                android:id="@+id/tvRefreshCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="التحديث بعد 11 ث من 30" />

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_status_dot_red" />

            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="آخر تحديث 00:40:28" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


                <!-- ═══════════════════════════════════════════════════════
     5. SALES SUMMARY — بطاقة إجمالي المبيعات الاحترافية
     ═══════════════════════════════════════════════════════ -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/salesSummaryCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_5"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sales_card"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Block: العنوان + زر الخصوصية -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_sold_today"
                    app:tint="@color/text_gold_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ملخص المبيعات"
                    android:textAppearance="@style/TextAppearance.App.Title.Small"
                    android:textColor="@color/pure_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnToggleSalesVisibility"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_visibility"
                android:padding="6dp"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/text_gold_accent" />
        </RelativeLayout>

        <!-- Grid Cards for Periods: (اليوم / الشهر / السنة) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- 1. مبيعات اليوم (Sales Today) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sales_period_item"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مبيعات اليوم"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="#9EA9B9"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSalesToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="••••••"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="3,798,900 YER" />

                <TextView
                    android:id="@+id/tvSalesTodayItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2 عملية"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="@color/text_gold_accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 2. مبيعات الشهر (Sales Month) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sales_period_item"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مبيعات الشهر"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="#9EA9B9"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSalesMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="••••••"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="42,150,000 YER" />

                <TextView
                    android:id="@+id/tvSalesMonthItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="18 عملية"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="@color/text_gold_accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 3. مبيعات السنة (Sales Year) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sales_period_item"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إجمالي السنة"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="#9EA9B9"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvSalesYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="••••••"
                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                    android:textColor="@color/pure_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="185,400,000 YER" />

                <TextView
                    android:id="@+id/tvSalesYearItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="124 عملية"
                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                    android:textColor="@color/text_gold_accent"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Multi-currency Multi-card Footer (تفاصيل العملات الأخرى للمبيعات) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="المكافئ بـ SAR / USD:"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="#7A8B9E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSalesEquivSAR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇸🇦 93,120 SAR"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="@color/pure_white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="#7A8B9E" />

            <TextView
                android:id="@+id/tvSalesEquivUSD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇺🇸 $24,832"
                android:textAppearance="@style/TextAppearance.App.Label.Small"
                android:textColor="@color/pure_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


                <!-- ═══════════════════════════════════════════════════════
                     6. RECENT ACTIVITY
                     ═══════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/recentActivityHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ آخر العمليات"
                        android:textAppearance="@style/TextAppearance.App.Title.Small"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvViewAllActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="@dimen/space_2"
                        android:paddingVertical="@dimen/space_1"
                        android:text="عرض الكل →"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="@color/text_gold_accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
