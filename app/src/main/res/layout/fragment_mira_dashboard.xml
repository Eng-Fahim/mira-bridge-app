<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="36dp">

        <!-- 1. SHIMMER LOADING -->
        <LinearLayout
            android:id="@+id/shimmerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <View android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginBottom="16dp" android:background="@drawable/shimmer_background" />
            <View android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginBottom="24dp" android:background="@drawable/shimmer_background" />
            <View android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/shimmer_background" />
        </LinearLayout>

        <!-- 2. LOADING OVERLAY -->
        <LinearLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/colorSurface"
            android:visibility="gone"
            android:alpha="0.95">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:indeterminate="true" app:indicatorColor="?attr/colorPrimary" app:indicatorSize="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="جاري مزامنة بيانات النظام..." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- ✅ 3. بطاقة ملخص الوردية -->
        <com.example.uhf.widget.ShiftSummaryCardView
            android:id="@+id/cardShiftSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible" />
            
        <!-- ✅ 3.5 التصميم الجديد لموظف المبيعات (POS) -->
        <include
            android:id="@+id/layoutPosGoldDashboard"
            layout="@layout/view_pos_gold_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" 
            android:visibility="gone" />

        <!-- ✅ 4. CAROUSEL (البطاقات العلوية المتسلسلة) -->
        <HorizontalScrollView
            android:id="@+id/horizontalScrollCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:layoutDirection="locale">

            <LinearLayout
                android:id="@+id/cardsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 4.1 HERO GOLD BALANCE & KARATS CARD (مصحح ومطابق لمعايير UI/UX العالمية) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroBalanceCard"
                    android:layout_width="325dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1.5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hero_gold_gradient">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <!-- العنوان العلوي وزر إخفاء/إظهار الحساسية -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <View
                                        android:layout_width="4dp"
                                        android:layout_height="16dp"
                                        android:background="#b48a32"
                                        android:layout_marginEnd="8dp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="رصيد الذهب الصافي"
                                        android:textColor="@color/hero_text_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <ImageButton
                                    android:id="@+id/btnToggleHeroVisibility"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_eye_off"
                                    app:tint="@color/hero_text_primary" />
                            </LinearLayout>

                            <!-- الرقم الرئيسي الرائد (إجمالي الوزن بالجرام) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="bottom">
                                <TextView
                                    android:id="@+id/tvHeroBalance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="353.30"
                                    android:textColor="@color/hero_text_primary"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="جم"
                                    android:textColor="@color/hero_text_secondary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvHeroTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/hero_text_secondary"
                                android:visibility="gone"
                                tools:text="▲ 2.5%" />

                            <!-- خط فاصل جمالي شفّاف -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="14dp"
                                android:background="@color/hero_text_secondary"
                                android:alpha="0.25" />

                            <!-- 🌟 قسم تفاصيل الأعيار داخل البطاقة (مرن ولا يقطع النصوص) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <!-- عيار 24 -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_karat_glass_card"
                                    android:orientation="vertical"
                                    android:padding="12dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="24K"
                                            android:textColor="#FFD700"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                                        <ImageView
                                            android:layout_width="14dp"
                                            android:layout_height="14dp"
                                            android:src="@drawable/ic_diamond"
                                            app:tint="#FFD700" />
                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/tvHeroSubtitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="124.00 جم"
                                        android:textColor="@color/hero_text_primary"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:maxLines="1"
                                        android:ellipsize="end" />
                                    <TextView
                                        android:id="@+id/tvHeroValueUSD"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="8,162,424 YER"
                                        android:textColor="@color/hero_text_secondary"
                                        android:textSize="11sp"
                                        android:maxLines="1"
                                        android:ellipsize="end" />
                                </LinearLayout>

                                <!-- عيار 21 -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_karat_glass_card"
                                    android:orientation="vertical"
                                    android:padding="12dp">
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="21K"
                                            android:textColor="#FFD700"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                                        <ImageView
                                            android:layout_width="14dp"
                                            android:layout_height="14dp"
                                            android:src="@drawable/ic_diamond"
                                            app:tint="#FFD700" />
                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/tvHeroItemCount"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="72.50 جم"
                                        android:textColor="@color/hero_text_primary"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:maxLines="1"
                                        android:ellipsize="end" />
                                    <TextView
                                        android:id="@+id/tvHeroValueSAR"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="452,500 YER"
                                        android:textColor="@color/hero_text_secondary"
                                        android:textSize="11sp"
                                        android:maxLines="1"
                                        android:ellipsize="end" />
                                </LinearLayout>

                            </LinearLayout>

                            <!-- شريط القيمة الإجمالية النقدية بالأسفل -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_karat_glass_card"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="القيمة النقدية الإجمالية"
                                    android:textColor="@color/hero_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvHeroValueYER"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$30,999.54"
                                    android:textColor="#FFD700"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4.2 LIVE GOLD PRICES CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoldPrices"
                    android:layout_width="325dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/gold_card_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="أسعار الذهب العالمية" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                            <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentStart="true" android:layout_centerVertical="true">
                                <ImageButton android:id="@+id/btnRefreshGold" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_popup_sync" app:tint="@color/gold_text_accent" />
                                <com.google.android.material.progressindicator.CircularProgressIndicator android:id="@+id/pbGoldLoading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:indeterminate="true" android:visibility="gone" app:indicatorColor="@color/gold_text_accent" app:indicatorSize="16dp" app:trackThickness="2dp" />
                            </FrameLayout>
                        </RelativeLayout>
                        
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سعر الأونصة العالمي" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                            <TextView android:id="@+id/tvOuncePrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="$0.00" android:textColor="@color/gold_text_accent" android:textSize="30sp" android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="3">
                            <TextView android:id="@+id/tvGoldPrice24" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/gold_text_accent" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvGoldPrice21" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                            <TextView android:id="@+id/tvGoldPrice18" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/tvGoldTrend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginEnd="4dp"/>
                            <TextView android:id="@+id/tvGoldChange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="12sp" android:layout_marginEnd="12dp" />
                            <TextView android:id="@+id/tvPriceSource" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4.3 SALES SUMMARY CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/salesSummaryCard"
                    android:layout_width="325dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/gold_card_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/gold_card_stroke"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="210dp" android:orientation="vertical" android:padding="20dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ملخص المبيعات" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                            <ImageButton android:id="@+id/btnToggleSalesVisibility" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_eye_off" app:tint="@color/gold_text_accent" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center_vertical" android:orientation="horizontal" android:weightSum="5">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:gravity="center" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اليوم" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                                <TextView android:id="@+id/tvSalesToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="••••" android:textColor="@color/gold_text_accent" android:textSize="17sp" android:textStyle="bold" />
                            </LinearLayout>
                            <View android:layout_width="1dp" android:layout_height="36dp" android:background="?attr/colorOutlineVariant" android:alpha="0.4" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.75" android:gravity="center" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الشهر" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                                <TextView android:id="@+id/tvSalesMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="••••" android:textColor="@color/gold_text_accent" android:textSize="17sp" android:textStyle="bold" />
                            </LinearLayout>
                            <View android:layout_width="1dp" android:layout_height="36dp" android:background="?attr/colorOutlineVariant" android:alpha="0.4" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.75" android:gravity="center" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="السنة" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
                                <TextView android:id="@+id/tvSalesYear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="••••" android:textColor="@color/gold_text_accent" android:textSize="17sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 5. Dots Indicator -->
        <LinearLayout
            android:id="@+id/dotsIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <View android:id="@+id/dot1" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginHorizontal="4dp" android:background="@drawable/dot_active" />
            <View android:id="@+id/dot2" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginHorizontal="4dp" android:background="@drawable/dot_inactive" />
            <View android:id="@+id/dot3" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginHorizontal="4dp" android:background="@drawable/dot_inactive" />
        </LinearLayout>

        <!-- 6. QUICK ACTIONS CONTAINER -->
        <HorizontalScrollView
            android:id="@+id/hsvQuickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/llQuickActionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- 7. ALERTS STRIP -->
        <LinearLayout
            android:id="@+id/alertsStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_alert_strip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">
            <TextView android:id="@+id/tvAlertIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠️" android:textSize="18sp" />
            <TextView android:id="@+id/tvAlertMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textColor="?attr/colorOnSurface" android:textSize="13sp" />
            <TextView android:id="@+id/tvAlertAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عرض" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
        </LinearLayout>

        <!-- 8. DATA SECTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 8.1 INVENTORY BY KARAT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInventoryByKarat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_inventory_items" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="المخزون حسب العيار" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:textSize="15sp" />
                        <ImageButton android:id="@+id/btnToggleInventoryVisibility" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_eye_off" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false" android:scrollbars="none">
                        <LinearLayout android:id="@+id/llInventoryByKarat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                    <TextView android:id="@+id/tvKaratEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:padding="16dp" android:text="لا توجد بيانات" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8.2 SCRAP GOLD SUMMARY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScrapGold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_gold_scrap" app:tint="?attr/colorPrimary" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="مخزون كسر الذهب" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:textSize="15sp" />
                        <ImageButton android:id="@+id/btnToggleScrapVisibility" android:layout_width="32dp" android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_eye_off" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="2">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الوزن الإجمالي" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvScrapWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="••••••" android:textColor="?attr/colorPrimary" android:textSize="20sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="القيمة التقديرية" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvScrapValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="••••••" android:textColor="?attr/colorOnSurface" android:textSize="20sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenScrapBuy" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="شراء" android:textSize="12sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenScrapHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="السجل" android:textSize="12sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenScrapBatches" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الدفعات" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8.3 SCRAP AGING -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScrapAging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tvAgingStatusIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🟢" android:textSize="20sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="حالة أعمار الكسر" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:textSize="15sp" />
                        <TextView android:id="@+id/tvAgingStatusLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="سليم" android:textColor="#16A34A" android:textStyle="bold" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:weightSum="2">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الوزن القديم" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvAgingWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0.000 g" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutlineVariant"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفواتير المعلقة" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvAgingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="?attr/colorOnSurface" android:textSize="16sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/llAgingAlert" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="#22DC2626" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚠️" android:textSize="14sp" />
                        <TextView android:id="@+id/tvAgingAlertText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="#DC2626" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenAgingReport" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="عرض تقرير الأعمار" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8.4 CHARTS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCharts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="أداء المبيعات (7 أيام)" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:textSize="15sp" />
                    <com.github.mikephil.charting.charts.LineChart android:id="@+id/lineChartSales" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="12dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="?attr/colorOutlineVariant"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المبيعات حسب العيار" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:textSize="15sp" />
                    <com.github.mikephil.charting.charts.PieChart android:id="@+id/pieChartKarat" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8.5 RECENT ACTIVITY -->
            <LinearLayout android:id="@+id/recentActivityHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="النشاط الأخير" android:textColor="?attr/colorOnSurface" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:id="@+id/tvViewAllActivity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="عرض الكل" android:textColor="?attr/colorPrimary" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/llRecentActivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
