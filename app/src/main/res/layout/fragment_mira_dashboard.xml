<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ═══════════════════════════════════════════════════════
         SHIMMER LOADING
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_h"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_12"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="@dimen/space_4"
            android:background="@drawable/shimmer_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/shimmer_background" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         LOADING OVERLAY
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.95">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="48dp"
            app:trackThickness="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_data"
            android:textAppearance="@style/TextAppearance.App.Body.Medium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="@dimen/space_4" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurface"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_4"
                android:paddingBottom="@dimen/space_6">

                <!-- ═══════════════════════════════════════════════════════
                     1. HERO BALANCE CARD
                     ═══════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroBalanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_2"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_5">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/total_inventory_value"
                                android:textAppearance="@style/TextAppearance.App.Label.Large"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                tools:text="💰 إجمالي قيمة المخزون" />

                            <ImageButton
                                android:id="@+id/btnToggleHeroVisibility"
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:layout_marginEnd="@dimen/space_1"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="@dimen/space_1"
                                android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:id="@+id/tvHeroTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_status"
                                android:paddingHorizontal="@dimen/space_2"
                                android:paddingVertical="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorPrimary"
                                tools:text="📈 +2.4%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:background="@drawable/bg_sparkline_placeholder"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/space_5">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_inventory_value"
                                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:id="@+id/tvHeroBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="••••••••"
                                android:textAppearance="@style/TextAppearance.App.Display.Medium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textDirection="ltr"
                                tools:text="$81,647.51" />

                            <TextView
                                android:id="@+id/tvHeroSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                tools:text="👑 7 قطع • 615.0g" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroValueYER"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textDirection="ltr"
                                    tools:text="12,450,000" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="🇾🇪 ريال يمني"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.75" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroValueSAR"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textDirection="ltr"
                                    tools:text="306,150" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="🇸🇦 ريال سعودي"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.75" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.4" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHeroValueUSD"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:textDirection="ltr"
                                    tools:text="81,647.51" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="🇺🇸 دولار أمريكي"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnPrimaryContainer"
                                    android:alpha="0.75" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:id="@+id/heroSparkline"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════════
                     2. ALERTS STRIP
                     ═══════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/alertsStrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:background="@drawable/bg_alert_strip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingVertical="@dimen/space_3"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvAlertIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvAlertMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.App.Body.Small"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="3 قطع بحاجة إلى تحديث الأسعار" />

                    <TextView
                        android:id="@+id/tvAlertAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عرض →"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════════
                     3. INVENTORY METRICS
                     ═══════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/inventoryMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <!-- Metric 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_marginEnd="@dimen/space_1"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="@dimen/elevation_1"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="@dimen/stroke_normal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_inventory_items"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/total_items"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvTotalItems"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="7" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_marginHorizontal="@dimen/space_1"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="@dimen/elevation_1"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="@dimen/stroke_normal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_weight_scale"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/total_weight"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvTotalWeight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                                android:textColor="?attr/colorPrimary"
                                android:textDirection="ltr"
                                tools:text="615.0 g" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Metric 3 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="108dp"
                        android:layout_marginStart="@dimen/space_1"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/radius_xl"
                        app:cardElevation="@dimen/elevation_1"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="@dimen/stroke_normal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_2">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sold_today"
                                app:tint="?attr/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:text="@string/sold_today"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/tvSoldToday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Headline.Small"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="1" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════════════════
                     4. GOLD PRICES
                     ═══════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoldPrices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="@dimen/elevation_1"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/stroke_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_5">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_4">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="@string/live_gold_prices"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface" />

                            <FrameLayout
                                android:layout_width="@dimen/icon_xl"
                                android:layout_height="@dimen/icon_xl"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true">

                                <ImageButton
                                    android:id="@+id/btnRefreshGold"
                                    android:layout_width="@dimen/icon_xl"
                                    android:layout_height="@dimen/icon_xl"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/refresh_gold_prices"
                                    android:src="@android:drawable/ic_popup_sync"
                                    app:tint="?attr/colorPrimary" />

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/pbGoldLoading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:indeterminate="true"
                                    android:visibility="gone"
                                    app:indicatorColor="?attr/colorPrimary"
                                    app:indicatorSize="20dp"
                                    app:trackThickness="2dp" />
                            </FrameLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_3"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvGoldTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="16sp"
                                tools:text="📊" />

                            <TextView
                                android:id="@+id/tvGoldChange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_2"
                                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="-0.00%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_luxury_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/space_4">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ounce_price"
                                android:textAppearance="@style/TextAppearance.App.Label.Medium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvOuncePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="@style/TextAppearance.App.Display.Medium"
                                android:textColor="?attr/colorPrimary"
                                android:textDirection="ltr"
                                tools:text="$4,282.33" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <TextView
                                android:id="@+id/tvGoldPrice18"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.App.Label.Large"
                                android:textColor="?attr/colorOnSurface"
                                android:textDirection="ltr"
                                tools:text="18K: $103.26/g" />

                            <TextView
                                android:id="@+id/tvGoldPrice21"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.App.Label.Large"
                                android:textColor="?attr/colorOnSurface"
                                android:textDirection="ltr"
                                tools:text="21K: $120.47/g" />

                            <TextView
                                android:id="@+id/tvGoldPrice24"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textAppearance="@style/TextAppearance.App.Label.Large"
                                android:textColor="?attr/colorPrimary"
                                android:textDirection="ltr"
                                tools:text="24K: $137.68/g" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3">

                            <TextView
                                android:id="@+id/tvPriceSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="📡 GoldAPI" />

                            <TextView
                                android:id="@+id/tvLastUpdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:textAppearance="@style/TextAppearance.App.Label.Small"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="⏰ آخر تحديث: 21:54:26" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════════
                     5. SALES SUMMARY
                     ═══════════════════════════════════════════════════════ -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/salesSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/radius_xl"
                    app:cardElevation="@dimen/elevation_1"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="@dimen/stroke_normal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sales_summary"
                                android:textAppearance="@style/TextAppearance.App.Title.Small"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="📈 ملخص المبيعات" />

                            <ImageButton
                                android:id="@+id/btnToggleSalesVisibility"
                                android:layout_width="@dimen/icon_lg"
                                android:layout_height="@dimen/icon_lg"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/toggle_visibility"
                                android:padding="@dimen/space_1"
                                android:src="@drawable/ic_eye_off"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sales_today"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/tvSalesToday"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="3,798,900 YER" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sales_month"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/tvSalesMonth"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="3,798,900 YER" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="?attr/colorOutlineVariant"
                                android:alpha="0.5" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/sales_year"
                                    android:textAppearance="@style/TextAppearance.App.Label.Small"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/tvSalesYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:text="••••••"
                                    android:textAppearance="@style/TextAppearance.App.Label.Large"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="3,798,900 YER" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════════
                     6. RECENT ACTIVITY
                     ═══════════════════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/recentActivityHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚡ آخر العمليات"
                        android:textAppearance="@style/TextAppearance.App.Title.Small"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvViewAllActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="@dimen/space_2"
                        android:paddingVertical="@dimen/space_1"
                        android:text="عرض الكل →"
                        android:textAppearance="@style/TextAppearance.App.Label.Large"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
